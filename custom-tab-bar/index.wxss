/* 底部导航栏 — 青瓷主题 · 悬空半透明 */

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  z-index: 999;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  box-shadow: 0rpx 12rpx 48rpx rgba(82, 70, 123, 0.1),
              0rpx 4rpx 16rpx rgba(82, 70, 123, 0.06),
              inset 0rpx 1rpx 0rpx rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  animation: slideUpNav 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slideUpNav {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.bottom-nav-items {
  display: flex;
  height: 80rpx;
  align-items: stretch;
  gap: 12rpx;
}

.bottom-nav-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 24rpx;
  color: #9490B2;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 500;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

/* 波纹背景效果 */
.bottom-nav-item::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(82, 70, 123, 0.2) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  transition: width 0.6s ease, height 0.6s ease;
}

.bottom-nav-item:active::before {
  width: 200rpx;
  height: 200rpx;
}

.bottom-nav-item.selected {
  color: #372C57;
  background: linear-gradient(135deg, #E7E3F6 0%, #D8D3EC 100%);
  box-shadow: 0rpx 10rpx 28rpx rgba(82, 70, 123, 0.16),
              0rpx 4rpx 12rpx rgba(82, 70, 123, 0.1),
              inset 0rpx 2rpx 4rpx rgba(255, 255, 255, 0.7);
  transform: translateY(-8rpx) scale(1.05);
  animation: tabSelected 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes tabSelected {
  0% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-12rpx) scale(1.1) rotate(5deg);
  }
  100% {
    transform: translateY(-8rpx) scale(1.05) rotate(0deg);
  }
}

/* 顶部光条 */
.bottom-nav-item.selected::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, transparent 0%, #FFFFFF 50%, transparent 100%);
  opacity: 0.9;
}

.bottom-nav-icon {
  height: 40rpx;
  color: inherit;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 400;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  z-index: 1;
}

.bottom-nav-item.selected .bottom-nav-icon {
  transform: scale(1.2) rotate(5deg);
  filter: drop-shadow(0rpx 4rpx 8rpx rgba(55, 44, 87, 0.2));
}

.bottom-nav-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  position: relative;
  z-index: 1;
}

/* 点击动画 */
.bottom-nav-item:active {
  transform: scale(0.9);
}

.bottom-nav-item.selected:active {
  transform: translateY(-6rpx) scale(0.98);
}

/* 桌面端悬停效果 - 超级明显 */
@media (hover: hover) {
  .bottom-nav-item:not(.selected):hover {
    background: #EFECFA;
    color: #52467B;
    transform: translateY(-6rpx) scale(1.05);
    box-shadow: 0rpx 8rpx 24rpx rgba(82, 70, 123, 0.2);
  }
  
  .bottom-nav-item:not(.selected):hover .bottom-nav-icon {
    transform: scale(1.15) rotate(5deg);
  }
  
  .bottom-nav-item.selected:hover {
    box-shadow: 0rpx 16rpx 40rpx rgba(82, 70, 123, 0.2),
                0rpx 8rpx 20rpx rgba(82, 70, 123, 0.12);
    transform: translateY(-12rpx) scale(1.08);
  }
}
