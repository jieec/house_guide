.bottom-nav { position:fixed; left:18rpx; right:18rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); z-index:999; padding:8rpx; border:1rpx solid rgba(255,255,255,.16); border-radius:30rpx; background:rgba(18,13,54,.78); box-shadow:0 18rpx 42rpx rgba(0,0,0,.35),inset 0 1rpx 0 rgba(255,255,255,.12); backdrop-filter:blur(24rpx); }
.bottom-nav-items { display:flex; height:86rpx; align-items:stretch; gap:6rpx; }.bottom-nav-item { position:relative; flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center; border-radius:23rpx; color:#aaa7ca; font-size:20rpx; line-height:1.2; }.bottom-nav-item.selected { color:#fff; background:linear-gradient(145deg,rgba(143,83,255,.66),rgba(57,145,255,.32)); box-shadow:0 6rpx 18rpx rgba(91,76,218,.3),inset 0 1rpx 0 rgba(255,255,255,.22); }.bottom-nav-icon { height:34rpx; color:inherit; font-size:33rpx; line-height:34rpx; font-weight:500; }.bottom-nav-label { margin-top:5rpx; }
