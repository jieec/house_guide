/* 柔和紫色现代设计系统 - 参考 OtterLife & 阿里AI外呼 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 100%);
  color: #2D2D3A;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ==================== 全局惊艳动画 ==================== */

@keyframes card-appear {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 卡片系统 - 白色卡片 + 柔和阴影 + 惊艳动画 */
.card,
.d-card,
.house-card,
.query-card,
.data-card,
.tool-card,
.audit-card,
.dimension-card,
.result,
.cell {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.3s ease;
  overflow: hidden;
  position: relative;
  animation: card-appear 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

/* 卡片光泽效果 - 仅限小卡片 */
.card::after,
.cell::after,
.house-card::after,
.tool-card::after,
.data-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(139, 92, 246, 0.1) 50%,
    transparent 100%
  );
  transition: left 0.6s ease;
  pointer-events: none;
  z-index: 1;
}

.card:active::after,
.cell:active::after,
.house-card:active::after,
.tool-card:active::after,
.data-card:active::after {
  left: 100%;
}

/* 点击效果 - 仅限小卡片，大卡片移除以避免干扰滚动 */
.card:active,
.cell:active,
.house-card:active,
.tool-card:active,
.data-card:active {
  transform: scale(0.96) translateY(4rpx) rotate(-1deg);
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.2),
              0rpx 4rpx 16rpx rgba(124, 92, 252, 0.15);
  background: linear-gradient(135deg, #FFFFFF 0%, #FDFCFF 100%);
}

/* 卡片标题 - 紫色强调 */
.card-title,
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.card-title::before,
.section-title::before {
  width: 8rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #8B5CF6 0%, #7C5CFC 100%);
  content: '';
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.3);
}

.card {
  margin: 24rpx;
  padding: 40rpx;
}

.card-sub,
.muted,
.no-data {
  color: #8B8B9A;
  font-size: 26rpx;
}

/* 表单样式 - 柔和输入框 + 惊艳聚焦 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin-bottom: 28rpx;
  animation: card-appear 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.form-label {
  width: 200rpx;
  flex-shrink: 0;
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 600;
  transition: color 0.3s ease;
}

.form-input,
.form-input-wrap,
.field-control,
.form-picker,
.search-box,
.city-search-box {
  min-height: 96rpx;
  box-sizing: border-box;
  border: 2rpx solid #E8E5F6;
  border-radius: 20rpx;
  background: #FAFAFE;
  color: #2D2D3A;
  position: relative;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.form-input:focus,
.field-control:focus-within,
.search-box:focus-within {
  border-color: #8B5CF6;
  background: #FFFFFF;
  box-shadow: 0rpx 0rpx 0rpx 6rpx rgba(139, 92, 246, 0.15),
              0rpx 12rpx 32rpx rgba(124, 92, 252, 0.25),
              inset 0rpx 2rpx 4rpx rgba(139, 92, 246, 0.1);
  transform: translateY(-4rpx) scale(1.01);
}

/* 表单输入框点击效果 */
.form-input:active,
.form-picker:active,
.field-control:active,
.search-box:active {
  border-color: #8B5CF6;
  background: #FDFCFF;
  transform: translateY(-2rpx) scale(1.005);
  box-shadow: 0rpx 0rpx 0rpx 4rpx rgba(139, 92, 246, 0.1),
              0rpx 8rpx 20rpx rgba(124, 92, 252, 0.15);
}

.form-row:focus-within .form-label {
  color: #8B5CF6;
}

.form-input,
.form-input-wrap {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  font-weight: 500;
}

input.form-input {
  height: 96rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 96rpx;
}

.form-input::placeholder,
.search-input::placeholder {
  color: #B8B8C9;
  font-weight: 400;
}

/* 按钮样式 - 渐变紫色主按钮 + 超级动效 */
.btn-primary,
.calculate-button,
.report-export-button {
  border: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 50%, #6D4EED 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 16rpx 40rpx rgba(124, 92, 252, 0.5),
              0rpx 8rpx 16rpx rgba(124, 92, 252, 0.3),
              inset 0rpx 2rpx 4rpx rgba(255, 255, 255, 0.3);
  font-weight: 600;
  font-size: 32rpx;
  padding: 24rpx 48rpx;
  letter-spacing: 0.5rpx;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.btn-primary::before,
.calculate-button::before,
.report-export-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.5) 50%, 
    transparent 100%);
  transition: left 0.6s ease;
}

.btn-primary:active::before,
.calculate-button:active::before,
.report-export-button:active::before {
  left: 100%;
}

.btn-primary:active,
.calculate-button:active,
.report-export-button:active {
  transform: scale(0.92) translateY(6rpx);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.6),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.4);
}

.btn-ghost {
  border: 2rpx solid #E8E5F6;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #7C5CFC;
  font-weight: 600;
  font-size: 30rpx;
  padding: 22rpx 44rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.08);
}

.btn-ghost:active {
  background: #F5F3FF;
  border-color: #8B5CF6;
  transform: scale(0.96);
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.12);
}

button::after {
  border: 0;
}

/* ==================== 通用点击效果 ==================== */

/* 所有可点击的行元素 */
.row,
.item,
.item-row,
.list-item,
.option-item,
.selection-item,
[bindtap]:not(.btn-primary):not(.btn-ghost):not(.cell):not(.card),
[catchtap]:not(.btn-primary):not(.btn-ghost):not(.cell):not(.card) {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 标签/芯片点击效果 */
.tag,
.chip,
.badge,
.label,
.tab-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active,
.chip:active,
.badge:active,
.label:active,
.tab-item:active {
  transform: scale(0.92) translateY(2rpx);
  opacity: 0.8;
}

/* 图标按钮点击效果 */
.icon-btn,
.icon-button,
.action-icon {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.icon-btn:active,
.icon-button:active,
.action-icon:active {
  transform: scale(0.85) rotate(15deg);
  opacity: 0.7;
}

/* 列表项点击效果 */
.list-item:active,
.item-row:active,
.option-item:active {
  background: rgba(139, 92, 246, 0.05);
  transform: translateX(8rpx);
}

/* Switch 开关点击效果 */
switch {
  transition: all 0.3s ease;
}

switch:active {
  transform: scale(0.95);
}

/* Radio 和 Checkbox 点击效果 */
radio,
checkbox {
  transition: all 0.3s ease;
}

radio:active,
checkbox:active {
  transform: scale(0.9);
}

/* Picker 选择器点击效果 */
picker {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

picker:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 结果展示 - 带渐变装饰 */
.result {
  margin-top: 32rpx;
  padding: 40rpx;
  background: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.result::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.result-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
  z-index: 1;
}

.result-label {
  color: #8B8B9A;
  font-size: 30rpx;
  font-weight: 500;
}

.result-num {
  color: #7C5CFC;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1.5rpx;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 单元格样式 - 超级明显的交互 */
.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 36rpx;
}

.cell-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.cell-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  color: #8B5CF6;
  font-size: 40rpx;
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.2);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.cell:active .cell-icon {
  transform: scale(0.8) rotate(-15deg);
  box-shadow: 0rpx 4rpx 12rpx rgba(124, 92, 252, 0.3);
}

.cell-name {
  color: #2D2D3A;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.cell-desc {
  margin-top: 8rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 400;
}

.cell-score {
  color: #7C5CFC;
  font-size: 32rpx;
  font-weight: 700;
}

.cell-arrow {
  margin-left: 16rpx;
  color: #B8B8C9;
  font-size: 32rpx;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: inline-block;
}

.cell:active .cell-arrow {
  color: #8B5CF6;
  transform: translateX(12rpx) scale(1.5);
}

.cell-score {
  color: #7C5CFC;
  font-size: 32rpx;
  font-weight: 700;
}

/* 报告导出区域 - 超级惊艳 */
.report-export-area {
  margin: 48rpx 24rpx 40rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 50%, #E8E5F6 100%);
  border-radius: 32rpx;
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2),
              0rpx 8rpx 24rpx rgba(124, 92, 252, 0.15);
  position: relative;
  overflow: hidden;
  animation: card-appear 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.report-export-area::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 50%);
}

.report-export-area::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.5) 50%,
    transparent 100%
  );
  transition: left 0.6s ease;
}

.report-export-area:active::after {
  left: 100%;
}

.report-export-title {
  color: #2D2D3A;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  position: relative;
  z-index: 1;
}

.report-export-subtitle {
  margin-top: 16rpx;
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 400;
  position: relative;
  z-index: 1;
}

.pdf-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750px;
  height: 1px;
  opacity: 0;
}

/* Hover 效果 (桌面端) - 超级明显 */
@media (hover: hover) {
  .btn-primary:hover::before,
  .calculate-button:hover::before {
    left: 100%;
  }
  
  .btn-primary:hover,
  .calculate-button:hover {
    box-shadow: 0rpx 20rpx 48rpx rgba(124, 92, 252, 0.6),
                0rpx 12rpx 24rpx rgba(124, 92, 252, 0.4);
    transform: translateY(-6rpx) scale(1.05);
  }
  
  .btn-ghost:hover {
    border-color: #8B5CF6;
    background: #F5F3FF;
    box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.2);
    transform: translateY(-4rpx);
  }
  
  .card:hover,
  .cell:hover {
    transform: translateY(-8rpx) scale(1.02);
    box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.2),
                0rpx 8rpx 24rpx rgba(124, 92, 252, 0.15);
  }
  
  .card:hover .cell-icon,
  .cell:hover .cell-icon {
    transform: scale(1.15) rotate(10deg);
    box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.4);
  }
  
  .card:hover .cell-arrow,
  .cell:hover .cell-arrow {
    transform: translateX(8rpx) scale(1.3);
    color: #8B5CF6;
  }
}

/* 通用工具类 */
.text-primary {
  color: #7C5CFC;
}

.text-gradient {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.bg-gradient {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
}

.badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  color: #7C5CFC;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.2);
}
