
.report-export-area {
  margin: 44rpx 24rpx 36rpx;
  padding: 28rpx 24rpx 24rpx;
  text-align: center;
  background: linear-gradient(145deg, rgba(17, 48, 86, 0.96), rgba(12, 35, 66, 0.96));
  border: 1rpx solid rgba(0, 212, 255, 0.24);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 40, 90, 0.22);
}
.report-export-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}
.report-export-subtitle {
  margin-top: 10rpx;
  color: #8aa4cc;
  font-size: 23rpx;
}
.report-export-button {
  height: 82rpx;
  margin: 24rpx 0 0;
  padding: 0;
  line-height: 82rpx;
  color: #061326;
  background: #20c5d2;
  border: 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(0, 197, 210, 0.22);
}
.report-export-button::after { border: 0; }
.report-export-button:active { opacity: 0.84; }
.pdf-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1px;
  opacity: 0;
}
