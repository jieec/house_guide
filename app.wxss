/* Aurora glass design system */
page {
  background: #08091f;
  color: #f4f1ff;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
}
page::before { content:''; position:fixed; z-index:-2; inset:0; background-image:linear-gradient(145deg,rgba(8,9,31,.94) 0%,rgba(19,16,58,.88) 48%,rgba(7,29,56,.94) 100%),url('images/bg-city.png'); background-position:center,center bottom; background-size:cover,cover; background-repeat:no-repeat; opacity:1; } page::after { content:''; position:fixed; z-index:-1; right:-120rpx; bottom:80rpx; width:620rpx; height:520rpx; pointer-events:none; background:url('images/house.png') center/contain no-repeat; opacity:.045; transform:rotate(-5deg); }
.card,.d-card,.house-card,.query-card,.data-card,.tool-card,.audit-card,.dimension-card,.result,.cell,.report-export-area { background:rgba(255,255,255,.09); border:1rpx solid rgba(255,255,255,.16); border-radius:24rpx; box-shadow:0 20rpx 46rpx rgba(0,0,0,.2),inset 0 1rpx 0 rgba(255,255,255,.08); backdrop-filter:blur(22rpx); }
.card { margin:20rpx 24rpx; padding:28rpx; }.card-title,.section-title { display:flex; align-items:center; margin-bottom:24rpx; color:#fff; font-size:30rpx; font-weight:700; }.card-title::before,.section-title::before { width:7rpx; height:28rpx; margin-right:14rpx; border-radius:8rpx; background:linear-gradient(180deg,#b86cff,#5bd8ff); content:''; }.card-sub,.muted,.no-data { color:#aaa8c7 !important; }
.form-row { display:flex; align-items:center; min-height:76rpx; margin-bottom:22rpx; }.form-label { width:200rpx; flex-shrink:0; color:#bbb9d5; font-size:28rpx; }.form-input,.form-input-wrap,.field-control,.form-picker,.search-box,.city-search-box { min-height:76rpx; box-sizing:border-box; border:1rpx solid rgba(182,151,255,.25); border-radius:16rpx; background:rgba(4,7,30,.34); color:#fff; }.form-input,.form-input-wrap { flex:1; min-width:0; padding:18rpx 20rpx; font-size:28rpx; } input.form-input { height:76rpx; padding-top:0; padding-bottom:0; line-height:76rpx; }.form-input::placeholder,.search-input::placeholder { color:#77759d; }
.btn-primary,.calculate-button,.report-export-button { border:0; border-radius:18rpx; background:linear-gradient(110deg,#8b4dff,#4e91ff); color:#fff; box-shadow:0 12rpx 26rpx rgba(91,75,232,.35),inset 0 1rpx 0 rgba(255,255,255,.35); }.btn-ghost { border:1rpx solid rgba(179,157,255,.48); border-radius:999rpx; background:rgba(255,255,255,.06); color:#c9b9ff; } button::after { border:0; }
.result { margin-top:20rpx; padding:24rpx; }.result-line { display:flex; justify-content:space-between; align-items:center; padding:8rpx 0; }.result-label { color:#aaa8c7; font-size:26rpx; }.result-num { color:#68e0ff; font-size:40rpx; font-weight:700; }
.cell { display:flex; justify-content:space-between; align-items:center; margin:16rpx 24rpx; padding:28rpx; }.cell-left { display:flex; align-items:center; flex:1; }.cell-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin-right:20rpx; border-radius:20rpx; background:rgba(123,91,255,.22) !important; color:#d6c8ff; font-size:34rpx; }.cell-name { color:#fff; font-size:30rpx; font-weight:600; }.cell-desc { margin-top:6rpx; color:#aaa8c7; font-size:22rpx; }.cell-score { color:#68e0ff; font-size:24rpx; font-weight:700; }.cell-arrow { margin-left:16rpx; color:#aaa8c7; font-size:28rpx; }
.report-export-area { margin:44rpx 24rpx 36rpx; padding:28rpx 24rpx 24rpx; text-align:center; }.report-export-title { color:#fff; font-size:30rpx; font-weight:700; }.report-export-subtitle { margin-top:10rpx; color:#aaa8c7; font-size:23rpx; }.pdf-canvas { position:fixed; left:-9999rpx; top:-9999rpx; width:750px; height:1px; opacity:0; }

/* Deep-space glass UI system */
page {
  background: #171033 !important;
  color: #f6f3ff !important;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}
page::before {
  background-image:
    radial-gradient(circle at 12% 12%, rgba(157, 104, 255, .18), transparent 30%),
    radial-gradient(circle at 86% 22%, rgba(77, 177, 255, .14), transparent 28%),
    radial-gradient(circle at 55% 88%, rgba(111, 68, 214, .13), transparent 35%),
    linear-gradient(145deg, rgba(23, 16, 51, .97) 0%, rgba(35, 27, 78, .94) 54%, rgba(16, 26, 62, .97) 100%),
    url('images/bg-city.png');
  background-position: center, center, center, center, center bottom;
  background-size: cover, cover, cover, cover, cover;
  background-repeat: no-repeat;
  opacity: 1;
}
page::after {
  right: -120rpx;
  bottom: 70rpx;
  width: 660rpx;
  height: 560rpx;
  background:
    radial-gradient(circle at 32% 40%, rgba(177, 108, 255, .16), transparent 46%),
    url('images/house.png') center/contain no-repeat;
  opacity: .12;
  filter: blur(.2rpx);
}
.card,
.d-card,
.house-card,
.city-card,
.query-card,
.data-card,
.tool-card,
.audit-card,
.dimension-card,
.result,
.cell,
.report-export-area {
  background: rgba(255, 255, 255, .065) !important;
  border: 1rpx solid rgba(255, 255, 255, .14) !important;
  border-radius: 26rpx !important;
  box-shadow: 0 24rpx 58rpx rgba(4, 2, 22, .28), inset 0 1rpx 0 rgba(255, 255, 255, .10) !important;
  backdrop-filter: blur(22rpx);
}
.card,
.query-card,
.data-card,
.dimension-card,
.audit-card,
.report-export-area { margin-left: 24rpx; margin-right: 24rpx; }
.card-title,
.section-title,
.d-card-title,
.query-title,
.report-export-title { color: #f7f4ff !important; }
.card-sub,
.muted,
.no-data,
.page-subtitle,
.section-caption,
.form-hint,
.result-label { color: #aaa4cb !important; }
.form-input,
.form-input-wrap,
.field-control,
.form-picker,
.search-box,
.city-search-box,
.search-results,
.tabs,
.loan-type-tabs {
  background: rgba(9, 7, 33, .34) !important;
  border-color: rgba(178, 151, 255, .24) !important;
  color: #f6f3ff !important;
  border-radius: 18rpx !important;
}
.form-input::placeholder,
.search-input::placeholder,
textarea.form-input::placeholder { color: #77729d !important; }
.btn-primary,
.calculate-button,
.report-export-button,
.primary-action {
  border: 0 !important;
  border-radius: 18rpx !important;
  background: linear-gradient(112deg, #a75bff 0%, #695cff 52%, #4b9cff 100%) !important;
  color: #fff !important;
  box-shadow: 0 14rpx 30rpx rgba(91, 70, 225, .34), inset 0 1rpx 0 rgba(255, 255, 255, .30) !important;
}
.btn-ghost,
.bank-call,
.analyze-chip,
.locate-btn {
  border: 1rpx solid rgba(186, 162, 255, .48) !important;
  border-radius: 999rpx !important;
  background: rgba(255, 255, 255, .065) !important;
  color: #d7c8ff !important;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .10);
}
.result { background: rgba(76, 57, 164, .16) !important; }
.result-num,
.price-value,
.loan-monthly,
.section-count,
.preview,
.grade-score,
.a-price,
.d-price { color: #79ddff !important; text-shadow: 0 0 18rpx rgba(91, 208, 255, .16); }
.tag,
.missing-tag,
.house-tag,
.d-tag,
.dimension-level,
.loan-panel-badge {
  background: rgba(143, 97, 255, .15) !important;
  border-color: rgba(187, 159, 255, .32) !important;
  color: #d3c3ff !important;
  border-radius: 999rpx !important;
}
.tabs,
.loan-type-tabs { border-radius: 999rpx !important; padding: 6rpx !important; }
.tab,
.loan-type-tab { border-radius: 999rpx !important; color: #aaa4cb !important; }
.tab.active,
.loan-type-tab.active { color: #fff !important; background: linear-gradient(112deg, rgba(168, 91, 255, .78), rgba(75, 148, 255, .66)) !important; box-shadow: 0 8rpx 20rpx rgba(91, 76, 218, .28), inset 0 1rpx 0 rgba(255,255,255,.24); }
.price-bar-track { background-color: rgba(255,255,255,.08) !important; border-color: rgba(255,255,255,.16) !important; border-radius: 999rpx !important; }
.price-bar-fill { border-radius: 999rpx !important; background-image: linear-gradient(90deg, #b76cff, #56d8ff) !important; box-shadow: 0 0 18rpx rgba(104, 130, 255, .42), inset 0 1rpx 0 rgba(255,255,255,.38) !important; }
button::after { border: 0 !important; }
