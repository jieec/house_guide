page {
  background: #0a1628;
  font-size: 28rpx;
  color: #e8f0fe;
  padding-bottom: 60rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.15);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 30rpx rgba(0, 100, 255, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #2f6bff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #7b8fb0;
  margin: -14rpx 0 20rpx;
  line-height: 1.5;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.form-label {
  width: 200rpx;
  color: #8aa4cc;
  flex-shrink: 0;
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(10, 25, 50, 0.6);
  font-size: 28rpx;
  color: #e8f0fe;
}

textarea.form-input {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

.form-input-wrap {
  flex: 1;
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(10, 25, 50, 0.6);
  color: #e8f0fe;
  font-size: 28rpx;
}

.picker-arrow {
  float: right;
  color: #5b7aa8;
}

.btn-primary {
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 180, 255, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-ghost {
  background: transparent;
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 48rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  margin: 20rpx 24rpx;
}

.result {
  margin-top: 20rpx;
  background: rgba(0, 100, 200, 0.15);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}

.result-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.result-label {
  color: #8aa4cc;
  font-size: 26rpx;
}

.result-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #00d4ff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  padding: 28rpx 28rpx 8rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #2f6bff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.tag {
  display: inline-block;
  background: rgba(0, 180, 255, 0.15);
  color: #00d4ff;
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-orange {
  background: rgba(255, 122, 69, 0.15);
  color: #ff9a6c;
  border-color: rgba(255, 122, 69, 0.2);
}

.tag-green {
  background: rgba(35, 195, 67, 0.15);
  color: #5ddb7a;
  border-color: rgba(35, 195, 67, 0.2);
}

.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  border-radius: 24rpx;
  margin: 16rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.cell-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.cell-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cell-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.cell-desc {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 6rpx;
  line-height: 1.4;
}

.cell-arrow {
  color: #3d5a8a;
  font-size: 28rpx;
  margin-left: 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  color: #5b7aa8;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.d-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.15);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.d-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.d-card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #2f6bff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-cell {
  width: 50%;
  margin-bottom: 20rpx;
}

.info-v {
  font-size: 28rpx;
  font-weight: 600;
  color: #00d4ff;
}

.info-k {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 4rpx;
}

.load-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #5b7aa8;
}

.type-bar {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7b8fb0;
  background: rgba(16, 32, 64, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
}

.type-active {
  color: #ffffff;
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 180, 255, 0.3);
}

.house-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  border-radius: 24rpx;
  margin: 16rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.house-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tag {
  font-size: 20rpx;
  color: #00d4ff;
  background: rgba(0, 180, 255, 0.15);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}

.house-meta {
  font-size: 24rpx;
  color: #8aa4cc;
}

.meta-item {
  margin-right: 20rpx;
}

.house-loc {
  font-size: 22rpx;
  color: #5b7aa8;
  margin-top: 12rpx;
}

.house-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b35;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #ff9a6c;
}

.house-unit {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-left: 16rpx;
}

.analyze-chip {
  font-size: 22rpx;
  color: #00d4ff;
  background: rgba(0, 180, 255, 0.1);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  margin-left: auto;
}

.house-tags {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 12rpx;
  line-height: 1.4;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(10, 25, 50, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-top: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #5b7aa8;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #e8f0fe;
  background: transparent;
}

.searching {
  font-size: 24rpx;
  color: #00d4ff;
}

.search-results {
  margin-top: 16rpx;
  background: rgba(16, 32, 64, 0.95);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.search-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.search-item:last-child {
  border-bottom: none;
}

.search-name {
  font-size: 28rpx;
  color: #ffffff;
}

.search-address {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 6rpx;
}

.grade-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.grade-score {
  font-size: 64rpx;
  font-weight: 700;
  color: #00d4ff;
}

.grade-list {
  flex: 1;
}

.grade-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.grade-name {
  color: #8aa4cc;
  width: 160rpx;
}

.grade-val {
  color: #00d4ff;
  font-weight: 600;
  width: 80rpx;
}

.grade-tips {
  color: #5b7aa8;
  flex: 1;
}

.near-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.near-item:last-child {
  border-bottom: none;
}

.near-left {
  flex: 1;
}

.near-name {
  font-size: 28rpx;
  color: #ffffff;
}

.near-meta {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 4rpx;
}

.near-right {
  text-align: right;
}

.near-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 600;
}

.near-score {
  font-size: 22rpx;
  color: #00d4ff;
  margin-top: 4rpx;
}

.intro {
  font-size: 26rpx;
  color: #8aa4cc;
  line-height: 1.6;
}

.intro-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.intro-toggle {
  font-size: 24rpx;
  color: #00d4ff;
  margin-top: 12rpx;
}

.poi-group {
  margin-bottom: 20rpx;
}

.poi-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.poi-count {
  font-size: 22rpx;
  color: #5b7aa8;
  font-weight: 400;
}

.poi-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.poi-name {
  color: #8aa4cc;
  flex: 1;
}

.poi-dist {
  color: #5b7aa8;
  margin-left: 16rpx;
}

.poi-info {
  color: #00d4ff;
  margin-left: 16rpx;
  font-size: 22rpx;
}

.poi-toggle {
  text-align: center;
  font-size: 24rpx;
  color: #00d4ff;
  padding: 12rpx 0;
}

.tabs {
  white-space: nowrap;
  padding: 0 24rpx;
}

.tabs-inner {
  display: inline-flex;
  gap: 16rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7b8fb0;
  background: rgba(16, 32, 64, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
}

.tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  border-color: transparent;
}

.loading {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #00d4ff;
}
