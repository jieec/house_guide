.tips {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a93a6;
  line-height: 1.6;
  background: #f6f9ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.record {
  border-bottom: 1rpx solid #f0f2f8;
  padding: 20rpx 0;
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-place {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.record-del {
  font-size: 24rpx;
  color: #ff4d3a;
}

.record-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5a6478;
}

.record-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b0b8cc;
}
