.tips {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8aa4cc;
  line-height: 1.6;
  background: rgba(0, 100, 200, 0.15);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.record {
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
  padding: 20rpx 0;
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-place {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.record-del {
  font-size: 24rpx;
  color: #ff6b35;
}

.record-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.record-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #aaa4cb !important;
}

/* Deep-space glass overrides */
page { background:transparent !important; color:#f6f3ff !important; }
.tips { background:rgba(91,127,255,.12) !important; border-color:rgba(137,164,255,.24) !important; color:#c9c4f0 !important; border-radius:18rpx !important; }
.record { border-color:rgba(255,255,255,.10) !important; }
.record-place { color:#f7f4ff !important; }
.record-line { color:#aaa4cb !important; }
.record-del { color:#ffb07d !important; }
