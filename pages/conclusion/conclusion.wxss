.tips {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8aa4cc;
  line-height: 1.6;
  background: rgba(0, 100, 200, 0.15);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.record {
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
  padding: 20rpx 0;
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-place {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.record-del {
  font-size: 24rpx;
  color: #ff6b35;
}

.record-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.record-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b7aa8;
}
