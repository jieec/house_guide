/* 页面基础 */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.conclusion-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.conclusion-main {
  padding: 24rpx;
}

/* ==================== 动画 ==================== */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.form-row:active {
  background: #E8E5F5;
  transform: scale(0.98);
}.form-input-wrap:focus {
  border-color: #C1BAD9;
  outline: none;
  box-shadow: 0 0 0 4rpx rgba(82, 70, 123, 0.1);
}

/* ==================== 提示 ==================== */

.tips {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #F1EFFA;
  border-left: 4rpx solid #C1BAD9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  font-family: var(--font-serif);
  font-size: 26rpx;
  color: #4C4A6E;
  line-height: 1.75;
  letter-spacing: 0.4rpx;
  transition: all 0.3s ease;
}

.tips .ic {
  width: 26rpx;
  height: 26rpx;
  margin-top: 8rpx;
  color: #695C93;
}

.tips:active {
  background: rgba(82, 70, 123, 0.15);
  transform: translateX(4rpx);
}

.tips.warning {
  background: rgba(255, 152, 0, 0.1);
  border-left-color: #C08A55;
  color: #C08A55;
}

.tips.error {
  background: rgba(244, 67, 54, 0.1);
  border-left-color: #A94D58;
  color: #A94D58;
}

/* ==================== 登记记录 ==================== */

.record {
  padding: 16rpx;
  background: #F1EFFA;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.record:active {
  background: #E8E5F5;
  transform: translateX(4rpx);
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-place {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
}

.record-del {
  color: #A94D58;
  font-size: 24rpx;
  padding: 8rpx 12rpx;
  background: rgba(244, 67, 54, 0.1);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.record-del:active {
  background: #A94D58;
  color: #FFFFFF;
  transform: scale(0.95);
}

.record-line {
  color: #4C4A6E;
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.record-time {
  color: #A39EC2;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* ==================== 报告导出 ==================== */

.report-export-area {
  background: linear-gradient(135deg, #E7E3F6 0%, #F1EFFA 100%);
  border-radius: 36rpx;
  padding: 32rpx 24rpx;
  margin-top: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(82, 70, 123, 0.1);
  transition: all 0.3s ease;
}

.report-export-area:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(82, 70, 123, 0.2);
}

.report-export-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.report-export-subtitle {
  color: #4C4A6E;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.report-export-button {
  width: 100%;
  padding: 14rpx 24rpx;
  background: #52467B;
  color: #FFFFFF;
  border: none;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  min-height: 48rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.report-export-button:active {
  background: #372C57;
  box-shadow: 0 8rpx 20rpx rgba(82, 70, 123, 0.3);
  transform: scale(0.96);
}

/* ==================== 空状态 ==================== */

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}
