/* 结论页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 同心圆 */
page::before {
  content: '';
  position: fixed;
  top: 50%;
  left: 50%;
  width: 1000rpx;
  height: 1000rpx;
  margin-left: -500rpx;
  margin-top: -500rpx;
  background: 
    radial-gradient(circle at center, transparent 100rpx, rgba(139, 92, 246, 0.02) 100rpx, rgba(139, 92, 246, 0.02) 110rpx, transparent 110rpx),
    radial-gradient(circle at center, transparent 250rpx, rgba(124, 92, 252, 0.03) 250rpx, rgba(124, 92, 252, 0.03) 260rpx, transparent 260rpx),
    radial-gradient(circle at center, transparent 400rpx, rgba(109, 78, 237, 0.02) 400rpx, rgba(109, 78, 237, 0.02) 410rpx, transparent 410rpx);
  z-index: 0;
}

page::after {
  content: '';
  position: fixed;
  top: 0;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .report-export-area, canvas {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.location-row {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.result-panel {
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

.section-heading {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s backwards;
}

.insight-card {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.insight-card:nth-child(1) { animation-delay: 0.5s; }
.insight-card:nth-child(2) { animation-delay: 0.6s; }
.insight-card:nth-child(3) { animation-delay: 0.7s; }

.advice-list {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s backwards;
}

.disclaimer {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s backwards;
}

.report-export-section {
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 1s backwards;
}

/* ==================== 点击效果 ==================== */

/* 卡片点击效果 */
.card {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.card:active {
  transform: scale(0.98) translateY(4rpx);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.25);
}

/* 卡片标题点击效果 */
.card-title {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.card-title:active {
  transform: scale(1.05) translateX(8rpx);
  color: #8B5CF6;
}

/* 卡片副标题点击效果 */
.card-sub {
  transition: all 0.3s ease;
}

.card-sub:active {
  transform: scale(0.98);
  color: #8B5CF6;
}

/* 提示框点击效果 */
.tips {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tips:active {
  transform: scale(1.02) translateY(-2rpx);
  background: rgba(139, 92, 246, 0.12);
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.2);
}

/* 表单输入框包装点击效果 */
.form-input-wrap {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.form-input-wrap:active {
  transform: scale(0.98);
  background: #F5F3FF;
  border-color: #8B5CF6;
  box-shadow: 0rpx 0rpx 0rpx 6rpx rgba(139, 92, 246, 0.1);
}

.picker-arrow {
  transition: all 0.3s ease;
  display: inline-block;
}

.form-input-wrap:active .picker-arrow {
  transform: scale(1.3) rotate(180deg);
  color: #8B5CF6;
}

/* 表单行点击效果 */
.form-row {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.form-row:active {
  transform: translateX(8rpx) scale(0.99);
  background: rgba(139, 92, 246, 0.05);
}

/* 表单标签点击效果 */
.form-label {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.form-label:active {
  transform: scale(1.05);
  color: #8B5CF6;
}

/* 表单输入框点击效果 */
.form-input {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.form-input:active {
  transform: scale(1.02);
  background: rgba(139, 92, 246, 0.05);
}

/* 幽灵按钮点击效果 */
.btn-ghost {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.btn-ghost:active {
  transform: scale(0.95) translateY(2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.4);
}

/* 结果区域点击效果 */
.result {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.result:active {
  transform: scale(1.02) translateY(-2rpx);
  background: linear-gradient(135deg, #F5F3FF 0%, #FFFFFF 100%);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.2);
}

/* 结果行点击效果 */
.result-line {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.result-line:active {
  transform: translateX(8rpx) scale(1.02);
}

/* 结果标签点击效果 */
.result-label {
  transition: all 0.3s ease;
}

.result-label:active {
  transform: scale(1.05);
  color: #8B5CF6;
}

/* 结果数字点击效果 */
.result-num {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.result-num:active {
  transform: scale(1.1) rotate(-2deg);
  color: #8B5CF6;
}

/* 记录卡片点击效果 */
.record {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.record:active {
  background: #F5F3FF;
  transform: translateX(8rpx) scale(0.98);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.25);
}

/* 记录头部点击效果 */
.record-head {
  transition: all 0.3s ease;
}

.record-head:active {
  transform: scale(1.02);
}

/* 记录地点点击效果 */
.record-place {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.record-place:active {
  transform: scale(1.05) translateX(4rpx);
  color: #8B5CF6;
}

/* 记录删除按钮点击效果 */
.record-del {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.record-del:active {
  transform: scale(0.9) rotate(-5deg);
  color: #EF4444;
  background: rgba(239, 68, 68, 0.15);
  box-shadow: 0rpx 4rpx 12rpx rgba(239, 68, 68, 0.3);
}

/* 记录行点击效果 */
.record-line {
  transition: all 0.3s ease;
}

.record-line:active {
  transform: translateX(8rpx) scale(1.01);
  color: #8B5CF6;
}

/* 记录时间点击效果 */
.record-time {
  transition: all 0.3s ease;
}

.record-time:active {
  transform: scale(1.05);
  color: #8B5CF6;
}

/* 报告导出区域点击效果 */
.report-export-area {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.report-export-area:active {
  transform: scale(0.98) translateY(4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.3);
}

/* 报告导出标题点击效果 */
.report-export-title {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.report-export-title:active {
  transform: scale(1.05);
  color: #8B5CF6;
}

/* 报告导出副标题点击效果 */
.report-export-subtitle {
  transition: all 0.3s ease;
}

.report-export-subtitle:active {
  transform: scale(1.02);
  color: #8B5CF6;
}

/* 报告导出按钮点击效果 */
.report-export-button {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.report-export-button:active {
  transform: scale(0.95) translateY(4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.5),
              0rpx 0rpx 60rpx rgba(124, 92, 252, 0.4);
}

/* ==================== 悬停效果 ==================== */

.location-row:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.25);
}

.result-panel:hover {
  transform: translateY(-8rpx) scale(1.01);
  box-shadow: 0rpx 32rpx 80rpx rgba(124, 92, 252, 0.3);
}

.result-kicker:hover {
  transform: scale(1.05);
  color: #7C5CFC;
  letter-spacing: 4rpx;
}

.result-verdict:hover {
  transform: scale(1.02);
}

.result-detail:hover {
  transform: translateX(8rpx);
  color: #8B5CF6;
}

.result-badge:hover {
  transform: scale(1.15) rotate(-5deg);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.5);
}

.result-score:hover {
  transform: scale(1.1) rotate(360deg);
}

.score-label:hover {
  transform: scale(1.05);
  color: #8B5CF6;
}

.result-features:hover {
  transform: scale(1.01);
}

.feature-item:hover {
  transform: scale(1.1) translateY(-4rpx);
  background: rgba(139, 92, 246, 0.15);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.3);
}

.section-heading:hover {
  transform: translateX(8rpx);
}

.section-title:hover {
  transform: scale(1.05);
  color: #8B5CF6;
}

.section-caption:hover {
  transform: translateX(4rpx);
  color: #8B5CF6;
}

.insight-card:hover {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: 0rpx 24rpx 60rpx rgba(124, 92, 252, 0.25);
}

.insight-icon:hover {
  transform: scale(1.3) rotate(360deg);
}

.insight-label:hover {
  transform: scale(1.05);
  color: #8B5CF6;
}

.insight-text:hover {
  transform: translateX(4rpx);
  color: #8B5CF6;
}

.advice-list:hover {
  transform: scale(1.01);
}

.advice-item:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.05);
}

.advice-dot:hover {
  transform: scale(1.3);
  background: #7C5CFC;
}

.advice-text:hover {
  color: #8B5CF6;
}

.disclaimer:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.08);
}

.disclaimer-symbol:hover {
  transform: scale(1.3);
  color: #8B5CF6;
}

.disclaimer-text:hover {
  color: #8B5CF6;
}

.report-export-section:hover {
  transform: translateY(-8rpx) scale(1.01);
  box-shadow: 0rpx 32rpx 80rpx rgba(124, 92, 252, 0.3);
}

.report-export-icon:hover {
  transform: scale(1.3) rotate(360deg);
}

.report-export-title:hover {
  transform: scale(1.05);
  color: #8B5CF6;
}

.report-export-subtitle:hover {
  transform: scale(1.02);
  color: #8B5CF6;
}

.report-export-button:hover {
  transform: translateY(-6rpx) scale(1.05);
  box-shadow: 0rpx 24rpx 60rpx rgba(124, 92, 252, 0.6),
              0rpx 0rpx 80rpx rgba(124, 92, 252, 0.5);
}

