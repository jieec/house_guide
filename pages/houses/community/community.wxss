/* 房源社区页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* 背景装饰 - 菱形网格 */
page::before {
  content: '';
  position: fixed;
  top: -100rpx;
  left: -100rpx;
  right: -100rpx;
  height: 600rpx;
  background: 
    linear-gradient(45deg, transparent 48%, rgba(139, 92, 246, 0.03) 48%, rgba(139, 92, 246, 0.03) 52%, transparent 52%),
    linear-gradient(-45deg, transparent 48%, rgba(124, 92, 252, 0.03) 48%, rgba(124, 92, 252, 0.03) 52%, transparent 52%);
  background-size: 80rpx 80rpx;
  z-index: 0;
  opacity: 0.6;
}

page::after {
  content: '';
  position: fixed;
  bottom: -150rpx;
  left: 50%;
  margin-left: -300rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(109, 78, 237, 0.08) 0%, transparent 65%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary, .btn-ghost {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.community-header {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.map-view {
  animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

.info-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.info-section:nth-child(1) { animation-delay: 0.3s; }
.info-section:nth-child(2) { animation-delay: 0.4s; }
.info-section:nth-child(3) { animation-delay: 0.5s; }

.house-item {
  animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

/* ==================== 点击效果 ==================== */

.community-header {
  transition: all 0.3s ease;
}

.community-header:active {
  transform: scale(0.98) translateY(4rpx);
}

.info-row {
  transition: all 0.3s ease;
}

.info-row:active {
  background: #F5F3FF;
  transform: translateX(6rpx);
  margin: 0 -12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.tag {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active {
  transform: scale(0.92) translateY(2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.3);
}

.house-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.house-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx) scale(0.98);
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.15);
}

.map-view {
  transition: all 0.3s ease;
}

.map-view:active {
  transform: scale(0.98);
}

.info-section {
  transition: all 0.3s ease;
}

.info-section:active {
  transform: scale(0.99);
}

/* ==================== 悬停效果 ==================== */

.community-header:hover {
  transform: translateY(-4rpx) scale(1.01);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.info-row:hover {
  background: rgba(139, 92, 246, 0.06);
  transform: translateX(8rpx);
  color: #8B5CF6;
}

.tag:hover {
  transform: scale(1.08) translateY(-2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.4);
}

.house-item:hover {
  transform: translateY(-6rpx) translateX(8rpx) scale(1.02);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.25);
}

.map-view:hover {
  transform: scale(1.02);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.info-section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15);
}

