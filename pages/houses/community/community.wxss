.c-head {
  background: linear-gradient(180deg, #0a1628 0%, #0f2244 50%, #1a3d8f 100%);
  padding: 36rpx 40rpx 40rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
}

.c-city {
  font-size: 24rpx;
  color: #8aa4cc;
}

.c-name {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.c-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.d-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.d-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.d-card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #2f6bff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.grade-row {
  display: flex;
  align-items: center;
}

.grade-score {
  font-size: 72rpx;
  font-weight: 700;
  color: #00d4ff;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.grade-list {
  flex: 1;
}

.grade-item {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 24rpx;
}

.grade-name {
  width: 130rpx;
  color: #7b8fb0;
}

.grade-val {
  width: 50rpx;
  color: #00d4ff;
  font-weight: 600;
}

.grade-tips {
  flex: 1;
  color: #5b7aa8;
  font-size: 22rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-cell {
  width: 33.33%;
  text-align: center;
  margin-bottom: 22rpx;
}

.info-v {
  font-size: 26rpx;
  font-weight: 600;
  color: #e8f0fe;
  padding: 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-k {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.poi-group {
  margin-bottom: 20rpx;
}

.poi-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #00d4ff;
  margin-bottom: 8rpx;
}

.poi-count {
  font-weight: 400;
  color: #7b8fb0;
  font-size: 22rpx;
}

.poi-item {
  display: flex;
  align-items: baseline;
  padding: 6rpx 0;
  font-size: 24rpx;
}

.poi-name {
  color: #e8f0fe;
  max-width: 55%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-dist {
  margin-left: 12rpx;
  color: #ff9a6c;
  flex-shrink: 0;
}

.poi-info {
  margin-left: 12rpx;
  color: #5b7aa8;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-toggle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #00d4ff;
}

.near-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.near-item:last-child {
  border-bottom: none;
}

.near-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.near-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.near-right {
  text-align: right;
}

.near-price {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff6b35;
}

.near-score {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #ff9a6c;
}

.intro {
  font-size: 26rpx;
  color: #8aa4cc;
  line-height: 1.7;
}

.intro-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.intro-toggle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #00d4ff;
}

.c-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8aa4cc;
  line-height: 1.5;
}

.type-bar {
  display: flex;
  padding: 20rpx 24rpx 4rpx;
  gap: 16rpx;
}

.type-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background: rgba(16, 32, 64, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7b8fb0;
}

.type-active {
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 180, 255, 0.3);
}

.house-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.house-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.house-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-right: 16rpx;
  color: #ffffff;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.house-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #00d4ff;
  background: rgba(0, 180, 255, 0.1);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.tag-green {
  color: #5ddb7a;
  background: rgba(35, 195, 67, 0.1);
  border-color: rgba(35, 195, 67, 0.2);
}

.house-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.meta-item {
  margin-right: 24rpx;
}

.house-loc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b8fb0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b35;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #ff9a6c;
  margin-left: 4rpx;
}

.house-unit {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.house-tags {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7b8fb0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analyze-chip {
  margin-left: auto;
  background: rgba(0, 180, 255, 0.1);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  color: #00d4ff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.load-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #5b7aa8;
}
