page { background:#f5f6ff !important; color:#34406f !important; padding-bottom:calc(140rpx + env(safe-area-inset-bottom)) !important; }
.city-card { display:flex; align-items:center; background:linear-gradient(135deg,#dce1ff,#c8d1fa) !important; border:1rpx solid #d2d8fb !important; margin:20rpx 24rpx; border-radius:22rpx; padding:25rpx 28rpx; color:#303b66; box-shadow:0 12rpx 26rpx rgba(105,116,200,.12); }.city-body { flex:1; min-width:0; }.city-icon { font-size:40rpx; margin-right:18rpx; }.city-name { font-size:34rpx; font-weight:700; color:#303b66; }.city-arrow { font-size:21rpx; margin-top:4rpx; color:#626e91; }.locate-btn { color:#5866c8; background:#eef0ff; border:1rpx solid #d5daf8; border-radius:32rpx; padding:11rpx 20rpx; font-size:23rpx; flex-shrink:0; }
.type-bar { display:flex; padding:0 24rpx; margin-bottom:8rpx; gap:14rpx; }.type-chip { flex:1; text-align:center; padding:15rpx 0; background:#fff; border:1rpx solid #e0e3f5; border-radius:26rpx; font-size:24rpx; color:#626e98; }.type-active { background:linear-gradient(135deg,#8994ed,#6976d2); color:#fff; border-color:transparent; }
.search-bar { padding:12rpx 24rpx 4rpx; }.search-box { display:flex; align-items:center; background:#f7f8ff; border:1rpx solid #d8def3; border-radius:18rpx; padding:15rpx 24rpx; }.search-input { flex:1; min-width:0; font-size:27rpx; color:#354269; background:transparent; }.search-icon { color:#68739a; font-size:34rpx; margin-right:12rpx; }
.house-card { background:#fff; border:1rpx solid #e1e4f7; margin:18rpx 24rpx; border-radius:20rpx; padding:25rpx; box-shadow:0 8rpx 22rpx rgba(119,127,185,.08); }.house-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12rpx; }.house-title { flex:1; min-width:0; font-size:29rpx; font-weight:650; line-height:1.4; margin-right:12rpx; color:#354269; }.house-tag { color:#a65a36; background:#fff1e9; border:1rpx solid #f4d9c9; border-radius:8rpx; padding:4rpx 11rpx; font-size:21rpx; }.house-meta { margin-top:13rpx; font-size:23rpx; color:#626e91; }.house-loc { margin-top:9rpx; font-size:22rpx; color:#626e91; }.house-foot { margin-top:15rpx; display:flex; align-items:baseline; }.house-price { font-size:34rpx; font-weight:700; color:#695fc3; }.house-unit { margin-left:14rpx; font-size:22rpx; color:#626e91; }.analyze-chip { margin-left:auto; color:#5866c8; background:#eef0ff; border:1rpx solid #d5daf8; font-size:22rpx; padding:7rpx 18rpx; border-radius:24rpx; }.count-bar { padding:12rpx 30rpx 4rpx; font-size:23rpx; color:#626e91; }.load-tip { text-align:center; padding:24rpx; font-size:23rpx; color:#626e91; }.empty-tip { text-align:center; padding:90rpx 30rpx; color:#626e91; font-size:24rpx; }.empty-emoji { display:block; margin-bottom:12rpx; font-size:60rpx; }
.city-mask { position:fixed; inset:0; background:rgba(30,38,75,.38); z-index:99; }.city-panel { position:fixed; left:0; right:0; bottom:0; background:#fff; border-radius:28rpx 28rpx 0 0; z-index:100; padding:24rpx; height:70vh; display:flex; flex-direction:column; box-sizing:border-box; }.city-search-box { display:flex; align-items:center; background:#f7f8ff; border:1rpx solid #d8def3; border-radius:18rpx; padding:13rpx 22rpx; }.city-search-input { flex:1; min-width:0; color:#354269; background:transparent; }.city-list { flex:1; margin-top:15rpx; }.city-item { display:flex; justify-content:space-between; padding:21rpx 18rpx; border-bottom:1rpx solid #edf0fa; color:#354269; font-size:28rpx; }.city-item-active,.city-check { color:#5866c8; }.city-empty { text-align:center; padding:75rpx 0; color:#626e91; }
