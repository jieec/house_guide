.city-card {
  display: flex;
  align-items: center;
  background: linear-gradient(160deg, #1a3d8f 0%, #2f6bff 100%);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 255, 0.3);
}

.city-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.city-body {
  flex: 1;
}

.city-name {
  font-size: 38rpx;
  font-weight: 700;
}

.city-arrow {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.locate-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.locate-btn:active {
  opacity: 0.8;
}

.city-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.city-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 100;
  padding: 24rpx;
  height: 70vh;
  display: flex;
  flex-direction: column;
}

.city-search-box {
  display: flex;
  align-items: center;
  background: #f2f4f9;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  flex-shrink: 0;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.city-search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #b0b8cc;
  padding: 0 8rpx;
}

.city-list {
  flex: 1;
  margin-top: 16rpx;
}

.city-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #f0f2f8;
  font-size: 30rpx;
  color: #1f2430;
}

.city-item-active {
  color: #2f6bff;
  font-weight: 600;
}

.city-check {
  color: #2f6bff;
  font-size: 30rpx;
}

.city-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #b0b8cc;
  font-size: 28rpx;
}

.type-bar {
  display: flex;
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.type-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  margin: 0 8rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5a6478;
}

.type-active {
  background: #2f6bff;
  color: #ffffff;
  font-weight: 600;
}

.search-bar {
  padding: 12rpx 24rpx 4rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 56, 110, 0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.cell-score {
  font-size: 26rpx;
  color: #ff7a45;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.cell-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.count-bar {
  padding: 12rpx 32rpx 4rpx;
  font-size: 24rpx;
  color: #9aa4ba;
}

.house-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 56, 110, 0.05);
}

.house-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.house-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-right: 16rpx;
  color: #1f2430;
}

.house-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #ff7a45;
  background: #fff3ec;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.house-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5a6478;
}

.meta-item {
  margin-right: 24rpx;
}

.house-loc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aa4ba;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d3a;
}

.house-unit {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9aa4ba;
}

.analyze-chip {
  margin-left: auto;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.load-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #b0b8cc;
}
