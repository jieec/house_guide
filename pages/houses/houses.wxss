/* Habo 绿色主题 - 房源列表页 */

.houses-layout {
  min-height: 100vh;
  background: #F6F5FC;
}

.houses-main {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 城市卡片 */
.city-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(55, 44, 87, 0.04);
  margin-bottom: 18rpx;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.city-card:active {
  transform: scale(0.985);
  box-shadow: 0 10rpx 28rpx rgba(55, 44, 87, 0.08);
}

.city-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #E7E3F6;
  color: #52467B;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
}

.city-body {
  flex: 1;
  min-width: 0;
}

.city-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-arrow {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #6B6890;
  margin-top: 6rpx;
  letter-spacing: 0.3rpx;
}

.locate-btn {
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #EFECFA;
  color: #52467B;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.locate-btn:active {
  background: #E7E3F6;
  transform: scale(0.96);
}

.btn-locate {
  width: 44rpx;
  height: 44rpx;
  border-radius: 20rpx;
  background: #E7E3F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  transition: all 0.3s ease;
}

.btn-locate:active {
  background: #D8D3EC;
  transform: scale(0.95);
}

.btn-locate.loading {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 城市选择面板 */
.city-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(55, 44, 87, 0.4);
  z-index: 99;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.city-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 100;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.city-panel-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.city-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #EBE8F7;
  flex-shrink: 0;
}

.panel-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 600;
}

.panel-close {
  color: #9490B2;
  font-size: 28rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.panel-close:active {
  color: #52467B;
  transform: scale(1.1);
}

.city-search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  margin: 12rpx 0;
}

.search-icon {
  color: #9490B2;
  font-size: 24rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  padding: 8rpx;
  border: 0;
  background: transparent;
  color: #2A2846;
  font-size: 28rpx;
  outline: none;
}

.search-input::placeholder {
  color: #9490B2;
}

.search-clear {
  color: #9490B2;
  font-size: 20rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.search-clear:active {
  color: #52467B;
  transform: scale(1.2);
}

.city-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.city-item:active {
  background: #F6F5FC;
}

.city-item.active {
  background: #E7E3F6;
}

.city-name {
  color: #2A2846;
  font-size: 30rpx;
}

.city-item.active .city-name {
  color: #52467B;
  font-weight: 600;
}

.city-check {
  color: #52467B;
  font-size: 24rpx;
  font-weight: 600;
}

.city-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #9490B2;
  font-size: 28rpx;
}

/* 过滤条 */
.filter-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.filter-bar::-webkit-scrollbar {
  height: 0;
}

.filter-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #EBE8F7;
  color: #4C4A6E;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  white-space: nowrap;
}

.filter-chip:active {
  transform: scale(0.96);
}

.filter-chip.active {
  background: #52467B;
  color: #FFFFFF;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(82, 70, 123, 0.3);
}

.search-card .search-icon {
  color: #9490B2;
  font-size: 24rpx;
  flex-shrink: 0;
}

.search-card .search-input {
  flex: 1;
  border: 0;
  background: transparent;
  color: #2A2846;
  font-size: 30rpx;
  outline: none;
}

.search-card .search-input::placeholder {
  color: #9490B2;
}

/* 结果计数 */
.result-count {
  padding: 12rpx 0;
  margin-bottom: 12rpx;
  color: #4C4A6E;
  font-size: 28rpx;
}

.count-badge {
  display: inline-block;
  padding: 2rpx 8rpx;
  background: #E7E3F6;
  color: #52467B;
  border-radius: 6rpx;
  font-weight: 600;
  margin: 0 4rpx;
}

/* 列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 36rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 搜索 / 计数（补全） ==================== */

.search-bar {
  margin-bottom: 18rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 20rpx rgba(55, 44, 87, 0.04);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-box:focus-within {
  border-color: #C1BAD9;
  box-shadow: 0 6rpx 24rpx rgba(82, 70, 123, 0.1);
}

.search-icon {
  color: #9490B2;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.count-bar {
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #6B6890;
  letter-spacing: 0.4rpx;
  padding: 4rpx 4rpx 18rpx;
}

.city-search-input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  color: #2A2846;
  font-size: 28rpx;
  outline: none;
}

.city-search-input::placeholder {
  color: #A39EC2;
}
