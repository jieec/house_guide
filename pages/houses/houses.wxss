.city-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0f2244 0%, #1a3d8f 100%);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 50, 120, 0.4);
}

.city-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.city-body {
  flex: 1;
}

.city-name {
  font-size: 38rpx;
  font-weight: 700;
}

.city-arrow {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 4rpx;
}

.locate-btn {
  background: rgba(0, 180, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #00d4ff;
  flex-shrink: 0;
}

.locate-btn:active {
  opacity: 0.8;
}

.city-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
}

.city-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #0d1d35;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 100;
  padding: 24rpx;
  height: 70vh;
  display: flex;
  flex-direction: column;
}

.city-search-box {
  display: flex;
  align-items: center;
  background: rgba(10, 25, 50, 0.8);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  flex-shrink: 0;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #5b7aa8;
}

.city-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #e8f0fe;
  background: transparent;
}

.search-clear {
  color: #5b7aa8;
  padding: 0 8rpx;
}

.city-list {
  flex: 1;
  margin-top: 16rpx;
}

.city-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
  font-size: 30rpx;
  color: #e8f0fe;
}

.city-item-active {
  color: #00d4ff;
  font-weight: 600;
}

.city-check {
  color: #00d4ff;
  font-size: 30rpx;
}

.city-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #5b7aa8;
  font-size: 28rpx;
}

.type-bar {
  display: flex;
  padding: 0 24rpx;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.type-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: rgba(16, 32, 64, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.1);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7b8fb0;
}

.type-active {
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 180, 255, 0.3);
}

.search-bar {
  padding: 12rpx 24rpx 4rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(10, 25, 50, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #e8f0fe;
  background: transparent;
}

.cell-score {
  font-size: 26rpx;
  color: #ff9a6c;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.cell-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.count-bar {
  padding: 12rpx 32rpx 4rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.house-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.2);
}

.house-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.house-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-right: 16rpx;
  color: #ffffff;
}

.house-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #ff9a6c;
  background: rgba(255, 122, 69, 0.15);
  border: 1rpx solid rgba(255, 122, 69, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.house-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.meta-item {
  margin-right: 24rpx;
}

.house-loc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b8fb0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b35;
}

.house-unit {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.analyze-chip {
  margin-left: auto;
  background: rgba(0, 180, 255, 0.1);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  color: #00d4ff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.load-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #5b7aa8;
}
