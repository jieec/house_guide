<!-- 全局固定背景 -->
<image class="global-fixed-bg" src="/images/整体背景.jpg" mode="aspectFill"></image>

<view class="analysis-main">
  <view class="demo-strip" wx:if="{{demoMode}}">
    <view class="demo-title">本地演示 · 全部为模拟数据</view>
    <view class="demo-copy">用于验证估价、页面和 PDF 流程，不代表真实房产或在线模型结果。</view>
    <picker range="{{demoScenarios}}" range-key="label" value="{{demoScenarioIndex}}" bindchange="onDemoScenario" disabled="{{exportingReport}}">
      <view class="demo-picker">测试场景：{{demoScenarios[demoScenarioIndex].label}} <text>切换</text></view>
    </picker>
    <button class="demo-link" bindtap="goGuideDemo" disabled="{{exportingReport}}">查看小区报告演示</button>
  </view>

<view wx:if="{{loading}}" class="load-tip">正在读取房源…</view>

<block wx:elif="{{item}}">
  <view class="a-hero animated" style="animation-delay: 0.05s">
    <view class="a-city">{{item.city}} · {{item.community || item.district || ''}}</view>
    <view class="a-title">{{item.title}}</view>
    <view class="a-price" wx:if="{{saleTotal}}">{{saleTotal}}万<text class="a-unit2" wx:if="{{salePer}}"> · {{salePer}}元/㎡</text></view>
    <view class="a-meta">{{item.rooms}} <text wx:if="{{area}}">{{area}}㎡</text><text wx:else>面积待核实</text> {{item.orientation}}</view>
  </view>

  <block wx:if="{{isRent}}">
    <view class="card animated" style="animation-delay: 0.10s">
      <view class="card-title">租售比参考</view>
      <view class="card-sub">当前为租房房源：租金单价 {{rentPerSqm}} 元/平/月</view>
      <view class="form-row">
        <view class="form-label">房价(元/平)</view>
        <input class="form-input" type="digit" placeholder="输入房价计算租售比" value="{{pricePerSqm}}" data-field="pricePerSqm" bindinput="onInput" disabled="{{exportingReport}}" />
      </view>
      <view class="btn-ghost" bindtap="calcRentRatio">计算租售比</view>
      <view class="result" wx:if="{{rentRatioResult}}">
        <view class="result-line">
          <view class="result-label">租售比(月)</view>
          <view class="result-num">{{rentRatioResult}}</view>
        </view>
        <view class="result-line">
          <view class="result-label">年化回报率</view>
          <view class="result-num">{{annualReturn}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="valuation-actions">
      <view class="valuation-actions-title">单套房估价</view>
      <view class="valuation-actions-copy">基准价、模型候选价和采用价分别展示，待复核结果保留公式参考价。</view>
      <button class="valuation-button" bindtap="runValuation" loading="{{valuationLoading}}" disabled="{{valuationLoading || exportingReport}}">{{valuationLoading ? '正在生成估价…' : (valuationReport ? '重新生成估价' : '生成估价报告')}}</button>
    </view>
    <valuation-panel report="{{valuationReport}}" loading="{{valuationLoading}}" error="{{valuationError}}" bind:retry="runValuation" />
    <view class="card animated" style="animation-delay: 0.15s">
      <view class="card-title">分析参数</view>
      <view class="card-sub">房源数据用于预算测算；修改面积或目的后，需要重新生成估价报告。</view>
      <view class="form-row">
        <view class="form-label">购房目的</view>
        <picker class="form-input-wrap" range="{{purposes}}" value="{{purposeIndex}}" bindchange="onPurpose" disabled="{{exportingReport}}">
          <view>{{purposes[purposeIndex]}}<view class="ic ic-chevron picker-arrow"></view></view>
        </picker>
      </view>
      <view class="form-row">
        <view class="form-label">销售价(元/平)</view>
        <input class="form-input" type="digit" placeholder="房源挂牌单价" value="{{salePer}}" data-field="salePer" bindinput="onInput" disabled="{{exportingReport}}" />
      </view>
      <view class="form-row">
        <view class="form-label">评估价(元/平)</view>
        <view class="form-readonly">{{evalPer || '待生成'}}<text class="readonly-note">采用价随报告更新</text></view>
      </view>
      <view class="form-row">
        <view class="form-label">单套面积(㎡)</view>
        <input class="form-input" type="digit" placeholder="缺失时请人工核实补录" value="{{area}}" data-field="area" bindinput="onInput" disabled="{{exportingReport}}" />
      </view>
      <view class="form-row">
        <view class="form-label">本人年龄</view>
        <input class="form-input" type="number" value="{{age}}" data-field="age" bindinput="onInput" disabled="{{exportingReport}}" />
      </view>
      <view class="form-row">
        <view class="form-label">利率(%)</view>
        <input class="form-input" type="digit" value="{{rate}}" data-field="rate" bindinput="onInput" disabled="{{exportingReport}}" />
      </view>
      <view class="form-row">
        <view class="form-label">是否首套</view>
        <picker class="form-input-wrap" range="{{suiteType}}" value="{{suiteIndex}}" bindchange="onSuite" disabled="{exportingReport}">
          <view>{{suiteType[suiteIndex]}}<view class="ic ic-chevron picker-arrow"></view></view>
        </picker>
      </view>
      <view class="form-row">
        <view class="form-label">是否满2年</view>
        <picker class="form-input-wrap" range="{{fullTwo}}" value="{{fullTwoIndex}}" bindchange="onFullTwo" disabled="{exportingReport}">
          <view>{{fullTwo[fullTwoIndex]}}<view class="ic ic-chevron picker-arrow"></view></view>
        </picker>
      </view>
      <view class="form-row">
        <view class="form-label">满五唯一</view>
        <picker class="form-input-wrap" range="{{fullFive}}" value="{{fullFiveIndex}}" bindchange="onFullFive" disabled="{exportingReport}">
          <view>{{fullFive[fullFiveIndex]}}<view class="ic ic-chevron picker-arrow"></view></view>
        </picker>
      </view>
      <view class="warn-tip" wx:if="{{missingTip}}"><view class="ic ic-alert"></view>{{missingTip}}</view>
      <view class="btn-ghost" bindtap="calc">重新分析</view>
    </view>

    <view class="card animated" wx:if="{{gap}}" style="animation-delay: 0.20s">
      <view class="card-title">性价比测算</view>
      <view class="card-sub">（采用评估价 − 销售价）× 报告面积 × 85%，正值表示挂牌低于采用价</view>
      <view class="result">
        <view class="result-line">
          <view class="result-label">测算差额</view>
          <view class="result-num">{{gap}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">性价比等级</view>
          <view class="result-num">{{grade}}档 · {{gradeDesc}}</view>
        </view>
      </view>
    </view>

    <view class="card animated" wx:if="{{loanAmount}}" style="animation-delay: 0.25s">
      <view class="card-title">融资预算示例</view>
      <view class="result">
        <view class="result-line">
          <view class="result-label">示例贷款额(采用总价×85%)</view>
          <view class="result-num">{{loanAmount}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">建议年限(年龄+年限≤70)</view>
          <view class="result-num">{{maxYears}} 年</view>
        </view>
      </view>
      <view class="bank" wx:for="{{banks}}" wx:key="name">
        <view class="bank-info">
          <view class="bank-name">{{item.name}}</view>
          <view class="bank-type">{{item.type}}</view>
        </view>
        <view class="bank-call" data-phone="{{item.phone}}" bindtap="callBank">{{item.phone}}</view>
      </view>
    </view>

    <view class="card animated" wx:if="{{monthly}}" style="animation-delay: 0.30s">
      <view class="card-title">按揭测算</view>
      <view class="result">
        <view class="result-line">
          <view class="result-label">月供(等额本息)</view>
          <view class="result-num">{{monthly}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">总利息</view>
          <view class="result-num">{{totalInterest}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">总还款额</view>
          <view class="result-num">{{totalRepay}} 元</view>
        </view>
      </view>
    </view>

    <view class="card animated" wx:if="{{totalTax}}" style="animation-delay: 0.35s">
      <view class="card-title">税费示例测算</view>
      <view class="result">
        <view class="result-line">
          <view class="result-label">契税</view>
          <view class="result-num">{{deedTax}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">增值税</view>
          <view class="result-num">{{vatTax}} 元</view>
        </view>
        <view class="result-line">
          <view class="result-label">个税</view>
          <view class="result-num">{{incomeTax}} 元</view>
        </view>
        <view class="result-line result-total">
          <view class="result-label">税费合计</view>
          <view class="result-num">{{totalTax}} 元</view>
        </view>
      </view>
    </view>

    <view class="card animated" wx:if="{{risks.length}}" style="animation-delay: 0.40s">
      <view class="card-title">风险提示</view>
      <view class="risk-line" wx:for="{{risks}}" wx:key="*this"><view class="ic ic-alert"></view>{{item}}</view>
    </view>
  </block>
</block>

<view wx:if="{{!loading && loadError}}" class="load-error">
  <view>{{loadError}}</view>
  <button class="valuation-button" bindtap="loadCurrentHouse">重新读取房源</button>
</view>
<view wx:if="{{item && !isRent}}" class="single-report-export">
  <view class="export-heading">导出当前估价报告</view>
  <view class="export-description">估价结果、依据和建议与当前页面保持一致。{{demoMode ? 'PDF 将标注演示数据。' : ''}}</view>
  <button class="valuation-button" bindtap="exportPdf" loading="{{exportingReport}}" disabled="{{!canExport || valuationLoading || valuationDirty || valuationError || exportingReport}}">{{exportingReport ? '正在生成 PDF…' : '生成 PDF 报告'}}</button>
</view>
<canvas type="2d" id="pdfCanvas" class="single-pdf-canvas"></canvas>
</view>
