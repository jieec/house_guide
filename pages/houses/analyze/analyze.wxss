page { background:transparent !important; color:#eef2ff !important; padding-bottom:calc(140rpx + env(safe-area-inset-bottom)) !important; }
.a-hero { background:linear-gradient(135deg,#dce1ff,#c8d1fa) !important; padding:36rpx 28rpx; color:#303b66 !important; border-radius:0 0 30rpx 30rpx !important; box-shadow:0 12rpx 26rpx rgba(105,116,200,.12); }.a-city,.a-meta { font-size:23rpx; color:#626e91 !important; }.a-title { margin-top:9rpx; font-size:32rpx; font-weight:700; line-height:1.4; color:#303b66 !important; }.a-price { margin-top:18rpx; font-size:42rpx; font-weight:700; color:#695fc3 !important; }.a-unit2 { font-size:23rpx; font-weight:400; }.a-meta { margin-top:7rpx; }.bank { display:flex; justify-content:space-between; align-items:center; padding:17rpx 0; border-bottom:1rpx solid #edf0fa; }.bank-name { color:#354269 !important; font-size:27rpx; }.bank-type { margin-top:4rpx; font-size:21rpx; color:#626e91 !important; }.bank-call { color:#5866c8 !important; font-size:25rpx; padding:8rpx 23rpx; border:1rpx solid #cbd1f2; border-radius:32rpx; }.risk-line { padding:9rpx 0; font-size:25rpx; color:#586587 !important; line-height:1.6; }.warn-tip { margin-top:8rpx; background:#fff5e9; color:#8c5738; border:1rpx solid #f2e0c9; border-radius:13rpx; padding:15rpx 18rpx; font-size:24rpx; }.result-total { border-top:1rpx solid #edf0fa; margin-top:8rpx; padding-top:15rpx; }.load-tip { text-align:center; padding:56rpx; color:#626e91 !important; }
page .card { background:#fff !important; border-color:#e1e4f7 !important; box-shadow:0 8rpx 22rpx rgba(119,127,185,.08) !important; } page .card-title { color:#303b66 !important; } page .card-sub,page .form-label,page .result-label { color:#586587 !important; } page .form-input,page .form-input-wrap { background:#f7f8ff !important; color:#354269 !important; border-color:#d8def3 !important; } page .result { background:#f0f1ff !important; border-color:#dfe2f7 !important; } page .result-num { color:#5866c8 !important; }
.calculate-button,.btn-primary { color:#fff !important; background:linear-gradient(112deg,#a75bff 0%,#695cff 52%,#4b9cff 100%) !important; }

