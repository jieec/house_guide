/* 房源分析页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 渐变条纹 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: -200rpx;
  width: 800rpx;
  height: 800rpx;
  background: 
    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 60rpx,
      rgba(139, 92, 246, 0.04) 60rpx,
      rgba(139, 92, 246, 0.04) 120rpx
    );
  z-index: 0;
  opacity: 0.7;
}

page::after {
  content: '';
  position: fixed;
  bottom: -200rpx;
  right: -200rpx;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(circle, rgba(109, 78, 237, 0.1) 0%, rgba(124, 92, 252, 0.05) 40%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary, .btn-ghost, canvas {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.house-header {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.score-card {
  animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

.analysis-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.analysis-section:nth-child(1) { animation-delay: 0.3s; }
.analysis-section:nth-child(2) { animation-delay: 0.4s; }
.analysis-section:nth-child(3) { animation-delay: 0.5s; }
.analysis-section:nth-child(4) { animation-delay: 0.6s; }

/* ==================== 点击效果 ==================== */

.house-header {
  transition: all 0.3s ease;
}

.house-header:active {
  transform: scale(0.98) translateY(4rpx);
}

.analysis-section {
  transition: all 0.3s ease;
}

.analysis-section:active {
  transform: scale(0.99);
}

.info-row {
  transition: all 0.3s ease;
}

.info-row:active {
  background: #F5F3FF;
  transform: translateX(6rpx);
  margin: 0 -12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.score-card {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.score-card:active {
  transform: scale(0.95) translateY(4rpx);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.2);
  background: #F5F3FF;
}

.dimension-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dimension-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx);
  border-left: 4rpx solid #8B5CF6;
  padding-left: 28rpx;
}

.tag {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active {
  transform: scale(0.92) translateY(2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.3);
}

/* ==================== 悬停效果 ==================== */

.house-header:hover {
  transform: translateY(-4rpx) scale(1.01);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.analysis-section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15);
}

.info-row:hover {
  background: rgba(139, 92, 246, 0.06);
  transform: translateX(8rpx);
  color: #8B5CF6;
}

.score-card:hover {
  transform: translateY(-6rpx) scale(1.03);
  box-shadow: 0rpx 24rpx 72rpx rgba(124, 92, 252, 0.3);
}

.dimension-item:hover {
  background: rgba(139, 92, 246, 0.08);
  transform: translateX(12rpx);
  border-left: 4rpx solid #8B5CF6;
  padding-left: 28rpx;
}

.tag:hover {
  transform: scale(1.08) translateY(-2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.4);
}

