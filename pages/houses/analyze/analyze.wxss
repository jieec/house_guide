/* 房源分析页面 - 柔和紫色风格 */

page {
  background: transparent;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 渐变条纹 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: -200rpx;
  width: 800rpx;
  height: 800rpx;
  background: 
    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 60rpx,
      rgba(82, 70, 123, 0.04) 60rpx,
      rgba(82, 70, 123, 0.04) 120rpx
    );
  z-index: -5;
  opacity: 0.7;
}

page::after {
  content: '';
  position: fixed;
  bottom: -200rpx;
  right: -200rpx;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(circle, rgba(7, 168, 42, 0.1) 0%, rgba(82, 70, 123, 0.05) 40%, transparent 70%);
  border-radius: 50%;
  z-index: -5;
}canvas {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.house-header {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.score-card {
  animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

.analysis-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.analysis-section:nth-child(1) { animation-delay: 0.3s; }
.analysis-section:nth-child(2) { animation-delay: 0.4s; }
.analysis-section:nth-child(3) { animation-delay: 0.5s; }
.analysis-section:nth-child(4) { animation-delay: 0.6s; }

/* ==================== 点击效果 ==================== */

.house-header {
  transition: all 0.3s ease;
}

.house-header:active {
  transform: scale(0.98) translateY(4rpx);
}

.analysis-section {
  transition: all 0.3s ease;
}

.analysis-section:active {
  transform: scale(0.99);
}

.info-row {
  transition: all 0.3s ease;
}

.info-row:active {
  background: #EFECFA;
  transform: translateX(6rpx);
  margin: 0 -12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.score-card {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.score-card:active {
  transform: scale(0.95) translateY(4rpx);
  box-shadow: 0rpx 12rpx 32rpx rgba(82, 70, 123, 0.2);
  background: #EFECFA;
}

.dimension-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dimension-item:active {
  background: #EFECFA;
  transform: translateX(8rpx);
  border-left: 4rpx solid #C1BAD9;
  padding-left: 28rpx;
}

.tag {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active {
  transform: scale(0.92) translateY(2rpx);
  background: linear-gradient(135deg, #52467B 0%, #372C57 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 16rpx rgba(82, 70, 123, 0.3);
}

/* ==================== 悬停效果 ==================== */

.house-header:hover {
  transform: translateY(-4rpx) scale(1.01);
  box-shadow: 0rpx 16rpx 48rpx rgba(82, 70, 123, 0.2);
}

.analysis-section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0rpx 12rpx 40rpx rgba(82, 70, 123, 0.15);
}

.info-row:hover {
  background: rgba(82, 70, 123, 0.06);
  transform: translateX(8rpx);
  color: #52467B;
}

.score-card:hover {
  transform: translateY(-6rpx) scale(1.03);
  box-shadow: 0rpx 24rpx 72rpx rgba(82, 70, 123, 0.3);
}

.dimension-item:hover {
  background: rgba(82, 70, 123, 0.08);
  transform: translateX(12rpx);
  border-left: 4rpx solid #C1BAD9;
  padding-left: 28rpx;
}

.tag:hover {
  transform: scale(1.08) translateY(-2rpx);
  background: linear-gradient(135deg, #52467B 0%, #372C57 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 8rpx 24rpx rgba(82, 70, 123, 0.4);
}

/* 通用样式继承自全局 app.wxss */

/* ==================== 分析页头部 ==================== */

.a-hero {
  background: linear-gradient(135deg, #E7E3F6 0%, #EDEAF9 55%, #F5F4FC 100%);
  border: 1rpx solid #D8D3EC;
  border-radius: 36rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 14rpx 40rpx rgba(55, 44, 87, 0.07);
}

.a-city {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #695C93;
  text-transform: uppercase;
}

.a-title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 400;
  color: #2A2846;
  line-height: 1.45;
  letter-spacing: 1rpx;
  margin-top: 10rpx;
}

.a-price {
  font-family: var(--font-serif);
  font-size: 52rpx;
  color: #372C57;
  letter-spacing: 1rpx;
  margin-top: 16rpx;
  line-height: 1.25;
}

.a-unit2 {
  font-size: 24rpx;
  color: #5F5C82;
}

.a-meta {
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #5F5C82;
  margin-top: 10rpx;
  letter-spacing: 0.4rpx;
}

/* Structured valuation and explicit local demo controls. */
.analysis-main { padding: 24rpx; padding-bottom: 80rpx; }
.demo-strip { padding: 26rpx; margin-bottom: 24rpx; border: 2rpx solid #AE7A38; border-radius: 24rpx; background: #FFF7E9; color: #69491F; }
.demo-title { font-size: 29rpx; font-weight: 700; }
.demo-copy { margin-top: 10rpx; font-size: 24rpx; line-height: 1.7; }
.demo-picker { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; padding: 18rpx 0; font-size: 26rpx; border-top: 1rpx solid #E8D5B7; }
.demo-picker text { font-weight: 700; }
.demo-link { margin-top: 10rpx; background: transparent; color: #69491F; font-size: 24rpx; line-height: 2; }
.demo-link::after { border-color: #D8B987; }
.valuation-actions { margin-bottom: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #FFFFFF; }
.valuation-actions-title, .export-heading { font-size: 31rpx; font-weight: 700; color: #372C57; }
.valuation-actions-copy, .export-description { margin: 12rpx 0 22rpx; font-size: 24rpx; line-height: 1.7; color: #6C6A8E; }
.valuation-button { width: 100%; background: #52467B; color: white; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 2.7; }
.valuation-button::after { border: 0; }
.valuation-button[disabled] { background: #D8D3E5; color: #6C6A8E; }
.form-readonly { text-align: right; color: #372C57; font-weight: 600; }
.readonly-note { display: block; color: #9490B2; font-weight: 400; font-size: 21rpx; }
.single-report-export { padding: 28rpx; margin-top: 28rpx; background: #EFECFA; border-radius: 24rpx; }
.load-error { padding: 40rpx 24rpx; color: #8A3F34; font-size: 27rpx; line-height: 1.7; }
.load-error .valuation-button { margin-top: 24rpx; }
.single-pdf-canvas { position: fixed; left: -9999px; top: 0; width: 750px; height: 1061px; pointer-events: none; }
