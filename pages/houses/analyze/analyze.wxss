.a-hero {
  background: linear-gradient(180deg, #0a1628 0%, #0f2244 50%, #1a3d8f 100%);
  padding: 40rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
}

.a-city {
  font-size: 24rpx;
  color: #8aa4cc;
}

.a-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.a-price {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.a-unit2 {
  font-size: 24rpx;
  font-weight: 400;
}

.a-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.bank {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.bank:last-child {
  border-bottom: none;
}

.bank-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8f0fe;
}

.bank-type {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.bank-call {
  color: #00d4ff;
  font-size: 26rpx;
  padding: 8rpx 26rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 40rpx;
}

.risk-line {
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #8aa4cc;
  line-height: 1.6;
}

.warn-tip {
  margin-top: 8rpx;
  background: rgba(255, 122, 69, 0.1);
  color: #ff9a6c;
  border: 1rpx solid rgba(255, 122, 69, 0.15);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.result-total {
  border-top: 1rpx solid rgba(0, 180, 255, 0.08);
  margin-top: 8rpx;
  padding-top: 16rpx;
}

.load-tip {
  text-align: center;
  padding: 60rpx;
  font-size: 26rpx;
  color: #5b7aa8;
}
