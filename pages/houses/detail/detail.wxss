.detail {
  padding-bottom: 40rpx;
}

.d-hero {
  background: linear-gradient(180deg, #0a1628 0%, #0f2244 50%, #1a3d8f 100%);
  padding: 40rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
}

.d-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.d-tags {
  margin-top: 16rpx;
}

.d-tag {
  display: inline-block;
  background: rgba(0, 180, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.d-price {
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.d-unit2 {
  font-size: 26rpx;
  font-weight: 400;
}

.d-unit {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.d-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}

.d-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.d-card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #2f6bff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.d-grid {
  display: flex;
  flex-wrap: wrap;
}

.d-cell {
  width: 33.33%;
  text-align: center;
  margin-bottom: 24rpx;
}

.d-cell-v {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8f0fe;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 8rpx;
}

.d-cell-k {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.d-row {
  display: flex;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #e8f0fe;
}

.d-k {
  width: 120rpx;
  flex-shrink: 0;
  color: #7b8fb0;
  font-size: 26rpx;
}

.d-v {
  flex: 1;
}

.d-tag-row {
  display: flex;
  flex-wrap: wrap;
}

.ld-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.ld-row:last-child {
  border-bottom: none;
}

.ld-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.ld-body {
  flex: 1;
}

.ld-title {
  font-size: 26rpx;
  color: #7b8fb0;
}

.ld-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #e8f0fe;
  line-height: 1.6;
}

.d-actions {
  margin-top: 32rpx;
}
