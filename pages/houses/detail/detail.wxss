/* 房源详情页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 圆点网格 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
    radial-gradient(circle at 90% 80%, rgba(124, 92, 252, 0.05) 0%, transparent 50%),
    radial-gradient(circle at 2px 2px, rgba(139, 92, 246, 0.15) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 40rpx 40rpx;
  z-index: 0;
  opacity: 0.4;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary, .btn-ghost {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.house-images {
  animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.house-header {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

.info-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.info-section:nth-child(1) { animation-delay: 0.3s; }
.info-section:nth-child(2) { animation-delay: 0.4s; }
.info-section:nth-child(3) { animation-delay: 0.5s; }
.info-section:nth-child(4) { animation-delay: 0.6s; }

.action-bar {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.7s backwards;
}

/* ==================== 点击效果 ==================== */

.house-images {
  transition: all 0.3s ease;
}

.house-images:active {
  transform: scale(0.98);
}

.house-header {
  transition: all 0.3s ease;
}

.house-header:active {
  transform: scale(0.98) translateY(4rpx);
}

.info-section {
  transition: all 0.3s ease;
}

.info-section:active {
  transform: scale(0.99);
}

.info-row {
  transition: all 0.3s ease;
}

.info-row:active {
  background: #F5F3FF;
  transform: translateX(6rpx);
  margin: 0 -12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.tag {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active {
  transform: scale(0.92) translateY(2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.3);
}

.image-indicator {
  transition: all 0.3s ease;
}

.image-indicator:active {
  transform: scale(0.95);
}

.phone-btn {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.phone-btn:active {
  transform: scale(0.92);
  background: #6D4EED;
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.5);
}

.analyze-btn {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.analyze-btn:active {
  transform: scale(0.92);
  background: #FFFFFF;
  color: #8B5CF6;
  border-color: #8B5CF6;
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.2);
}

/* ==================== 悬停效果 ==================== */

.house-images:hover {
  transform: scale(1.02);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.2);
}

.house-header:hover {
  transform: translateY(-4rpx) scale(1.01);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.info-section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15);
}

.info-row:hover {
  background: rgba(139, 92, 246, 0.06);
  transform: translateX(8rpx);
  color: #8B5CF6;
}

.tag:hover {
  transform: scale(1.08) translateY(-2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.4);
}

.image-indicator:hover {
  transform: scale(1.1);
  background: rgba(139, 92, 246, 0.9);
}

.phone-btn:hover {
  transform: translateY(-4rpx) scale(1.05);
  background: #9D7FFC;
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.6);
}

.analyze-btn:hover {
  transform: translateY(-4rpx) scale(1.05);
  background: #8B5CF6;
  color: #FFFFFF;
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.4);
}

