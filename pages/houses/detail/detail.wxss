/* Detail page: light cards with readable contrast and soft lavender accents. */
page { background:transparent; color:#eef2ff; padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }
.detail { padding-bottom: 40rpx; }
.d-hero { background: linear-gradient(135deg, #dce1ff 0%, #c8d1fa 100%); color: #303b66; border-radius: 0 0 30rpx 30rpx; padding: 36rpx 28rpx; box-shadow: 0 12rpx 26rpx rgba(105,116,200,.12); }
.d-title { color: #303b66; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.d-tag { background: #eef0ff; border: 1rpx solid #d5daf8; color: #5361bd; border-radius: 8rpx; padding: 4rpx 14rpx; font-size: 21rpx; margin-right: 10rpx; }
.d-price { margin-top: 22rpx; color: #695fc3; font-size: 50rpx; font-weight: 750; }
.d-unit2, .d-unit { color: #626e91; font-size: 24rpx; font-weight: 400; }
.d-unit { margin-top: 8rpx; }
.d-card { background: #fff; border: 1rpx solid #e1e4f7; border-radius: 20rpx; margin: 18rpx 24rpx; padding: 25rpx; box-shadow: 0 8rpx 22rpx rgba(119,127,185,.08); }
.d-card-title { color: #303b66; font-size: 29rpx; font-weight: 700; margin-bottom: 20rpx; }
.d-card-title::before { width: 7rpx; height: 28rpx; background: linear-gradient(180deg, #8994ed, #b29bef); margin-right: 12rpx; }
.d-cell { width: 33.33%; margin-bottom: 22rpx; }
.d-cell-v { color: #354269; font-size: 27rpx; font-weight: 650; }
.d-cell-k, .d-k, .ld-title { color: #68739a; font-size: 21rpx; }
.d-row { color: #354269; padding: 13rpx 0; }
.d-v, .ld-text { color: #354269; font-size: 26rpx; line-height: 1.55; }
.d-k { width: 112rpx; flex-shrink: 0; }
.ld-row { border-bottom: 1rpx solid #edf0fa; padding: 14rpx 0; }
.d-tag-row { gap: 10rpx; }
.d-card .tag { background: #f0f1ff; color: #5966c5; border: 1rpx solid #dfe2f7; border-radius: 10rpx; padding: 9rpx 14rpx; font-size: 22rpx; }
.d-actions { margin-top: 28rpx; }
.d-actions .btn-primary { margin: 18rpx 24rpx; }

/* Deep-space glass overrides */
page { background:transparent !important; color:#f6f3ff !important; }
.d-hero { background:linear-gradient(112deg,rgba(89,50,167,.88),rgba(42,99,178,.72)),url('../../images/bg-city.png') center/cover !important; color:#f7f4ff !important; border-radius:0 0 34rpx 34rpx !important; box-shadow:0 24rpx 54rpx rgba(4,2,22,.32) !important; }
.d-title { color:#f7f4ff !important; }
.d-tag { background:rgba(255,255,255,.10) !important; border-color:rgba(255,255,255,.22) !important; color:#e4d9ff !important; }
.d-unit2,.d-unit,.d-cell-k,.d-k,.ld-title { color:#aaa4cb !important; }
.d-card { background:rgba(255,255,255,.065) !important; border-color:rgba(255,255,255,.14) !important; box-shadow:0 24rpx 58rpx rgba(4,2,22,.28),inset 0 1rpx 0 rgba(255,255,255,.10) !important; border-radius:26rpx !important; }
.d-card-title,.d-cell-v,.d-v,.ld-text { color:#f7f4ff !important; }
.ld-row,.d-row { border-color:rgba(255,255,255,.10) !important; }
.d-card .tag { background:rgba(143,97,255,.15) !important; color:#d3c3ff !important; border-color:rgba(187,159,255,.32) !important; }
