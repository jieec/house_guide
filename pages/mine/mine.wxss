.mine-hero {
  background: linear-gradient(160deg, #1a3d8f 0%, #2f6bff 100%);
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}

.mine-name {
  font-size: 36rpx;
  font-weight: 700;
}

.mine-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.loc-line {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
}

.loc-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a93a6;
}

.loc-empty {
  font-size: 26rpx;
  color: #b0b8cc;
}

.record {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f8;
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-place {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.record-del {
  font-size: 24rpx;
  color: #ff4d3a;
}

.record-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5a6478;
}

.record-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b0b8cc;
}

.rec-empty {
  font-size: 26rpx;
  color: #b0b8cc;
  padding: 20rpx 0;
}
