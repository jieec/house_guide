page { background: #080d24; color: #eef2ff; padding-bottom: calc(43px + env(safe-area-inset-bottom)); }
.mine-hero { background: linear-gradient(180deg, #0d1330 0%, #151e46 55%, #29266c 100%); }
.avatar { background: rgba(98,84,232,.2); border-color: rgba(112,221,255,.3); }
.mine-sub, .record-line { color: #a8b2d6; }
page .card { background: #111936; border-color: rgba(139,125,255,.18); box-shadow: 0 8rpx 22rpx rgba(2,5,22,.22); }
page .btn-ghost { color: #70ddff; border-color: rgba(112,221,255,.4); }
.mine-hero { background: linear-gradient(180deg,#0a1628 0%,#0f2244 50%,#1a3d8f 100%); padding:48rpx 40rpx; display:flex; align-items:center; color:#fff; border-radius:0 0 40rpx 40rpx; margin-bottom:24rpx; }.avatar { width:108rpx; height:108rpx; background:rgba(0,180,255,.15); border:2rpx solid rgba(0,212,255,.3); border-radius:32rpx; display:flex; align-items:center; justify-content:center; font-size:52rpx; margin-right:24rpx; }.mine-name { font-size:36rpx; font-weight:700; }.mine-sub { margin-top:8rpx; font-size:24rpx; color:#b5c9e5; }
.loc-line { font-size:30rpx; font-weight:600; color:#fff; }.loc-line2 { margin-top:8rpx; font-size:24rpx; color:#a9bddb; }.loc-empty,.rec-empty { font-size:26rpx; color:#9db4d4; }.record { padding:20rpx 0; border-bottom:1rpx solid rgba(0,180,255,.14); }.record:last-child { border-bottom:none; }.record-head { display:flex; justify-content:space-between; align-items:center; }.record-place { font-size:28rpx; font-weight:600; color:#fff; }.record-del { font-size:24rpx; color:#ff9a6c; }.record-line { margin-top:8rpx; font-size:24rpx; color:#b5c9e5; }.record-time { margin-top:6rpx; font-size:22rpx; color:#8fa8ca; }.rec-empty { padding:20rpx 0; }
page { background: #f5f6ff !important; color: #34406f !important; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)) !important; }
.mine-hero { background: linear-gradient(135deg,#dce1ff,#c8d1fa) !important; color:#303b66 !important; border-radius:0 0 30rpx 30rpx !important; box-shadow:0 12rpx 26rpx rgba(105,116,200,.12); }
.mine-name, page .card-title, .record-place, .loc-line { color:#303b66 !important; }
.mine-sub, .record-line, .record-time, .loc-line2, .loc-empty, .rec-empty { color:#626e91 !important; }
page .card { background:#fff !important; border-color:#e1e4f7 !important; box-shadow:0 8rpx 22rpx rgba(119,127,185,.08) !important; }
page .btn-ghost { color:#5866c8 !important; border-color:#cbd1f2 !important; }
.record { border-color:#edf0fa !important; }
