.mine-hero {
  background: linear-gradient(180deg, #0a1628 0%, #0f2244 50%, #1a3d8f 100%);
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  background: rgba(0, 180, 255, 0.15);
  border: 2rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}

.mine-name {
  font-size: 36rpx;
  font-weight: 700;
}

.mine-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8aa4cc;
}

.loc-line {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.loc-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.loc-empty {
  font-size: 26rpx;
  color: #5b7aa8;
}

.record {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-place {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.record-del {
  font-size: 24rpx;
  color: #ff6b35;
}

.record-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.record-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b7aa8;
}

.rec-empty {
  font-size: 26rpx;
  color: #5b7aa8;
  padding: 20rpx 0;
}
