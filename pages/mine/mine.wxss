/* Habo 绿色主题 - 我的评估页 */

.mine-layout {
  min-height: 100vh;
  background: #F6F5FC;
  position: relative;
  z-index: 1;
}

.mine-main {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 英雄区 - 增加圆角和阴影 */
.mine-hero {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(55, 44, 87, 0.08);
  margin-bottom: 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.mine-hero:active {
  box-shadow: 0 8rpx 20rpx rgba(55, 44, 87, 0.12);
  transform: translateY(-2rpx);
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E7E3F6 0%, #EFECFA 100%);
  color: #52467B;
  font-size: 28rpx;
  flex-shrink: 0;
  position: relative;
}

.avatar-icon {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-icon .ic {
  width: 30rpx;
  height: 30rpx;
}

.avatar-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  background: rgba(82, 70, 123, 0.1);
  animation: pulse-glow 2s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.mine-info {
  flex: 1;
  min-width: 0;
}

.mine-name {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.mine-sub {
  color: #4C4A6E;
  font-size: 26rpx;
  margin-top: 4rpx;
  display: block;
}

/* 定位信息 */
.loc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #EBE8F7;
}

.loc-item:last-child {
  border-bottom: 0;
}

.loc-label {
  color: #4C4A6E;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  width: 80rpx;
}

.loc-value {
  color: #2A2846;
  font-size: 28rpx;
  flex: 1;
  text-align: right;
}

.loc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  text-align: center;
}

.loc-empty .empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.loc-empty .empty-text {
  color: #4C4A6E;
  font-size: 28rpx;
  font-weight: 600;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-item {
  padding: 16rpx;
  background: #F6F5FC;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
}

.record-item:active {
  border-color: #C1BAD9;
  background: #F1EFFA;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.record-name {
  color: #2A2846;
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.record-badge {
  padding: 4rpx 12rpx;
  background: #52467B;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.record-info {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.record-info-item {
  color: #4C4A6E;
  font-size: 24rpx;
}

.record-del {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  color: #9490B2;
  font-size: 24rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.record-item:active .record-del {
  color: #A94D58;
  transform: scale(1.2);
}

.rec-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  text-align: center;
}

.rec-empty .empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.rec-empty .empty-text {
  color: #4C4A6E;
  font-size: 28rpx;
  font-weight: 600;
}

.rec-empty .empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  margin-top: 4rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}

/* 菜单区 */
.menu-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(55, 44, 87, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(55, 44, 87, 0.12);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.menu-item:active .menu-icon {
  transform: scale(1.1);
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #2A2846;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-desc {
  color: #4C4A6E;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.menu-arrow {
  color: #9490B2;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.menu-item:active .menu-arrow {
  color: #52467B;
  transform: translateX(4rpx);
}

/* 动画 */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cell:active .cell-icon {
  transform: scale(1.1);
}

.cell-icon .ic {
  width: 24rpx;
  height: 24rpx;
}

.cell-icon-danger {
  background: #FDF1F2;
  color: #A94D58;
}

.cell-icon-info {
  background: #F1EFFA;
  color: #52467B;
}

/* ==================== 位置线 ==================== */

.loc-line,
.loc-line2,
.loc-empty {
  color: #4C4A6E;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.loc-line {
  color: #2A2846;
  font-weight: 600;
}

.loc-line2 {
  color: #9490B2;
  font-size: 24rpx;
}

.loc-empty {
  color: #C9C3DC;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
}

/* ==================== 背景装饰 ==================== */

.bg-orb {
  position: fixed;
  border-radius: 50%;
  opacity: 0.05;
  pointer-events: none;
  z-index: 0;
}

.orb-1 {
  width: 300rpx;
  height: 300rpx;
  background: #E7E3F6;
  top: 10%;
  left: -100rpx;
}

.orb-2 {
  width: 200rpx;
  height: 200rpx;
  background: #E7E3F6;
  bottom: 20%;
  right: -50rpx;
}

.orb-3 {
  width: 250rpx;
  height: 250rpx;
  background: #E7E3F6;
  top: 50%;
  right: 10%;
}

/* ==================== 登记记录 ==================== */

.record {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EBE8F7;
}

.record:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-place {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: #2A2846;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-line {
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #5F5C82;
  margin-top: 8rpx;
  letter-spacing: 0.3rpx;
  line-height: 1.7;
}

.record-time {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #9490B2;
  margin-top: 6rpx;
}
