<view class="mine-hero">
  <view class="avatar">🏠</view>
  <view class="mine-info">
    <view class="mine-name">我的购房评估</view>
    <view class="mine-sub" wx:if="{{user && user.phoneMasked}}">已绑定 {{user.phoneMasked}}</view>
    <view class="mine-sub" wx:else>记录你的选房与测算进度</view>
  </view>
</view>

<view class="card">
  <view class="card-title">当前定位</view>
  <block wx:if="{{location && location.city}}">
    <view class="loc-line">{{location.province}} {{location.city}} {{location.district}}</view>
    <view class="loc-line2">{{location.estate}} {{location.buildingCount}}栋 {{location.community}}</view>
  </block>
  <view wx:else class="loc-empty">尚未选择定位</view>
  <view class="btn-ghost" bindtap="goLocation">选择/修改定位</view>
</view>

<view class="card">
  <view class="card-title">登记记录</view>
  <view class="record" wx:for="{{records}}" wx:key="id">
    <view class="record-head">
      <view class="record-place">{{item.estate || item.place}}</view>
      <view class="record-del" data-id="{{item.id}}" catchtap="removeRecord">删除</view>
    </view>
    <view class="record-line">{{item.purpose}} · 差额{{item.gap}}元 · {{item.grade}}档</view>
    <view class="record-time">{{item.time}}</view>
  </view>
  <view wx:if="{{!records.length}}" class="rec-empty">暂无登记记录，去「评估结论」页测算登记</view>
</view>

<view class="cell" bindtap="clearAll">
  <view class="cell-left">
    <view class="cell-icon" style="background:#ffecec">🗑️</view>
    <view class="cell-name">清除本地数据</view>
  </view>
  <view class="cell-arrow">›</view>
</view>

<view class="cell" bindtap="about">
  <view class="cell-left">
    <view class="cell-icon" style="background:#eef4ff">ℹ️</view>
    <view class="cell-name">关于</view>
  </view>
  <view class="cell-arrow">›</view>
</view>
