.bank {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.bank:last-child {
  border-bottom: none;
}

.bank-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8f0fe;
}

.bank-type {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.bank-call {
  color: #d7c8ff !important;
  font-size: 28rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(186,162,255,.48) !important;
  border-radius: 999rpx;
  background:rgba(255,255,255,.065);
}

/* Deep-space glass overrides */
page { background:transparent !important; color:#f6f3ff !important; }
.bank { border-color:rgba(255,255,255,.10) !important; }
.bank-name { color:#f7f4ff !important; }
.bank-type { color:#aaa4cb !important; }
