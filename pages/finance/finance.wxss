/* 页面基础 */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.finance-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.finance-main {
  padding: 24rpx;
}

/* ==================== 动画 ==================== */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.form-row:active {
  background: #E8E5F5;
  transform: scale(0.98);
}

/* ==================== 银行列表 ==================== */

.bank {
  background: #FFFFFF;
  border: 2rpx solid #E8E5F5;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.bank:active {
  background: #F1EFFA;
  border-color: #C1BAD9;
  transform: translateX(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(82, 70, 123, 0.15);
}

.bank-info {
  flex: 1;
}

.bank-name {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.bank-rate {
  color: #4C4A6E;
  font-size: 24rpx;
}

.bank-call {
  background: #E7E3F6;
  color: #52467B;
  border: none;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  flex-shrink: 0;
  cursor: pointer;
}

.bank-call:active {
  background: rgba(82, 70, 123, 0.2);
  transform: scale(0.95);
}

.result-total {
  background: rgba(82, 70, 123, 0.08);
  margin: 12rpx -20rpx -20rpx;
  padding: 16rpx 20rpx;
  border-radius: 0 0 20rpx 20rpx;
}

.result-total .result-label,
.result-total .result-num {
  font-weight: 700;
}

.result-total .result-num {
  color: #372C57;
  font-size: 36rpx;
}

/* ==================== 区块 · data-grid ==================== */

.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin: 16rpx 0;
}

.data-item {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 16rpx;
  text-align: center;
}

.data-value {
  color: #52467B;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.data-label {
  color: #4C4A6E;
  font-size: 24rpx;
  font-weight: 500;
}

.warn-tip.error {
  background: rgba(244, 67, 54, 0.1);
  border-left-color: #A94D58;
  color: #A94D58;
}

.success-tip {
  background: rgba(82, 70, 123, 0.1);
  border-left: 4rpx solid #C1BAD9;
  border-radius: 12rpx;
  padding: 16rpx;
  color: #52467B;
  font-size: 26rpx;
  margin: 16rpx 0;
}

/* ==================== 区块 · chart-container ==================== */

.chart-container {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  position: relative;
  height: 300rpx;
}

.chart-title {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* ==================== 区块 · item-list ==================== */

.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-item-left {
  flex: 1;
}

.list-item-value {
  color: #52467B;
  font-size: 28rpx;
  font-weight: 700;
}

/* ==================== 空状态 ==================== */

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}
