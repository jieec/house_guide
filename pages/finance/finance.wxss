.bank {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.bank:last-child {
  border-bottom: none;
}

.bank-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8f0fe;
}

.bank-type {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8fb0;
}

.bank-call {
  color: #00d4ff;
  font-size: 28rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 40rpx;
}
