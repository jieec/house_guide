/* 分析页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 对角线条纹 */
page::before {
  content: '';
  position: fixed;
  top: -100rpx;
  left: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: linear-gradient(
    45deg,
    transparent 40%,
    rgba(139, 92, 246, 0.04) 40%,
    rgba(139, 92, 246, 0.04) 60%,
    transparent 60%
  );
  background-size: 80rpx 80rpx;
  z-index: 0;
  opacity: 0.5;
}

page::after {
  content: '';
  position: fixed;
  bottom: -150rpx;
  right: -150rpx;
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle, rgba(124, 92, 252, 0.08) 0%, transparent 60%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary, .btn-ghost {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.auto-banner {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.form-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.form-section:nth-child(1) { animation-delay: 0.2s; }
.form-section:nth-child(2) { animation-delay: 0.3s; }
.form-section:nth-child(3) { animation-delay: 0.4s; }
.form-section:nth-child(4) { animation-delay: 0.5s; }

.result-card {
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s backwards;
}

/* ==================== 点击效果 ==================== */

.auto-banner {
  transition: all 0.3s ease;
}

.auto-banner:active {
  transform: scale(0.98);
  background: rgba(139, 92, 246, 0.08);
}

.picker-arrow {
  transition: all 0.3s ease;
  display: inline-block;
}

.form-input-wrap:active .picker-arrow {
  transform: scale(1.3) rotate(180deg);
  color: #8B5CF6;
}

