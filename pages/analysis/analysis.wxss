page { background:transparent !important; color:#f6f3ff !important; padding-bottom:calc(148rpx + env(safe-area-inset-bottom)) !important; }
page .card { background:rgba(255,255,255,.065) !important; border-color:rgba(255,255,255,.14) !important; box-shadow:0 24rpx 58rpx rgba(4,2,22,.28),inset 0 1rpx 0 rgba(255,255,255,.10) !important; border-radius:26rpx !important; }
.auto-banner { background:rgba(76,219,178,.10) !important; border-color:rgba(105,230,190,.24) !important; color:#9af0ce !important; }
.result-num { font-size:34rpx; color:#79ddff !important; }
.card-title,.form-label,.result-label,.city-view { color:#f7f4ff !important; }
.card-sub,.search-tip,.result-sub { color:#aaa4cb !important; }
.search-box { background:rgba(9,7,33,.34) !important; border-color:rgba(178,151,255,.24) !important; }
.result-item { border-color:rgba(255,255,255,.10) !important; }
.result-name { color:#f7f4ff !important; }
.result-sub { color:#aaa4cb !important; }
.form-input,.form-input-wrap { background:rgba(9,7,33,.34) !important; color:#f6f3ff !important; border-color:rgba(178,151,255,.24) !important; }