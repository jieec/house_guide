/* 页面基础 */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.tax-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.tax-main {
  padding: 24rpx;
}

/* ==================== 动画 ==================== */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ==================== 区块 · type-tabs ==================== */

.type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.type-tab {
  flex: 1;
  padding: 14rpx 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5F5;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4C4A6E;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.type-tab.active {
  background: #52467B;
  border-color: #C1BAD9;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(82, 70, 123, 0.3);
}

.type-tab:active {
  transform: scale(0.96);
}

.form-row:active {
  background: #E8E5F5;
  transform: scale(0.98);
}

/* ==================== 区块 · toggle ==================== */

.toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #F1EFFA;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.toggle:active {
  background: #E8E5F5;
  transform: scale(0.98);
}

.toggle-label {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.toggle-switch {
  width: 52rpx;
  height: 32rpx;
  background: #E8E5F5;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.toggle.active .toggle-switch {
  background: #9A8FC6;
}

.toggle-dot {
  width: 28rpx;
  height: 28rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  transition: all 0.3s ease;
}

.toggle.active .toggle-dot {
  left: 22rpx;
}

/* ==================== 结果分区 ==================== */

/* ==================== 区块 · result-row ==================== */

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E8E5F5;
  transition: all 0.3s ease;
}

.result-row:last-child {
  border-bottom: none;
}

/* ==================== 区块 · tax-breakdown ==================== */

.tax-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tax-item {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
}

.tax-item:active {
  background: #E8E5F5;
  transform: translateX(4rpx);
}

.tax-item-left {
  flex: 1;
}

.tax-item-title {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
}

.tax-item-desc {
  color: #6C6A8E;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.tax-item-value {
  color: #52467B;
  font-size: 28rpx;
  font-weight: 700;
}

/* ==================== 提示 ==================== */

.tips {
  background: rgba(82, 70, 123, 0.1);
  border-left: 4rpx solid #C1BAD9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
  color: #52467B;
  transition: all 0.3s ease;
}

.tips:active {
  background: rgba(82, 70, 123, 0.15);
  transform: translateX(4rpx);
}

.tips.warning {
  background: rgba(255, 152, 0, 0.1);
  border-left-color: #C08A55;
  color: #C08A55;
}

.tips.error {
  background: rgba(244, 67, 54, 0.1);
  border-left-color: #A94D58;
  color: #A94D58;
}

/* ==================== 区块 · data-grid ==================== */

.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin: 16rpx 0;
}

.data-item {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 16rpx;
  text-align: center;
}

.data-value {
  color: #52467B;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.data-label {
  color: #4C4A6E;
  font-size: 24rpx;
  font-weight: 500;
}

/* ==================== 空状态 ==================== */

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}
