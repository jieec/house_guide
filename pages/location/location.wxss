/* 位置页面 - 柔和紫色风格 + 超级惊艳动效 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 网格图案 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  background: 
    linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px),
    linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px);
  background-size: 60rpx 60rpx;
  mask-image: linear-gradient(180deg, black 0%, transparent 100%);
  z-index: 0;
}

page::after {
  content: '';
  position: fixed;
  top: 100rpx;
  right: -200rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(124, 92, 252, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.step-card, .card, .btn-primary, .btn-ghost {
  position: relative;
  z-index: 1;
}

/* 入场动画 */
@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(60rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.locate-bar {
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
  border: 0;
  margin: 24rpx;
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  color: #2D2D3A;
  text-align: center;
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15),
              0rpx 4rpx 16rpx rgba(124, 92, 252, 0.1);
  position: relative;
  overflow: hidden;
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ==================== 悬停效果 ==================== */

.locate-bar:hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.25),
              0rpx 8rpx 24rpx rgba(124, 92, 252, 0.15);
}

.locate-btn:hover {
  transform: scale(1.05);
  text-shadow: 0rpx 4rpx 12rpx rgba(139, 92, 246, 0.3);
}

.locate-hint:hover {
  transform: scale(1.02);
  color: #8B5CF6;
}

.card:hover {
  transform: translateY(-8rpx);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.2),
              0rpx 8rpx 24rpx rgba(124, 92, 252, 0.12);
}

.card-title:hover {
  transform: translateX(8rpx) scale(1.05);
  color: #8B5CF6;
}

.form-row:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.05);
}

.form-label:hover {
  transform: scale(1.05);
  color: #8B5CF6;
}

.form-input-wrap:hover {
  transform: translateY(-2rpx);
  border-color: #8B5CF6;
  background: #FFFFFF;
  box-shadow: 0rpx 0rpx 0rpx 6rpx rgba(139, 92, 246, 0.1),
              0rpx 8rpx 20rpx rgba(124, 92, 252, 0.15);
}

.form-input-wrap:hover .picker-arrow {
  transform: scale(1.2) translateY(-2rpx);
  color: #8B5CF6;
}

.form-input:hover {
  transform: translateY(-2rpx);
  background: rgba(139, 92, 246, 0.05);
  box-shadow: 0rpx 4rpx 12rpx rgba(124, 92, 252, 0.1);
}

.preview:hover {
  transform: scale(1.05) translateX(8rpx);
  color: #8B5CF6;
}

.preview-sub:hover {
  transform: scale(1.02);
  color: #8B5CF6;
}

/* ==================== 点击效果 ==================== */

.locate-bar:active {
  transform: scale(0.97) translateY(4rpx);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.12);
}

.locate-btn:active {
  transform: scale(0.95);
  filter: brightness(1.1);
}

.locate-hint:active {
  transform: scale(0.98);
  color: #8B5CF6;
}

.card:active {
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.18);
}

.card-title:active {
  transform: scale(1.05) translateX(12rpx);
  color: #7C5CFC;
}

.form-row:active {
  transform: translateX(12rpx) scale(0.99);
  background: rgba(139, 92, 246, 0.08);
}

.form-label:active {
  transform: scale(1.08);
  color: #7C5CFC;
}

.form-input-wrap:active {
  transform: scale(0.98);
  border-color: #7C5CFC;
  background: #F5F3FF;
  box-shadow: 0rpx 0rpx 0rpx 8rpx rgba(139, 92, 246, 0.15);
}

.form-input-wrap:active .picker-arrow {
  transform: scale(1.4) rotate(180deg);
  color: #7C5CFC;
}

.form-input:active {
  transform: scale(1.02);
  background: rgba(139, 92, 246, 0.08);
  box-shadow: 0rpx 0rpx 0rpx 6rpx rgba(139, 92, 246, 0.1);
}

.preview:active {
  transform: scale(1.08) translateX(12rpx) rotate(-1deg);
  color: #7C5CFC;
}

.preview-sub:active {
  transform: scale(1.05);
  color: #7C5CFC;
}

.locate-bar::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
}

.locate-btn {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  z-index: 1;
}

.locate-btn.locating {
  opacity: 0.7;
}

.locate-hint {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8B8B9A;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

.preview {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: #2D2D3A;
  position: relative;
  z-index: 1;
}

.preview-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #8B8B9A;
  position: relative;
  z-index: 1;
}

/* 表单行动画 */
.form-row {
  animation: fadeInScale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.form-row:nth-child(1) { animation-delay: 0.1s; }
.form-row:nth-child(2) { animation-delay: 0.2s; }
.form-row:nth-child(3) { animation-delay: 0.3s; }
.form-row:nth-child(4) { animation-delay: 0.4s; }
.form-row:nth-child(5) { animation-delay: 0.5s; }
.form-row:nth-child(n+6) { animation-delay: 0.6s; }
