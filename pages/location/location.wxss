/* Habo 绿色主题 - 位置选择页 */

.location-layout {
  min-height: 100vh;
  background: #F6F5FC;
}

.location-main {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* GPS定位卡片 */
.gps-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(55, 44, 87, 0.08);
  margin-bottom: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.gps-card:active {
  box-shadow: 0 8rpx 20rpx rgba(55, 44, 87, 0.12);
  transform: translateY(-2rpx);
}

.gps-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.gps-content {
  flex: 1;
  min-width: 0;
}

.gps-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 600;
}

.gps-desc {
  color: #4C4A6E;
  font-size: 26rpx;
  margin-top: 4rpx;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 选择器 */
.picker-input {
  padding: 12rpx 16rpx;
  border: 2rpx solid #EBE8F7;
  border-radius: 20rpx;
  background: #FFFFFF;
  transition: all 0.3s ease;
}

.picker-input:active {
  border-color: #C1BAD9;
  box-shadow: 0 0 0 4rpx rgba(82, 70, 123, 0.1);
}

.picker-display {
  color: #2A2846;
  font-size: 30rpx;
  padding: 12rpx 0;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
}

.button-primary.loading {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* ==================== 定位条 ==================== */

.locate-bar {
  margin-bottom: 20rpx;
}

.locate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #625A9A 0%, #52467B 100%);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 30rpx rgba(82, 70, 123, 0.22);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.locate-btn:active {
  transform: scale(0.98);
}

.locate-btn.locating {
  opacity: 0.72;
}

.locate-hint {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #6B6890;
  text-align: center;
  margin-top: 12rpx;
  letter-spacing: 0.4rpx;
}

/* ==================== 预览 ==================== */

.preview {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: #2A2846;
  letter-spacing: 0.5rpx;
  line-height: 1.6;
}

.preview-sub {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #6B6890;
  margin-top: 6rpx;
  letter-spacing: 0.3rpx;
}
