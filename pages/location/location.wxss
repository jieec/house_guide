.locate-bar {
  background: linear-gradient(135deg, #0f2244 0%, #1a3d8f 100%);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 50, 120, 0.4);
}

.locate-btn {
  font-size: 34rpx;
  font-weight: 700;
}

.locate-btn.locating {
  opacity: 0.7;
}

.locate-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8aa4cc;
}

.preview {
  font-size: 32rpx;
  font-weight: 600;
  color: #00d4ff;
}

.preview-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7b8fb0;
}
