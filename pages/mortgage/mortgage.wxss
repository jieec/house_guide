.result-num {
  font-size: 34rpx;
}
page::after { content:'LOAN / CALCULATOR'; position:fixed; z-index:-1; right:12rpx; top:240rpx; color:rgba(104,224,255,.28); font-size:15rpx; letter-spacing:3rpx; transform:rotate(90deg); }

page { background:transparent !important; color:#f6f3ff !important; }
