/* 页面基础 */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.mortgage-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.mortgage-main {
  padding: 24rpx;
}

/* ==================== 动画 ==================== */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ==================== 区块 · loan-type-tabs ==================== */

.loan-type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.loan-type-tab {
  flex: 1;
  padding: 14rpx 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5F5;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4C4A6E;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.loan-type-tab.active {
  background: #52467B;
  border-color: #C1BAD9;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(82, 70, 123, 0.3);
}

.loan-type-tab:active {
  transform: scale(0.96);
}

.form-row:active {
  background: #E8E5F5;
  transform: scale(0.98);
}

/* ==================== 结果分区 ==================== */

/* ==================== 区块 · data-grid ==================== */

.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin: 16rpx 0;
}

.data-item {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 16rpx;
  text-align: center;
}

.data-value {
  color: #52467B;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.data-label {
  color: #4C4A6E;
  font-size: 24rpx;
  font-weight: 500;
}

/* ==================== 提示 ==================== */

.tips {
  background: rgba(82, 70, 123, 0.1);
  border-left: 4rpx solid #C1BAD9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
  color: #52467B;
  transition: all 0.3s ease;
}

.tips:active {
  background: rgba(82, 70, 123, 0.15);
  transform: translateX(4rpx);
}

.tips.warning {
  background: rgba(255, 152, 0, 0.1);
  border-left-color: #C08A55;
  color: #C08A55;
}

/* ==================== 区块 · item-list ==================== */

.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-item-left {
  flex: 1;
}

.list-item-value {
  color: #52467B;
  font-size: 28rpx;
  font-weight: 700;
}

/* ==================== 区块 · chart-container ==================== */

.chart-container {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  position: relative;
  height: 300rpx;
}

.chart-title {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* ==================== 空状态 ==================== */

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}

/* ==================== 测算结果 ==================== */

.results-container {
  margin-top: 28rpx;
}

.input-summary {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F6F5FC;
  border: 1rpx solid #EBE8F7;
  margin-bottom: 24rpx;
}

.summary-title {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #5F5C82;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  min-width: 0;
}

.summary-label {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6B6890;
  letter-spacing: 0.3rpx;
}

.summary-value {
  font-size: 27rpx;
  font-weight: 600;
  color: #2A2846;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-section {
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
  margin-bottom: 20rpx;
}

.result-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.result-title-icon {
  color: #695C93;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.result-title-icon .ic {
  width: 28rpx;
  height: 28rpx;
}

.result-title-text {
  font-size: 29rpx;
  font-weight: 700;
  color: #372C57;
  letter-spacing: 0.5rpx;
}

.result-title-badge {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #EFECFA;
  color: #52467B;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  flex: 0 0 auto;
}

.result-desc {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #6B6890;
  line-height: 1.7;
  letter-spacing: 0.3rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #EBE8F7;
}

.result-detail-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
}

.result-detail-label {
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #5F5C82;
  letter-spacing: 0.3rpx;
}

.result-detail-value {
  font-family: var(--font-serif);
  font-size: 26rpx;
  color: #2A2846;
  flex: 0 0 auto;
}
