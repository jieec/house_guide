/* 贷款页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 点阵图案 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle, rgba(139, 92, 246, 0.08) 2rpx, transparent 2rpx);
  background-size: 100rpx 100rpx;
  mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  z-index: 0;
}

page::after {
  content: '';
  position: fixed;
  bottom: -200rpx;
  left: 50%;
  margin-left: -300rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(124, 92, 252, 0.12) 0%, transparent 65%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary, canvas {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.loan-type-tabs {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

.form-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.form-section:nth-child(1) { animation-delay: 0.2s; }
.form-section:nth-child(2) { animation-delay: 0.3s; }
.form-section:nth-child(3) { animation-delay: 0.4s; }

.result-panel {
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s backwards;
}

.payment-plan {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s backwards;
}

/* ==================== 点击效果 ==================== */

.loan-type-tab {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.loan-type-tab:active {
  transform: scale(0.92) translateY(2rpx);
  background: rgba(139, 92, 246, 0.1);
  border-color: #8B5CF6;
}

.result-line {
  transition: all 0.3s ease;
}

.result-line:active {
  background: #F5F3FF;
  transform: translateX(6rpx);
  margin: 0 -12rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
}

.form-picker {
  transition: all 0.3s ease;
}

.form-picker:active {
  background: #F5F3FF;
  border-color: #8B5CF6;
  transform: scale(0.99);
}

.picker-arrow {
  transition: all 0.3s ease;
  display: inline-block;
}

.form-picker:active .picker-arrow {
  transform: scale(1.3) rotate(180deg);
  color: #8B5CF6;
}

/* 通用样式继承自全局 app.wxss */

/* ==================== 结果容器 ==================== */

/* ==================== 输入摘要 ==================== */

.input-summary {
  margin: 32rpx 24rpx 0;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(124, 92, 252, 0.05) 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(139, 92, 246, 0.15);
  animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.summary-title {
  color: #8B5CF6;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.summary-title::before {
  content: '📋';
  font-size: 32rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-label {
  color: #64748B;
  font-size: 24rpx;
  font-weight: 500;
}

.summary-value {
  color: #2D2D3A;
  font-size: 28rpx;
  font-weight: 600;
}

/* ==================== 结果容器 ==================== */

.results-container {
  margin: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.9) 100%);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15),
              0rpx 4rpx 16rpx rgba(124, 92, 252, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.result-section:nth-child(1) { animation-delay: 0.1s; }
.result-section:nth-child(2) { animation-delay: 0.2s; }
.result-section:nth-child(3) { animation-delay: 0.3s; }

.result-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(139, 92, 246, 0.1);
}

.result-title-icon {
  font-size: 40rpx;
  line-height: 1;
}

.result-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D3A;
  flex: 1;
}

.result-title-badge {
  font-size: 22rpx;
  color: #8B5CF6;
  background: rgba(139, 92, 246, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.result-highlight {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.25),
              inset 0rpx -2rpx 8rpx rgba(0, 0, 0, 0.1),
              inset 0rpx 2rpx 8rpx rgba(255, 255, 255, 0.3);
}

.result-highlight-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.result-highlight-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0rpx 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.result-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.08);
  transition: all 0.3s ease;
}

.result-line:last-of-type {
  border-bottom: none;
}

.result-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.result-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2D3A;
}

.result-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.result-detail-label {
  color: #666;
  font-weight: 500;
}

.result-detail-value {
  color: #8B5CF6;
  font-weight: 600;
}

.result-desc {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(139, 92, 246, 0.08);
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
