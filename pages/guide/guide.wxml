<view class="page">
  <view class="query-card">
    <view class="query-title">选择位置和小区</view>
    <view class="location-row" bindtap="goLocation">
      <view>
        <view class="location-label">当前位置</view>
        <view class="location-value" wx:if="{{location && location.city}}">{{location.province}} {{location.city}} {{location.district}}</view>
        <view class="location-empty" wx:else>请先选择省 / 市 / 区</view>
      </view>
      <view class="change">修改 ›</view>
    </view>
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input class="search-input" value="{{keyword}}" placeholder="输入小区名称" bindinput="onKeyword" />
      <text class="searching" wx:if="{{searching}}">查询中</text>
    </view>
    <view class="search-results" wx:if="{{searchResults.length}}">
      <view class="search-item" wx:for="{{searchResults}}" wx:key="_id" data-index="{{index}}" bindtap="pickCommunity">
        <view class="search-name">{{item.community}}</view>
        <view class="search-address">{{item.displayAddress}}</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!selectedCommunity && !loading}}">
    <view class="empty-icon">⌂</view>
    <view class="empty-title">选择小区后自动生成分析</view>
    <view class="empty-text">页面只读取后台爬取的数据，不需要用户逐项填写。</view>
  </view>

  <block wx:if="{{selectedCommunity || loading}}">
    <view class="report-head">
      <view>
        <view class="report-name">{{selectedCommunity.community}}</view>
        <view class="report-meta">{{dataStatus}} · 更新 {{updatedAt}}</view>
      </view>
      <view class="reload" bindtap="reloadReport">刷新</view>
    </view>
    <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <view class="tab {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-index="{{index}}" bindtap="switchTab">{{item}}</view>
      </view>
    </scroll-view>
    <view class="loading" wx:if="{{loading}}">正在汇总小区、房源和政策数据…</view>

    <block wx:if="{{!loading}}">
      <view wx:if="{{activeTab === 0}}">
        <view class="section-title">楼盘信息</view>
        <view class="data-card">
          <view class="data-row" wx:for="{{report.basic}}" wx:key="label">
            <view class="data-label">{{item.label}}</view>
            <view class="data-value {{item.value === '暂无数据' ? 'muted' : ''}}">{{item.value}}</view>
          </view>
        </view>
        <view class="section-title" wx:if="{{report.areaRangeText}}">面积段分布</view>
        <view class="data-card" wx:if="{{report.areaRangeText}}">
          <view class="data-value">{{report.areaRangeText}}</view>
        </view>
        <view class="section-title" wx:if="{{report.layoutText}}">户型分布</view>
        <view class="data-card" wx:if="{{report.layoutText}}">
          <view class="data-value">{{report.layoutText}}</view>
        </view>
        <view class="section-title">位置配套</view>
        <view class="data-card">
          <view class="sub-title">交通</view>
          <view class="tags" wx:if="{{report.traffic.length}}"><text class="tag" wx:for="{{report.traffic}}" wx:key="*this">{{item}}</text></view>
          <view class="no-data" wx:else>后台暂无交通配套数据</view>
          <view class="divider"></view>
          <view class="sub-title">教育</view>
          <view class="tags" wx:if="{{report.schools.length}}"><text class="tag blue" wx:for="{{report.schools}}" wx:key="*this">{{item}}</text></view>
          <view class="no-data" wx:else>后台暂无教育配套数据</view>
        </view>
        <view class="section-title">竞品分析</view>
        <view class="data-card">
          <view class="competitor" wx:for="{{report.competitors}}" wx:key="name">
            <view><view class="competitor-name">{{item.name}}</view><view class="competitor-meta">{{item.meta}}</view></view>
            <view class="competitor-price">{{item.value}}</view>
          </view>
          <view class="no-data" wx:if="{{!report.competitors.length}}">后台暂无周边竞品数据</view>
        </view>
      </view>

      <view wx:if="{{activeTab === 1}}">
        <view class="section-title">价值分析</view>
        <view class="price-grid">
          <view class="price-card" wx:for="{{report.prices}}" wx:key="label">
            <view class="price-label">{{item.label}}</view>
            <view class="price-value {{item.value === '暂无数据' ? 'muted' : ''}}">{{item.value}}</view>
            <view class="price-note" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{activeTab === 2}}">
        <view class="section-title">自动购置建议</view>

        <!-- 维度一：投资 -->
        <view class="dimension-card">
          <view class="dimension-header">
            <view class="dimension-title">投资</view>
            <view class="dimension-level {{report.advice.investment.totalScore >= 55 ? 'high' : (report.advice.investment.totalScore >= 35 ? 'mid' : 'low')}}">
              {{report.advice.investment.level}}
            </view>
            <view class="dimension-total">{{report.advice.investment.totalScore}}</view>
            <view class="dimension-total-label">分</view>
          </view>

          <!-- 饼图：三个子项占比（面积大小代表推荐分数） -->
          <view class="pie-section">
            <view class="pie-wrap">
              <view class="pie-donut" style="background: {{report.advice.investment.pieBg}};">
                <view class="pie-hole">
                  <view class="pie-center-score">{{report.advice.investment.totalScore}}</view>
                  <view class="pie-center-label">综合评分</view>
                </view>
              </view>
            </view>

            <!-- 图例 -->
            <view class="pie-legend">
              <view class="legend-item" wx:for="{{report.advice.investment.categories}}" wx:key="name">
                <view class="legend-dot" style="background:{{item.color}}"></view>
                <view class="legend-info">
                  <view class="legend-name">{{item.name}}</view>
                  <view class="legend-desc">{{item.desc}}</view>
                </view>
                <view class="legend-right">
                  <view class="legend-score" style="color:{{item.color}}">{{item.score}}分</view>
                  <view class="legend-pct">{{item.pct}}%</view>
                </view>
              </view>
            </view>
          </view>

          <!-- 三张分类卡片 -->
          <view class="category-cards">
            <view class="category-card {{expandedAdvice === 'inv-' + index ? 'expanded' : ''}}"
              wx:for="{{report.advice.investment.categories}}"
              wx:key="name"
              data-key="{{'inv-' + index}}"
              bindtap="toggleAdviceKey">
              <view class="cat-card-header">
                <view class="cat-indicator" style="background:{{item.color}}"></view>
                <view class="cat-name">{{item.name}}</view>
                <view class="cat-desc-small">{{item.desc}}</view>
                <view class="cat-right">
                  <view class="cat-score" style="color:{{item.color}}">{{item.score}}分</view>
                  <view class="cat-pct">{{item.pct}}%</view>
                </view>
                <view class="cat-arrow">{{expandedAdvice === 'inv-' + index ? '⌃' : '⌄'}}</view>
              </view>
              <view class="cat-card-body" wx:if="{{expandedAdvice === 'inv-' + index}}">
                <view class="cat-threshold">判断标准：{{item.threshold}}</view>
                <view class="cat-detail-row" wx:for="{{item.details}}" wx:for-item="det" wx:key="label">
                  <view class="cat-detail-label {{det.highlight ? 'highlight' : ''}}">{{det.label}}</view>
                  <view class="cat-detail-value {{det.highlight ? 'highlight' : ''}}">{{det.value}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 维度二：自住 -->
        <view class="dimension-card">
          <view class="dimension-header">
            <view class="dimension-title">自住</view>
            <view class="dimension-level {{report.advice.selfuse.totalScore >= 55 ? 'high' : (report.advice.selfuse.totalScore >= 35 ? 'mid' : 'low')}}">
              {{report.advice.selfuse.level}}
            </view>
            <view class="dimension-total">{{report.advice.selfuse.totalScore}}</view>
            <view class="dimension-total-label">分</view>
          </view>

          <!-- 饼图 -->
          <view class="pie-section">
            <view class="pie-wrap">
              <view class="pie-donut" style="background: {{report.advice.selfuse.pieBg}};">
                <view class="pie-hole">
                  <view class="pie-center-score">{{report.advice.selfuse.totalScore}}</view>
                  <view class="pie-center-label">综合评分</view>
                </view>
              </view>
            </view>

            <!-- 图例 -->
            <view class="pie-legend">
              <view class="legend-item" wx:for="{{report.advice.selfuse.categories}}" wx:key="name">
                <view class="legend-dot" style="background:{{item.color}}"></view>
                <view class="legend-info">
                  <view class="legend-name">{{item.name}}</view>
                  <view class="legend-desc">{{item.desc}}</view>
                </view>
                <view class="legend-right">
                  <view class="legend-score" style="color:{{item.color}}">{{item.score}}分</view>
                  <view class="legend-pct">{{item.pct}}%</view>
                </view>
              </view>
            </view>
          </view>

          <!-- 三张分类卡片 -->
          <view class="category-cards">
            <view class="category-card {{expandedAdvice === 'live-' + index ? 'expanded' : ''}}"
              wx:for="{{report.advice.selfuse.categories}}"
              wx:key="name"
              data-key="{{'live-' + index}}"
              bindtap="toggleAdviceKey">
              <view class="cat-card-header">
                <view class="cat-indicator" style="background:{{item.color}}"></view>
                <view class="cat-name">{{item.name}}</view>
                <view class="cat-desc-small">{{item.desc}}</view>
                <view class="cat-right">
                  <view class="cat-score" style="color:{{item.color}}">{{item.score}}分</view>
                  <view class="cat-pct">{{item.pct}}%</view>
                </view>
                <view class="cat-arrow">{{expandedAdvice === 'live-' + index ? '⌃' : '⌄'}}</view>
              </view>
              <view class="cat-card-body" wx:if="{{expandedAdvice === 'live-' + index}}">
                <view class="cat-threshold">判断标准：{{item.threshold}}</view>
                <view class="cat-detail-row" wx:for="{{item.details}}" wx:for-item="det" wx:key="label">
                  <view class="cat-detail-label {{det.highlight ? 'highlight' : ''}}">{{det.label}}</view>
                  <view class="cat-detail-value {{det.highlight ? 'highlight' : ''}}">{{det.value}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="notice">建议由后台数据自动生成，仅作为筛选参考；成交、产权、学区和贷款条件仍需线下核实。</view>
      </view>

      <view wx:if="{{activeTab === 3}}">
        <view class="section-title">自动测算</view>
        <block wx:for="{{report.tools}}" wx:key="label">
          <view class="tool-card {{expandedTool === index ? 'expanded' : ''}}" wx:if="{{item.enabled !== false}}">
          <view class="tool-summary" data-index="{{index}}" bindtap="toggleTool">
            <view class="tool-summary-body">
              <view class="tool-label">{{item.label}}</view>
              <view class="tool-note">{{item.note}}</view>
            </view>
            <view class="tool-result">
              <view class="tool-value">{{item.value}}</view>
              <view class="tool-arrow">{{expandedTool === index ? '⌃' : '⌄'}}</view>
            </view>
          </view>
          <view class="tool-detail" wx:if="{{expandedTool === index}}">
            <block wx:if="{{item.loanCalculator}}">
              <view class="loan-panel">
                <view class="loan-panel-head">
                  <view>
                    <view class="loan-panel-title">房贷计算器</view>
                    <view class="loan-panel-subtitle">根据房屋总价、首付和利率估算月供</view>
                  </view>
                  <view class="loan-panel-badge">仅供参考</view>
                </view>
                <view class="loan-type-tabs">
                  <view class="loan-type-tab {{loanForm.loanType === item ? 'active' : ''}}" wx:for="{{loanTypeOptions}}" wx:key="*this" data-index="{{index}}" bindtap="onLoanTypeTap">{{item}}</view>
                </view>
                <view class="loan-form">
                  <view class="loan-section-title">基础信息</view>
                  <view class="form-row prominent-row">
                    <view class="form-label"><view>房屋总价</view><view class="form-hint">单位：万元</view></view>
                    <view class="field-control"><input class="form-input" type="digit" value="{{loanForm.totalPrice}}" data-field="totalPrice" bindinput="onLoanInput" placeholder="请输入总价" /><text class="field-unit">万元</text></view>
                  </view>
                  <view class="form-row">
                    <view class="form-label"><view>首付比例</view><view class="form-hint">首付越高，贷款越少</view></view>
                    <view class="field-control"><input class="form-input" type="digit" value="{{loanForm.downPayment}}" data-field="downPayment" bindinput="onLoanInput" placeholder="30" /><text class="field-unit">%</text></view>
                  </view>
                  <view class="form-row">
                    <view class="form-label">贷款期限</view>
                    <picker class="field-picker-wrap" mode="selector" range="{{loanTermOptions}}" value="{{loanForm.termIndex}}" bindchange="onLoanTermChange"><view class="form-picker"><text>{{loanForm.termYears}}年</text><text class="picker-arrow">⌄</text></view></picker>
                  </view>
                  <view class="form-row">
                    <view class="form-label">还款方式</view>
                    <picker class="field-picker-wrap" mode="selector" range="{{repaymentOptions}}" value="{{loanForm.repaymentIndex}}" bindchange="onRepaymentChange"><view class="form-picker"><text>{{loanForm.repayment}}</text><text class="picker-arrow">⌄</text></view></picker>
                  </view>
                  <view class="loan-section-title rate-title">利率设置</view>
                  <view class="form-row" wx:if="{{loanForm.loanType !== '公积金贷款'}}">
                    <view class="form-label"><view>商业贷款利率</view><view class="form-hint">年利率</view></view>
                    <view class="field-control"><input class="form-input" type="digit" value="{{loanForm.commercialRate}}" data-field="commercialRate" bindinput="onLoanInput" /><text class="field-unit">%</text></view>
                  </view>
                  <view class="form-row" wx:if="{{loanForm.loanType !== '商业贷款'}}">
                    <view class="form-label"><view>公积金贷款利率</view><view class="form-hint">年利率</view></view>
                    <view class="field-control"><input class="form-input" type="digit" value="{{loanForm.providentRate}}" data-field="providentRate" bindinput="onLoanInput" /><text class="field-unit">%</text></view>
                  </view>
                  <view class="form-row" wx:if="{{loanForm.loanType === '组合贷款'}}">
                    <view class="form-label"><view>商贷占比</view><view class="form-hint">剩余为公积金贷款</view></view>
                    <view class="field-control"><input class="form-input" type="digit" value="{{loanForm.commercialShare}}" data-field="commercialShare" bindinput="onLoanInput" /><text class="field-unit">%</text></view>
                  </view>
                  <button class="calculate-button" bindtap="calculateLoan">开始计算</button>
                </view>
                <view class="loan-result">
                  <view class="loan-result-head"><view class="loan-result-title">预计月供</view><view class="loan-monthly">{{loanResult.summary}}</view></view>
                  <view class="loan-result-message" wx:if="{{loanResult.message}}">{{loanResult.message}}</view>
                  <view class="loan-result-grid" wx:if="{{loanResult.valid}}">
                    <view class="loan-result-item" wx:for="{{loanResult.parts}}" wx:for-item="part" wx:key="name"><view class="part-name">{{part.name}}</view><view class="part-value">{{part.value}}</view></view>
                  </view>
                </view>
                <view class="tool-warning">{{item.warning}}</view>
              </view>
            </block>
            <block wx:else>
              <view class="formula-box"><view class="formula-title">计算公式</view><view class="formula-text">{{item.formula}}</view></view>
              <view class="part-title">计算过程</view>
              <view class="part-row" wx:for="{{item.parts}}" wx:for-item="part" wx:key="name"><view class="part-name">{{part.name}}</view><view class="part-value">{{part.value}}</view></view>
              <view class="tool-warning">{{item.warning}}</view>
            </block>
          </view>
        </view>
        </block>
        <view class="section-title">后台数据完整性</view>
        <view class="audit-card {{report.missing.length ? 'warn' : 'ok'}}">
          <view class="audit-title">{{report.missing.length ? '发现缺失字段' : '本报告字段完整'}}</view>
          <view class="tags" wx:if="{{report.missing.length}}"><text class="missing-tag" wx:for="{{report.missing}}" wx:key="*this">{{item}}</text></view>
          <view class="audit-text" wx:else>基本信息、价格和建议所需数据均已从后台取得。</view>
        </view>
      </view>
    </block>
  </block>

  <view class="report-export-area" wx:if="{{selectedCommunity && !loading}}">
    <view class="report-export-title">已汇总四个分析部分</view>
    <view class="report-export-subtitle">基本信息 · 价值分析 · 购置建议 · 工具使用</view>
    <button class="report-export-button" bindtap="exportPdf">生成 PDF 报告</button>
  </view>
  <canvas id="pdfCanvas" type="2d" class="pdf-canvas"></canvas>
</view>
