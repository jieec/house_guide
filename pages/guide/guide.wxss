/* 指南页面 - 柔和紫色风格 + 入场动画 */

page {
  background: linear-gradient(180deg, #FAFAFF 0%, #F5F3FF 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.guide-layout {
  min-height: 100vh;
}

.guide-main {
  min-width: 0;
  padding: 40rpx 24rpx 200rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ==================== 动画定义 ==================== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-100rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes floatBubble {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  50% {
    transform: translate(50rpx, -50rpx) scale(1.1);
  }
}

/* ==================== 页面标题区 ==================== */
.page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 40rpx;
  opacity: 0;
}

.page-heading.animated {
  animation: fadeInUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.eyebrow {
  color: #8B5CF6;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  opacity: 0;
}

.page-heading.animated .eyebrow {
  animation: slideInLeft 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
}

.page-title {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #2D2D3A 0%, #8B5CF6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -1rpx;
  opacity: 0;
}

.page-heading.animated .page-title {
  animation: fadeInScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
}

.page-subtitle {
  margin-top: 16rpx;
  color: #8B8B9A;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  opacity: 0;
}

.page-heading.animated .page-subtitle {
  animation: fadeInUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
}

/* ==================== 背景装饰 ==================== */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}

.orb-1 {
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, rgba(139, 92, 246, 0) 70%);
  animation: floatBubble 20s ease-in-out infinite;
}

.orb-2 {
  bottom: -300rpx;
  left: -200rpx;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(circle, rgba(124, 92, 252, 0.12) 0%, rgba(124, 92, 252, 0) 70%);
  animation: floatBubble 25s ease-in-out infinite reverse;
}

/* 确保内容在装饰层之上 */
.tabs-wrap, .card, .price-chart, .report-export-area {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

.animate-item {
  opacity: 0;
  transform: translateY(60rpx);
}

.animate-item.animated {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 选项卡入场 */
.tabs {
  animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s backwards;
}

/* 内容卡片依次入场 */
.guide-item, .section-card, .item-card, .knowledge-card {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.guide-item:nth-child(1), .section-card:nth-child(1), .item-card:nth-child(1), .knowledge-card:nth-child(1) { 
  animation-delay: 0.2s; 
}
.guide-item:nth-child(2), .section-card:nth-child(2), .item-card:nth-child(2), .knowledge-card:nth-child(2) { 
  animation-delay: 0.3s; 
}
.guide-item:nth-child(3), .section-card:nth-child(3), .item-card:nth-child(3), .knowledge-card:nth-child(3) { 
  animation-delay: 0.4s; 
}
.guide-item:nth-child(4), .section-card:nth-child(4), .item-card:nth-child(4), .knowledge-card:nth-child(4) { 
  animation-delay: 0.5s; 
}
.guide-item:nth-child(5), .section-card:nth-child(5), .item-card:nth-child(5), .knowledge-card:nth-child(5) { 
  animation-delay: 0.6s; 
}
.guide-item:nth-child(n+6), .section-card:nth-child(n+6), .item-card:nth-child(n+6), .knowledge-card:nth-child(n+6) { 
  animation-delay: 0.7s; 
}

.page {
  min-height: 100vh;
}

/* 查询卡片 */
.query-card {
  margin: 24rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
}

.query-title {
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  letter-spacing: -0.8rpx;
}

/* 位置行 */
.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F5F3FF;
  margin-bottom: 28rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.location-row:active {
  background: #F5F3FF;
  transform: scale(0.99);
  margin: 0 -16rpx 28rpx;
  padding: 28rpx 16rpx;
  border-radius: 16rpx;
}

.location-label {
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.location-value {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
}

.location-empty {
  color: #B8B8C9;
  font-size: 30rpx;
  font-weight: 500;
}

.change {
  color: #8B5CF6;
  font-size: 30rpx;
  font-weight: 600;
}

/* 搜索结果 */
.search-results {
  margin-top: 20rpx;
  max-height: 420rpx;
  overflow-y: auto;
  border: 2rpx solid #E8E5F6;
  border-radius: 20rpx;
  background: #FAFAFE;
}

.search-item {
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #F5F3FF;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.search-item:last-child {
  border-bottom: 0;
}

.search-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx);
  border-left: 4rpx solid #8B5CF6;
  padding-left: 20rpx;
}

.search-name {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
}

.search-address {
  margin-top: 8rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.searching {
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  position: relative;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-house {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  opacity: 0.15;
  animation: floatSlow 6s ease-in-out infinite;
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20rpx); }
}

.empty-icon {
  font-size: 96rpx;
  color: #E8E5F6;
  margin-bottom: 32rpx;
}

.empty-title {
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.6;
}

/* 报告头部 */
.report-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin: 24rpx 24rpx 20rpx;
}

.report-name {
  flex: 1;
  color: #2D2D3A;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.report-meta {
  margin-top: 12rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

/* 重新加载按钮 */
.reload {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.08);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.reload:active {
  transform: scale(0.9) rotate(180deg);
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.15);
  background: #F5F3FF;
}

/* 选项卡 */
.tabs {
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.tabs-inner {
  display: flex;
  gap: 16rpx;
}

.tab {
  padding: 16rpx 28rpx;
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #B8B8C9;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.06);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab:active {
  transform: scale(0.92) translateY(2rpx);
  background: rgba(139, 92, 246, 0.1);
  border-color: #8B5CF6;
}

.tab.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.35),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.2);
  transform: scale(1);
}

.loading {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #8B8B9A;
  font-size: 30rpx;
  font-weight: 500;
}

/* 区块标题 */
.section-title {
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
  margin: 40rpx 24rpx 20rpx;
  letter-spacing: -0.8rpx;
}

/* 数据卡片 */
.data-card {
  margin: 0 24rpx 24rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .data-card:active 已移除，避免干扰滚动 */

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F3FF;
}

.data-row:last-child {
  border-bottom: 0;
}

.data-label {
  color: #8B8B9A;
  font-size: 30rpx;
  font-weight: 500;
}

.data-value {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

.data-value.muted {
  color: #B8B8C9;
  font-weight: 500;
}

.sub-title {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.divider {
  height: 2rpx;
  background: #F5F3FF;
  margin: 32rpx 0;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.08);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tag:active {
  transform: scale(0.92) translateY(2rpx);
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.3);
}

.tag.blue {
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border-color: #E8E5F6;
  color: #8B5CF6;
}

.tag.blue:active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
}

/* 竞品 */
.competitor {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F3FF;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.competitor:last-child {
  border-bottom: 0;
}

.competitor:active {
  background: #F5F3FF;
  transform: translateX(8rpx);
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 16rpx;
}

.competitor-name {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
}

.competitor-meta {
  margin-top: 8rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

.competitor-price {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

/* 价格图表 */
.price-chart {
  margin: 0 24rpx 24rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FEFEFF 100%);
  border-radius: 32rpx;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.price-chart:active {
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15);
}

.price-chart-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.price-chart-title {
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
}

.price-chart-unit {
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

.price-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.price-bar-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.price-bar-body {
  flex: 1;
  min-width: 0;
}

.price-bar-value {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.price-bar-value.muted {
  color: #B8B8C9;
  font-weight: 500;
}

.price-bar-plot {
  position: relative;
  height: 56rpx;
  perspective: 1200rpx;
}

.price-bar-track {
  position: relative;
  width: 100%;
  height: 28rpx;
  background: linear-gradient(180deg, #E8E3FD 0%, #F0EAFE 50%, #F5F3FF 100%);
  border-radius: 14rpx;
  overflow: visible;
  box-shadow: inset 0rpx 3rpx 6rpx rgba(139, 92, 246, 0.12),
              inset 0rpx 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.price-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(135deg, 
    var(--bar-color, #9D7FF8) 0%, 
    var(--bar-color, #8B5CF6) 40%,
    var(--bar-color, #7C5CFC) 70%,
    var(--bar-color, #6D4EED) 100%);
  border-radius: 14rpx;
  box-shadow: 0rpx 6rpx 16rpx rgba(124, 92, 252, 0.3),
              0rpx 3rpx 8rpx rgba(124, 92, 252, 0.2),
              0rpx 1rpx 4rpx rgba(124, 92, 252, 0.15),
              inset 0rpx -3rpx 6rpx rgba(0, 0, 0, 0.15),
              inset 0rpx 3rpx 6rpx rgba(255, 255, 255, 0.4);
  transition: width 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              transform 0.3s ease;
  position: relative;
  transform-style: preserve-3d;
}

.price-bar-fill::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, 
    rgba(255, 255, 255, 0.5) 0%,
    rgba(255, 255, 255, 0.25) 50%, 
    rgba(255, 255, 255, 0) 100%);
  border-radius: 14rpx 14rpx 0 0;
  mix-blend-mode: overlay;
}

.price-bar-fill::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(180deg, 
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.08) 50%, 
    rgba(0, 0, 0, 0.2) 100%);
  border-radius: 0 0 14rpx 14rpx;
}

.price-note {
  margin-top: 12rpx;
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
}

.price-chart-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F5F3FF;
  color: #B8B8C9;
  font-size: 24rpx;
  font-weight: 500;
}

/* 价格网格 */
.price-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx 24rpx;
}

.price-card {
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .price-card:active 已移除，避免干扰滚动 */

.price-card::before {
  content: '';
  position: absolute;
  bottom: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
}

.price-label {
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.price-value {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  position: relative;
  z-index: 1;
}

/* 维度卡片 */
.dimension-card {
  margin: 0 24rpx 40rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .dimension-card:active 已移除，避免干扰滚动 */

.dimension-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.dimension-title {
  color: #2D2D3A;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

/* 维度等级 */
.dimension-level {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .dimension-level:active 已移除，避免干扰滚动 */

.dimension-level.high {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 4rpx 12rpx rgba(124, 92, 252, 0.3);
}

/* .dimension-level.high:active 已移除，避免干扰滚动 */

.dimension-level.mid {
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  color: #8B5CF6;
}

.dimension-level.low {
  background: #F5F3FF;
  color: #B8B8C9;
}

.dimension-total {
  margin-left: auto;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.dimension-total-label {
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

/* 饼图区块 */
.pie-section {
  margin-bottom: 40rpx;
}

.pie-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.pie-donut {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, #8B5CF6 0%, #7C5CFC 100%);
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.3);
}

.pie-hole {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 150rpx;
  height: 150rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-center-score {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.pie-center-label {
  margin-top: 6rpx;
  color: #8B8B9A;
  font-size: 22rpx;
  font-weight: 500;
}

/* 图例 */
.pie-legend {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.legend-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx);
  margin: 0 -16rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.3);
  flex-shrink: 0;
}

.legend-info {
  flex: 1;
  min-width: 0;
}

.legend-name {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
}

.legend-desc {
  margin-top: 6rpx;
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
}

.legend-right {
  text-align: right;
  flex-shrink: 0;
}

.legend-score {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.legend-pct {
  margin-top: 6rpx;
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
}

/* 分类卡片 */
.category-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  border: 2rpx solid #E8E5F6;
  border-radius: 28rpx;
  background: #FFFFFF;
  overflow: hidden;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.06);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .category-card:active 已移除，避免干扰滚动 */

.category-card.expanded {
  background: #FAFAFE;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.12);
}

.cat-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.cat-indicator {
  width: 8rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #8B5CF6 0%, #7C5CFC 100%);
  flex-shrink: 0;
  box-shadow: 0rpx 2rpx 8rpx rgba(124, 92, 252, 0.3);
}

.cat-name {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
}

.cat-desc-small {
  flex: 1;
  min-width: 0;
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
}

.cat-right {
  text-align: right;
  flex-shrink: 0;
}

.cat-score {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.cat-pct {
  margin-top: 6rpx;
  color: #8B8B9A;
  font-size: 22rpx;
  font-weight: 500;
}

.cat-arrow {
  margin-left: 16rpx;
  color: #B8B8C9;
  font-size: 32rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.category-card.expanded .cat-arrow {
  transform: rotate(90deg);
}

.cat-card-body {
  padding: 0 28rpx 28rpx;
  border-top: 2rpx solid #F5F3FF;
}

.cat-threshold {
  padding-top: 24rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.cat-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F3FF;
}

.cat-detail-row:last-child {
  border-bottom: 0;
}

.cat-detail-label {
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 500;
}

.cat-detail-value {
  color: #2D2D3A;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
}

.cat-detail-label.highlight,
.cat-detail-value.highlight {
  color: #8B5CF6;
  font-weight: 700;
}

/* 提示 */
.notice {
  margin: 0 24rpx 40rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 24rpx;
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.7;
  transition: all 0.3s ease;
}

.notice:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #E8E5F6 0%, #DDD8F0 100%);
}

/* 工具卡片 */
.tool-card {
  margin: 0 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0rpx 8rpx 32rpx rgba(124, 92, 252, 0.08),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.04);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tool-card.expanded {
  background: #FAFAFE;
  box-shadow: 0rpx 12rpx 40rpx rgba(124, 92, 252, 0.15);
}

.tool-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tool-summary:active {
  background: #F5F3FF;
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.1);
}

.tool-summary-body {
  flex: 1;
  min-width: 0;
}

.tool-label {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
}

.tool-note {
  margin-top: 8rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

.tool-result {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.tool-value {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.tool-arrow {
  color: #B8B8C9;
  font-size: 32rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tool-card.expanded .tool-arrow {
  transform: rotate(90deg);
}

.tool-detail {
  padding: 0 36rpx 36rpx;
  border-top: 2rpx solid #F5F3FF;
}

/* 贷款面板 */
.loan-panel {
  padding-top: 28rpx;
}

.loan-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.loan-panel-title {
  color: #2D2D3A;
  font-size: 36rpx;
  font-weight: 700;
}

.loan-panel-subtitle {
  margin-top: 10rpx;
  color: #8B8B9A;
  font-size: 26rpx;
  font-weight: 500;
}

.loan-panel-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  color: #8B5CF6;
  font-size: 24rpx;
  font-weight: 600;
}

/* 贷款类型选项卡 */
.loan-type-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.loan-type-tab {
  flex: 1;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #B8B8C9;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0rpx 4rpx 16rpx rgba(124, 92, 252, 0.06);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.loan-type-tab:active {
  transform: scale(0.92) translateY(2rpx);
  background: rgba(139, 92, 246, 0.1);
  border-color: #8B5CF6;
}

.loan-type-tab.active {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.35),
              0rpx 2rpx 8rpx rgba(124, 92, 252, 0.2);
  transform: scale(1);
}

.loan-type-tab.active:active {
  transform: scale(0.95) translateY(2rpx);
}

/* 贷款表单 */
.loan-form {
  margin-bottom: 40rpx;
}

.loan-section-title {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
  margin: 36rpx 0 24rpx;
}

.loan-section-title.rate-title {
  margin-top: 28rpx;
}

.prominent-row {
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 36rpx;
}

.form-hint {
  margin-top: 8rpx;
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
}

.field-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-unit {
  color: #8B8B9A;
  font-size: 28rpx;
  font-weight: 500;
}

.field-picker-wrap {
  flex: 1;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E8E5F6;
  border-radius: 20rpx;
  background: #FAFAFE;
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 500;
}

.picker-arrow {
  color: #B8B8C9;
  font-size: 32rpx;
}

/* 贷款结果 */
.loan-result {
  padding: 32rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  transition: all 0.3s ease;
}

/* .loan-result:active 已移除，避免干扰滚动 */

.loan-result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.loan-result-title {
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 600;
}

.loan-monthly {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.loan-result-message {
  color: #8B5CF6;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.6;
}

.loan-result-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 24rpx;
}

.loan-result-item {
  padding: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5F6;
  border-radius: 16rpx;
}

.part-name {
  color: #8B8B9A;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.part-value {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
}

/* 公式框 */
.formula-box {
  padding: 28rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 20rpx;
  margin: 28rpx 0;
}

.formula-title {
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.formula-text {
  color: #2D2D3A;
  font-size: 28rpx;
  font-weight: 500;
  font-family: 'Courier New', monospace;
  line-height: 1.7;
}

.part-title {
  color: #2D2D3A;
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 0 20rpx;
}

.part-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F3FF;
}

.part-row:last-child {
  border-bottom: 0;
}

.tool-warning {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
  border-radius: 16rpx;
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.7;
}

/* 审计卡片 */
.audit-card {
  margin: 0 24rpx 40rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* .audit-card:active 已移除，避免干扰滚动 */

.audit-card.warn {
  background: linear-gradient(135deg, #FFF5F5 0%, #FEE8E8 100%);
  border: 2rpx solid #FEE8E8;
}

/* .audit-card.warn:active 已移除，避免干扰滚动 */

.audit-card.ok {
  background: linear-gradient(135deg, #F5F3FF 0%, #E8E5F6 100%);
  border: 2rpx solid #E8E5F6;
}

/* .audit-card.ok:active 已移除，避免干扰滚动 */

.audit-title {
  color: #2D2D3A;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.audit-text {
  color: #2D2D3A;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.6;
}

.missing-tag {
  padding: 8rpx 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5F6;
  border-radius: 999rpx;
  color: #8B5CF6;
  font-size: 24rpx;
  font-weight: 600;
}

/* ==================== 悬停效果 ==================== */

.location-row:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 20rpx 60rpx rgba(124, 92, 252, 0.25);
}

.search-item:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.08);
}

.reload:hover {
  transform: scale(1.1) rotate(360deg);
  color: #7C5CFC;
}

.tab:hover {
  transform: translateY(-4rpx) scale(1.05);
  color: #8B5CF6;
}

.tab.active:hover {
  transform: translateY(-6rpx) scale(1.08);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.4);
}

.data-card:hover {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: 0rpx 24rpx 60rpx rgba(124, 92, 252, 0.25);
}

.tag:hover {
  transform: scale(1.1) translateY(-2rpx);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.3);
}

.tag.blue:hover {
  transform: scale(1.1) translateY(-2rpx) rotate(-2deg);
}

.competitor:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.08);
}

.price-chart:hover {
  transform: scale(1.02);
}

.price-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.dimension-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.dimension-level:hover {
  transform: scale(1.08);
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.3);
}

.dimension-level.high:hover {
  transform: scale(1.1) rotate(-3deg);
}

.legend-item:hover {
  transform: scale(1.05);
}

.category-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.notice:hover {
  transform: translateX(8rpx);
  background: rgba(139, 92, 246, 0.08);
}

.tool-summary:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.loan-type-tab:hover {
  transform: translateY(-2rpx) scale(1.05);
  background: rgba(139, 92, 246, 0.12);
}

.loan-type-tab.active:hover {
  transform: translateY(-4rpx) scale(1.08);
  box-shadow: 0rpx 12rpx 32rpx rgba(124, 92, 252, 0.4);
}

.loan-result:hover {
  transform: translateY(-4rpx);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.audit-card:hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.2);
}

.audit-card.warn:hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0rpx 16rpx 48rpx rgba(255, 152, 0, 0.25);
}

.audit-card.ok:hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0rpx 16rpx 48rpx rgba(124, 92, 252, 0.25);
}

.audit-title:hover {
  transform: scale(1.02);
  color: #8B5CF6;
}

.audit-text:hover {
  transform: translateX(4rpx);
  color: #8B5CF6;
}

.missing-tag:hover {
  transform: scale(1.1) rotate(-2deg);
  background: rgba(139, 92, 246, 0.1);
  border-color: #8B5CF6;
}
