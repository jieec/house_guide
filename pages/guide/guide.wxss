.ai-title { color: #2D2D3A; font-size: 32rpx; font-weight: 700; }
.ai-subtitle { color: #8B8B9A; font-size: 24rpx; margin-top: 6rpx; }

.ai-btn {
  margin-top: 24rpx;
  background: #7C5CFC;
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}
