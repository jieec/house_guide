}

.audit-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.3rpx;
  margin-bottom: 14rpx;
}

.audit-card.warn .audit-title {
  color: #8A5A2B;
}

.audit-text {
  font-family: var(--font-serif);
  font-size: 22rpx;
