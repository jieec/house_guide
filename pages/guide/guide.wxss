page { background: #0a1628; color: #e8f0fe; }
.page { min-height: 100vh; padding: 24rpx 24rpx 80rpx; box-sizing: border-box; }
.query-card, .data-card, .advice-card, .tool-card, .audit-card {
  background: rgba(16, 32, 64, 0.7);
  border: 1rpx solid rgba(0, 180, 255, 0.12);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.15);
}
.query-card { padding: 28rpx; }
.query-title { font-size: 34rpx; font-weight: 700; margin-bottom: 22rpx; color: #ffffff; }
.location-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid rgba(0, 180, 255, 0.08); }
.location-label { color: #7b8fb0; font-size: 24rpx; }
.location-value { font-size: 29rpx; font-weight: 600; margin-top: 8rpx; color: #ffffff; }
.location-empty { color: #ff6b35; margin-top: 8rpx; }
.change, .reload { color: #00d4ff; font-size: 26rpx; }
.search-box { margin-top: 16rpx; height: 82rpx; background: rgba(10, 25, 50, 0.6); border: 1rpx solid rgba(0, 180, 255, 0.2); border-radius: 16rpx; display: flex; align-items: center; padding: 0 22rpx; }
.search-icon { font-size: 38rpx; color: #5b7aa8; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #e8f0fe; background: transparent; }
.searching { color: #7b8fb0; font-size: 23rpx; }
.search-results { margin-top: 12rpx; border: 1rpx solid rgba(0, 180, 255, 0.15); border-radius: 16rpx; overflow: hidden; background: rgba(16, 32, 64, 0.95); }
.search-item { padding: 20rpx; border-bottom: 1rpx solid rgba(0, 180, 255, 0.08); }
.search-item:last-child { border-bottom: 0; }
.search-name { font-weight: 650; font-size: 28rpx; color: #ffffff; }
.search-address { color: #7b8fb0; font-size: 23rpx; margin-top: 7rpx; }
.empty-state { text-align: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 78rpx; color: #3d5a8a; }
.empty-title { font-size: 31rpx; font-weight: 650; margin-top: 20rpx; color: #ffffff; }
.empty-text { color: #7b8fb0; font-size: 25rpx; line-height: 1.7; margin-top: 12rpx; }
.report-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 8rpx 18rpx; }
.report-name { font-size: 38rpx; font-weight: 750; color: #ffffff; }
.report-meta { color: #7b8fb0; font-size: 23rpx; margin-top: 7rpx; }
.tabs { white-space: nowrap; background: rgba(16, 32, 64, 0.6); border: 1rpx solid rgba(0, 180, 255, 0.1); border-radius: 18rpx; margin-bottom: 28rpx; }
.tabs-inner { display: flex; min-width: 100%; }
.tab { flex: 1; min-width: 150rpx; text-align: center; padding: 27rpx 4rpx 23rpx; color: #7b8fb0; font-size: 27rpx; position: relative; }
.tab.active { color: #00d4ff; font-weight: 700; }
.tab.active::after { content: ''; position: absolute; left: 30%; right: 30%; bottom: 8rpx; height: 6rpx; border-radius: 8rpx; background: linear-gradient(90deg, #1a5cff, #00d4ff); }
.loading { padding: 100rpx 0; text-align: center; color: #00d4ff; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 28rpx 8rpx 16rpx; color: #ffffff; }
.data-card { padding: 8rpx 26rpx; }
.data-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 23rpx 0; border-bottom: 1rpx solid rgba(0, 180, 255, 0.08); gap: 30rpx; }
.data-row:last-child { border-bottom: 0; }
.data-label { color: #7b8fb0; font-size: 26rpx; flex-shrink: 0; }
.data-value { font-size: 27rpx; font-weight: 600; text-align: right; color: #e8f0fe; }
.muted, .no-data { color: #5b7aa8 !important; font-weight: 400 !important; }
.sub-title { font-size: 27rpx; font-weight: 650; margin: 22rpx 0 14rpx; color: #ffffff; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; padding-bottom: 22rpx; }
.tag, .missing-tag { display: inline-block; padding: 10rpx 16rpx; background: rgba(0, 180, 255, 0.1); color: #00d4ff; border: 1rpx solid rgba(0, 180, 255, 0.15); border-radius: 10rpx; font-size: 23rpx; }
.tag.blue { background: rgba(35, 195, 67, 0.1); color: #5ddb7a; border-color: rgba(35, 195, 67, 0.15); }
.divider { height: 1rpx; background: rgba(0, 180, 255, 0.08); }
.no-data { padding: 4rpx 0 22rpx; font-size: 25rpx; }
.competitor { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid rgba(0, 180, 255, 0.08); }
.competitor:last-child { border-bottom: 0; }
.competitor-name { font-size: 27rpx; font-weight: 600; color: #ffffff; }
.competitor-meta { color: #7b8fb0; font-size: 22rpx; margin-top: 6rpx; }
.competitor-price { color: #ff6b35; font-size: 27rpx; font-weight: 700; }
.price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.price-card { background: rgba(16, 32, 64, 0.6); border: 1rpx solid rgba(0, 180, 255, 0.1); min-height: 158rpx; border-radius: 20rpx; padding: 24rpx; box-sizing: border-box; }
.price-label { color: #7b8fb0; font-size: 24rpx; }
.price-value { color: #00d4ff; font-weight: 750; font-size: 31rpx; margin-top: 16rpx; word-break: break-all; }
.price-note { color: #5b7aa8; font-size: 21rpx; line-height: 1.45; margin-top: 9rpx; }
.advice-card { padding: 0 27rpx 23rpx; margin-bottom: 18rpx; overflow: hidden; }
.advice-card.expanded { box-shadow: 0 0 30rpx rgba(0, 150, 255, 0.15); }
.advice-summary { display: flex; align-items: center; gap: 20rpx; padding: 25rpx 0 20rpx; }
.advice-summary-body { flex: 1; }
.advice-score-ring { width: 92rpx; height: 92rpx; border-radius: 50%; background: rgba(0, 180, 255, 0.15); border: 2rpx solid rgba(0, 212, 255, 0.3); color: #00d4ff; display: flex; align-items: baseline; justify-content: center; box-sizing: border-box; padding-top: 22rpx; }
.advice-score { font-size: 34rpx; font-weight: 800; }
.advice-percent { font-size: 18rpx; font-weight: 700; }
.advice-title { font-size: 29rpx; font-weight: 700; color: #ffffff; }
.advice-level { display: inline-block; padding: 7rpx 14rpx; margin-top: 9rpx; background: rgba(0, 180, 255, 0.15); color: #00d4ff; border: 1rpx solid rgba(0, 180, 255, 0.2); border-radius: 18rpx; font-size: 21rpx; }
.advice-arrow { color: #00d4ff; font-size: 28rpx; }
.score-track { height: 8rpx; background: rgba(0, 180, 255, 0.1); border-radius: 8rpx; overflow: hidden; }
.score-fill { height: 100%; background: linear-gradient(90deg, #1a5cff, #00d4ff); border-radius: 8rpx; }
.advice-detail { border-top: 1rpx solid rgba(0, 180, 255, 0.08); margin-top: 22rpx; padding-top: 22rpx; }
.advice-conclusion-title { color: #00d4ff; font-size: 24rpx; font-weight: 700; }
.metrics-title { margin-top: 26rpx; }
.advice-text { color: #8aa4cc; font-size: 26rpx; line-height: 1.75; margin-top: 17rpx; }
.metric-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 19rpx 0; border-bottom: 1rpx dashed rgba(0, 180, 255, 0.08); }
.metric-main { flex: 1; min-width: 0; }
.metric-name { color: #ffffff; font-size: 24rpx; font-weight: 600; }
.metric-value { color: #7b8fb0; font-size: 22rpx; line-height: 1.5; margin-top: 7rpx; }
.metric-result { color: #ff9a6c; background: rgba(255, 122, 69, 0.1); padding: 7rpx 12rpx; border-radius: 12rpx; font-size: 21rpx; flex-shrink: 0; }
.metric-result.good { color: #5ddb7a; background: rgba(35, 195, 67, 0.1); }
.notice { color: #ff9a6c; background: rgba(255, 122, 69, 0.1); border: 1rpx solid rgba(255, 122, 69, 0.15); border-radius: 16rpx; padding: 22rpx; font-size: 23rpx; line-height: 1.6; margin-top: 24rpx; }
.tool-card { padding: 0 27rpx; margin-bottom: 16rpx; overflow: hidden; }
.tool-card.expanded { box-shadow: 0 0 30rpx rgba(0, 150, 255, 0.15); }
.tool-summary { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 25rpx 0; }
.tool-summary-body { flex: 1; min-width: 0; }
.tool-result { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.tool-label { font-size: 27rpx; font-weight: 600; color: #ffffff; }
.tool-value { font-size: 28rpx; color: #00d4ff; font-weight: 750; text-align: right; }
.tool-note { color: #7b8fb0; font-size: 22rpx; margin-top: 10rpx; line-height: 1.5; }
.tool-arrow { width: 38rpx; height: 38rpx; line-height: 34rpx; text-align: center; border-radius: 50%; background: rgba(0, 180, 255, 0.15); color: #00d4ff; font-size: 26rpx; }
.tool-detail { border-top: 1rpx solid rgba(0, 180, 255, 0.08); padding: 23rpx 0 27rpx; }
.formula-box { padding: 20rpx; background: rgba(0, 100, 200, 0.15); border: 1rpx solid rgba(0, 180, 255, 0.1); border-radius: 14rpx; }
.formula-title, .part-title { color: #00d4ff; font-size: 23rpx; font-weight: 700; }
.formula-text { color: #8aa4cc; font-size: 24rpx; line-height: 1.65; margin-top: 9rpx; }
.part-title { margin: 25rpx 0 8rpx; }
.part-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; padding: 17rpx 0; border-bottom: 1rpx dashed rgba(0, 180, 255, 0.08); }
.part-name { color: #7b8fb0; font-size: 24rpx; flex-shrink: 0; }
.part-value { color: #e8f0fe; font-size: 24rpx; line-height: 1.55; text-align: right; }
.tool-warning { margin-top: 21rpx; padding: 18rpx; color: #ff9a6c; background: rgba(255, 122, 69, 0.08); border: 1rpx solid rgba(255, 122, 69, 0.12); border-radius: 12rpx; font-size: 22rpx; line-height: 1.6; }
.audit-card { padding: 27rpx; }
.audit-card.warn { background: rgba(255, 122, 69, 0.08); border-color: rgba(255, 122, 69, 0.15); }
.audit-card.ok { background: rgba(35, 195, 67, 0.08); border-color: rgba(35, 195, 67, 0.15); }
.audit-title { font-size: 28rpx; font-weight: 700; margin-bottom: 17rpx; color: #ffffff; }
.missing-tag { color: #ff9a6c; background: rgba(255, 122, 69, 0.12); border-color: rgba(255, 122, 69, 0.15); }
.audit-text { color: #7b8fb0; font-size: 25rpx; }
