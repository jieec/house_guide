  border-bottom: 0;
  padding-bottom: 4rpx;
}

.loan-section-title {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #695C93;
  letter-spacing: 1.5rpx;
  padding: 4rpx 0 8rpx;
}

/* 上一行自带分隔线，这里只留呼吸感，避免双线 */
.rate-title {
  margin-top: 4rpx;
