/* ---------- 房贷计算器面板 ---------- */

.loan-panel {
  background: #FAF9FD;
  border: 1rpx solid #EBE8F7;
  border-radius: 22rpx;
  padding: 22rpx;
}

.loan-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.loan-panel-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #372C57;
  letter-spacing: 0.3rpx;
}

.loan-panel-subtitle {
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6C6A8E;
  letter-spacing: 0.3rpx;
  line-height: 1.6;
