  min-width: 0;
  width: auto;
  text-align: right;
}

.field-unit {
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6F6A8A;
}

.field-picker-wrap {
  flex: 0 0 auto;
}

.form-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2846;
}

.calculate-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 22rpx;
  padding: 0;
