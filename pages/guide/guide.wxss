/* ========================================
   小区报告 · 四个分析页签
   基本信息 / 价值分析 / 购置建议 / 工具使用
   依赖 app.wxss + styles/components.wxss 的全局原语
   ======================================== */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
}

.guide-layout,
.guide-main {
  position: relative;
  min-height: 100vh;
}

.guide-main {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 背景光晕：极淡，只做氛围 */
.bg-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 420rpx;
  height: 420rpx;
  top: 60rpx;
  right: -160rpx;
  background: radial-gradient(circle, #E7E3F6 0%, rgba(231, 227, 246, 0) 70%);
}

.orb-2 {
  width: 360rpx;
  height: 360rpx;
  top: 520rpx;
  left: -140rpx;
  background: radial-gradient(circle, #EFECFA 0%, rgba(239, 236, 250, 0) 70%);
}

/* ========================================
   一、查询卡片
   ======================================== */

.query-card {
  position: relative;
  z-index: 2;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 30rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
}

.query-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #372C57;
  letter-spacing: 0.5rpx;
  margin-bottom: 16rpx;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EBE8F7;
  transition: opacity 0.2s ease;
}

.location-row:active {
  opacity: 0.7;
}

.location-label {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6C6A8E;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.location-value {
  font-family: var(--font-serif);
  font-size: 27rpx;
  color: #2A2846;
  letter-spacing: 0.4rpx;
  line-height: 1.5;
}

.location-empty {
  font-family: var(--font-serif);
  font-size: 27rpx;
  color: #8378AC;
  letter-spacing: 0.4rpx;
}

.change {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #F1EFFA;
  color: #52467B;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.change .ic {
  width: 18rpx;
  height: 18rpx;
  opacity: 0.8;
}

.change:active {
  background: #E7E3F6;
  transform: scale(0.96);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #EBE8F7;
  border-radius: 26rpx;
  background: #F6F5FC;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.search-box:active {
  border-color: #C1BAD9;
  box-shadow: 0 0 0 4rpx rgba(82, 70, 123, 0.08);
}

.search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #8378AC;
}

.search-icon .ic {
  width: 28rpx;
  height: 28rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  width: auto;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: var(--font-sans);
  font-size: 27rpx;
  color: #2A2846;
  text-align: left;
}

.search-input::placeholder {
  color: #6F6A8A;
  font-weight: 400;
}

.searching {
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6F6A8A;
  letter-spacing: 0.5rpx;
}

.search-results {
  margin-top: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(55, 44, 87, 0.07);
}

.search-item {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #F2F0F9;
  transition: background 0.2s ease;
}

.search-item:last-child {
  border-bottom: none;
}

.search-item:active {
  background: #F6F5FC;
}

.search-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.3rpx;
}

.search-address {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6B6890;
  margin-top: 4rpx;
  line-height: 1.6;
}

/* ========================================
   二、空状态
   ======================================== */

.empty-state {
  position: relative;
  z-index: 2;
  margin-top: 40rpx;
  padding: 60rpx 34rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(55, 44, 87, 0.05);
  text-align: center;
}

.empty-house {
  width: 240rpx;
  height: 180rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 22rpx;
  border-radius: 28rpx;
  background: #E7E3F6;
  color: #52467B;
}

.empty-icon .ic {
  width: 44rpx;
  height: 44rpx;
}

.empty-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: #372C57;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

.empty-text {
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #6B6890;
  line-height: 1.85;
  letter-spacing: 0.4rpx;
  margin-top: 12rpx;
}

/* ========================================
   三、报告头 + 页签
   ======================================== */

.report-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 8rpx 0 22rpx;
}

.report-name {
  font-family: var(--font-serif);
  font-size: 40rpx;
  color: #2A2846;
  letter-spacing: 1.5rpx;
  line-height: 1.35;
}

.report-meta {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6B6890;
  letter-spacing: 0.4rpx;
  margin-top: 8rpx;
}

.reload {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #E7E3F6;
  color: #372C57;
  font-family: var(--font-serif);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.reload:active {
  background: #D8D3EC;
  transform: scale(0.96);
}

.tabs {
  position: relative;
  z-index: 2;
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 14rpx;
}

.tab {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  color: #6B6890;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: all 0.25s ease;
}

.tab:active {
  transform: scale(0.97);
}

.tab.active {
  background: linear-gradient(135deg, #625A9A 0%, #52467B 100%);
  border-color: transparent;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(82, 70, 123, 0.24);
}

.loading {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #6B6890;
  text-align: center;
  letter-spacing: 0.5rpx;
  padding: 80rpx 24rpx;
}

/* ========================================
   四、区块标题（报告式：左侧竖线）
   ======================================== */

.guide-main .section-title {
  position: relative;
  margin: 44rpx 0 18rpx;
  padding-left: 22rpx;
  font-family: var(--font-serif);
  font-size: 33rpx;
  font-weight: 400;
  color: #2A2846;
  letter-spacing: 1.5rpx;
  line-height: 1.4;
}

.guide-main .section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #A198C4 0%, #52467B 100%);
}

/* ========================================
   五、基本信息页
   ======================================== */

.data-card {
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 28rpx;
  padding: 8rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
}

.data-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F0F9;
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #5F5C82;
  letter-spacing: 0.4rpx;
  flex: 0 0 auto;
  max-width: 42%;
}

.data-value {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: #2A2846;
  text-align: right;
  letter-spacing: 0.2rpx;
  line-height: 1.55;
  word-break: break-all;
}

.data-value.muted {
  color: #6F6A8A;
  font-weight: 400;
}

/* 分组小标题：把长列表切成可读的簇 */
.data-group-title {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6C6A8E;
  letter-spacing: 3rpx;
  padding: 22rpx 0 10rpx;
  border-bottom: 1rpx solid #EBE8F7;
}

.data-group-title:first-child {
  padding-top: 6rpx;
}

.sub-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #695C93;
  letter-spacing: 0.6rpx;
  padding: 20rpx 0 12rpx;
}

.divider {
  height: 1rpx;
  background: #EBE8F7;
  margin: 4rpx 0 0;
}

.no-data {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #8378AC;
  letter-spacing: 0.4rpx;
  padding: 6rpx 0 20rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-bottom: 8rpx;
}

.tag.blue {
  background: #EDF1F8;
  color: #5B6E9E;
}

/* 成交记录 */
.deal-summary {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #5F5C82;
  line-height: 1.75;
  letter-spacing: 0.4rpx;
  padding: 20rpx 0 16rpx;
  border-bottom: 1rpx solid #F2F0F9;
}

.deal-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F0F9;
}

.deal-item:last-child {
  border-bottom: none;
}

.deal-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.2rpx;
  line-height: 1.5;
}

.deal-meta {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6B6890;
  margin-top: 4rpx;
  letter-spacing: 0.3rpx;
}

/* 竞品 */
.competitor {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F0F9;
}

.competitor:last-child {
  border-bottom: none;
}

.competitor-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.2rpx;
}

.competitor-meta {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6C6A8E;
  margin-top: 4rpx;
  letter-spacing: 0.3rpx;
}

.competitor-price {
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: #52467B;
  letter-spacing: 0.5rpx;
}

/* ========================================
   六、价值分析页
   ======================================== */

.price-chart {
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 28rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
}

.price-chart-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #F2F0F9;
  margin-bottom: 8rpx;
}

.price-chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #372C57;
  letter-spacing: 0.5rpx;
}

.price-chart-unit {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6F6A8A;
  letter-spacing: 0.3rpx;
}

.price-bar-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.price-bar-label {
  flex: 0 0 150rpx;
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6B6890;
  line-height: 1.5;
  letter-spacing: 0.2rpx;
  padding-top: 2rpx;
}

.price-bar-label text {
  display: block;
}

.price-bar-body {
  flex: 1;
  min-width: 0;
}

.price-bar-value {
  font-family: var(--font-serif);
  font-size: 26rpx;
  color: #2A2846;
  letter-spacing: 0.3rpx;
  margin-bottom: 8rpx;
}

.price-bar-value.muted {
  color: #6F6A8A;
}

.price-bar-plot {
  width: 100%;
}

.price-bar-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #EDEAF7;
  overflow: hidden;
}

.price-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--bar-color, #52467B);
  transition: width 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.price-note {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6F6A8A;
  letter-spacing: 0.3rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.price-chart-axis {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6F6A8A;
  padding-top: 10rpx;
  margin-top: 6rpx;
  border-top: 1rpx dashed #EBE8F7;
}

/* 价格明细 */
.price-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 左标签 · 右数值 · 备注换行占满，指标少时也不会留白 */
.price-card {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 4rpx 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(55, 44, 87, 0.04);
}

.price-label {
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #5F5C82;
  letter-spacing: 0.4rpx;
  line-height: 1.5;
}

.price-value {
  flex: 0 1 auto;
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: #372C57;
  letter-spacing: 0.3rpx;
  text-align: right;
  line-height: 1.5;
}

.price-card .price-note {
  flex: 1 1 100%;
  margin-top: 2rpx;
}

/* ========================================
   七、购置建议页
   ======================================== */

.dimension-card {
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 30rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
}

.dimension-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F2F0F9;
  margin-bottom: 22rpx;
}

.dimension-title {
  font-family: var(--font-serif);
  font-size: 34rpx;
  color: #2A2846;
  letter-spacing: 2rpx;
}

.dimension-level {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.dimension-level.high {
  background: #EDF2EA;
  color: #4F6B4C;
}

.dimension-level.mid {
  background: #F6F0E6;
  color: #8A6A38;
}

.dimension-level.low {
  background: #F6EBEB;
  color: #9C6055;
}

.dimension-total {
  margin-left: auto;
  font-family: var(--font-serif);
  font-size: 52rpx;
  color: #372C57;
  letter-spacing: 1rpx;
  line-height: 1;
}

.dimension-total-label {
  font-family: var(--font-serif);
  font-size: 21rpx;
  color: #6F6A8A;
  align-self: flex-end;
  margin-bottom: 10rpx;
}

/* 饼图 + 图例 */
.pie-section {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-bottom: 24rpx;
}

.pie-wrap {
  flex: 0 0 auto;
}

.pie-donut {
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(55, 44, 87, 0.08);
}

.pie-hole {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-center-score {
  font-family: var(--font-serif);
  font-size: 42rpx;
  color: #372C57;
  line-height: 1;
  letter-spacing: 1rpx;
}

.pie-center-label {
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6F6A8A;
  letter-spacing: 0.5rpx;
  margin-top: 6rpx;
}

.pie-legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legend-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex: 0 0 14rpx;
  margin-top: 9rpx;
}

.legend-info {
  flex: 1;
  min-width: 0;
}

.legend-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.2rpx;
  line-height: 1.45;
}

.legend-desc {
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6F6A8A;
  line-height: 1.45;
  margin-top: 3rpx;
}

.legend-right {
  flex: 0 0 auto;
  text-align: right;
}

.legend-score {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  line-height: 1.45;
}

.legend-pct {
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6F6A8A;
  margin-top: 3rpx;
}

/* 分类折叠卡 */
.category-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-card {
  background: #FAF9FD;
  border: 1rpx solid #EBE8F7;
  border-radius: 22rpx;
  overflow: hidden;
  transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.category-card.expanded {
  background: #FFFFFF;
  border-color: #D8D3EC;
  box-shadow: 0 8rpx 26rpx rgba(55, 44, 87, 0.06);
}

.cat-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
}

.cat-indicator {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  flex: 0 0 8rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.3rpx;
  flex: 0 0 auto;
}

.cat-desc-small {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: 20rpx;
  color: #6C6A8E;
