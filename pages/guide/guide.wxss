}

/* 计算结果 */
.loan-result {
  margin-top: 20rpx;
  padding: 22rpx;
  background: #F1EFFA;
  border: 1rpx solid #E7E3F6;
  border-radius: 20rpx;
}

.loan-result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.loan-result-title {
  font-family: var(--font-serif);
  font-size: 22rpx;
