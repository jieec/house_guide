}

/* ---------- 数据完整性 ---------- */

.audit-card {
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(55, 44, 87, 0.04);
}

.audit-card.warn {
  background: #FDF8F2;
  border-color: #F0DEC9;
}

.audit-card.ok {
  background: #FAF9FD;
