page::after { content:'RISK / CHECKPOINT'; position:fixed; z-index:-1; right:12rpx; top:220rpx; color:rgba(255,173,105,.28); font-size:15rpx; letter-spacing:3rpx; transform:rotate(90deg); }
.risk-check.checked { background: linear-gradient(135deg, #8994ed, #6976d2) !important; }
.warn { background: #fff1e9 !important; color: #a65a36 !important; border-color: #f4d9c9 !important; }
.ok { background: #eef9f3 !important; color: #3c8b61 !important; border-color: #d3eedf !important; }
.risk-item { border-color: #edf0fa !important; }
.risk-check { border-color: #d5daf8 !important; color: #5866c8 !important; }


.risk-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  text-align: center;
  line-height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 26rpx;
}

.risk-check.checked {
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  border-color: transparent;
}

.risk-body {
  flex: 1;
}

.risk-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.risk-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b8fb0;
  line-height: 1.5;
}

.warn {
  margin-top: 16rpx;
  background: rgba(255, 107, 53, 0.1);
  color: #ff6b35;
  border: 1rpx solid rgba(255, 107, 53, 0.15);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.ok {
  margin-top: 16rpx;
  background: rgba(76,219,178,.10) !important;
  color: #9af0ce !important;
  border: 1rpx solid rgba(105,230,190,.24) !important;
  border-radius: 18rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

/* Deep-space glass overrides */
page { background:transparent !important; color:#f6f3ff !important; }
page .card { background:rgba(255,255,255,.065) !important; border-color:rgba(255,255,255,.14) !important; box-shadow:0 24rpx 58rpx rgba(4,2,22,.28),inset 0 1rpx 0 rgba(255,255,255,.10) !important; border-radius:26rpx !important; }
.card-title,.card-sub,.form-label,.risk-name { color:#f7f4ff !important; }
.card-sub,.risk-desc { color:#aaa4cb !important; }
.risk-item { border-color:rgba(255,255,255,.10) !important; }
.risk-check { border-color:rgba(186,162,255,.48) !important; color:#d7c8ff !important; background:rgba(255,255,255,.06) !important; }
.risk-check.checked { background:linear-gradient(112deg,#a75bff,#4b9cff) !important; color:#fff !important; border-color:transparent !important; }
.warn { background:rgba(255,130,102,.10) !important; color:#ffc28f !important; border-color:rgba(255,155,132,.26) !important; border-radius:18rpx !important; }
.ok { background:rgba(76,219,178,.10) !important; color:#9af0ce !important; border-color:rgba(105,230,190,.24) !important; border-radius:18rpx !important; }
