/* 风险页面 - 柔和紫色风格 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* 背景装饰 - 交叉线条 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: 
    linear-gradient(90deg, transparent 0%, rgba(139, 92, 246, 0.03) 50%, transparent 100%),
    linear-gradient(0deg, transparent 0%, rgba(124, 92, 252, 0.03) 50%, transparent 100%);
  background-size: 200rpx 200rpx;
  z-index: 0;
  opacity: 0.7;
}

page::after {
  content: '';
  position: fixed;
  top: 50%;
  right: -150rpx;
  margin-top: -250rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(109, 78, 237, 0.1) 0%, transparent 65%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.card, .btn-primary {
  position: relative;
  z-index: 1;
}

/* ==================== 入场动画 ==================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.risk-section {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.risk-section:nth-child(1) { animation-delay: 0.1s; }
.risk-section:nth-child(2) { animation-delay: 0.2s; }
.risk-section:nth-child(3) { animation-delay: 0.3s; }
.risk-section:nth-child(4) { animation-delay: 0.4s; }

.risk-item {
  animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

/* ==================== 点击效果 ==================== */

.risk-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.risk-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx);
  border-left: 4rpx solid #8B5CF6;
  padding-left: 28rpx;
}

.risk-check {
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.risk-item:active .risk-check {
  transform: scale(1.2) rotate(15deg);
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.3);
}

.risk-check.checked {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C5CFC 100%);
  color: #FFFFFF;
  box-shadow: 0rpx 8rpx 24rpx rgba(124, 92, 252, 0.4);
}

.warn {
  transition: all 0.3s ease;
}

.warn:active {
  transform: scale(0.98);
  background: rgba(239, 68, 68, 0.15);
}

.ok {
  transition: all 0.3s ease;
}

.ok:active {
  transform: scale(0.98);
  background: rgba(34, 197, 94, 0.15);
}

