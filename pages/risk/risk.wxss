page { background: #f5f6ff !important; color: #34406f !important; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)) !important; }
.risk-check.checked { background: linear-gradient(135deg, #8994ed, #6976d2) !important; }
.warn { background: #fff1e9 !important; color: #a65a36 !important; border-color: #f4d9c9 !important; }
.ok { background: #eef9f3 !important; color: #3c8b61 !important; border-color: #d3eedf !important; }
.risk-item { border-color: #edf0fa !important; }
.risk-check { border-color: #d5daf8 !important; color: #5866c8 !important; }


.risk-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  text-align: center;
  line-height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 26rpx;
}

.risk-check.checked {
  background: linear-gradient(135deg, #1a5cff, #00d4ff);
  border-color: transparent;
}

.risk-body {
  flex: 1;
}

.risk-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.risk-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b8fb0;
  line-height: 1.5;
}

.warn {
  margin-top: 16rpx;
  background: rgba(255, 107, 53, 0.1);
  color: #ff6b35;
  border: 1rpx solid rgba(255, 107, 53, 0.15);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.ok {
  margin-top: 16rpx;
  background: rgba(35, 195, 67, 0.1);
  color: #5ddb7a;
  border: 1rpx solid rgba(35, 195, 67, 0.15);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
}
