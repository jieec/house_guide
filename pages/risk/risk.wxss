/* 页面基础 */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.risk-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.risk-main {
  padding: 24rpx;
}

/* ==================== 动画 ==================== */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ==================== 风险清单 ==================== */

.risk-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #F1EFFA;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.risk-item:active {
  background: #E8E5F5;
  transform: translateX(4rpx);
}

.risk-check {
  width: 32rpx;
  height: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.risk-check .ic {
  width: 20rpx;
  height: 20rpx;
}

/* 融资风险提示 / 正常提示 */
.warn,
.ok {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  font-family: var(--font-serif);
  font-size: 23rpx;
  line-height: 1.7;
  letter-spacing: 0.3rpx;
}

.warn {
  background: #FDF4EC;
  border: 1rpx solid #F0DEC9;
  color: #8A5A2B;
}

.warn .ic {
  width: 24rpx;
  height: 24rpx;
  margin-top: 5rpx;
  color: #A8743F;
}

.ok {
  background: #EFECFA;
  border: 1rpx solid #E7E3F6;
  color: #4C4A6E;
}

.ok .ic {
  width: 24rpx;
  height: 24rpx;
  margin-top: 5rpx;
  color: #52467B;
}

.risk-item.checked .risk-check {
  background: #52467B;
  border-color: #C1BAD9;
  color: #FFFFFF;
}

.risk-content {
  flex: 1;
  min-width: 0;
}

.risk-title {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.risk-desc {
  color: #4C4A6E;
  font-size: 24rpx;
  line-height: 1.4;
}

.risk-type {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-top: 8rpx;
}

.risk-type.warn {
  background: #C08A55;
}

.risk-type.error {
  background: #A94D58;
}

.risk-type.info {
  background: #5A70A8;
}

.risk-type.success {
  background: #E7E3F6;
}

/* ==================== 区块 · status-card ==================== */

.status-card {
  background: #F1EFFA;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.status-card:active {
  transform: scale(0.98);
}

.status-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.status-icon.warn {
  background: rgba(255, 152, 0, 0.15);
  color: #C08A55;
}

.status-icon.error {
  background: rgba(244, 67, 54, 0.15);
  color: #A94D58;
}

.status-icon.ok {
  background: rgba(82, 70, 123, 0.15);
  color: #52467B;
}

.status-content {
  flex: 1;
}

.status-title {
  color: #2A2846;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.status-desc {
  color: #4C4A6E;
  font-size: 24rpx;
}

.status-value {
  color: #52467B;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
}

.form-row:active {
  background: #E8E5F5;
  transform: scale(0.98);
}

/* ==================== 区块 · suggestion-box ==================== */

.suggestion-box {
  background: rgba(82, 70, 123, 0.1);
  border-left: 4rpx solid #C1BAD9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
  color: #52467B;
  transition: all 0.3s ease;
}

.suggestion-box.warning {
  background: rgba(255, 152, 0, 0.1);
  border-left-color: #C08A55;
  color: #C08A55;
}

.suggestion-box.error {
  background: rgba(244, 67, 54, 0.1);
  border-left-color: #A94D58;
  color: #A94D58;
}

.suggestion-title {
  font-weight: 600;
  margin-bottom: 6rpx;
}

.suggestion-desc {
  font-size: 24rpx;
  line-height: 1.5;
}

/* ==================== 空状态 ==================== */

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2A2846;
  font-size: 32rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  color: #6B6890;
  font-size: 26rpx;
  font-family: var(--font-serif);
  line-height: 1.8;
}

/* ==================== 风险项 ==================== */

.risk-body {
  flex: 1;
  min-width: 0;
}

.risk-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.3rpx;
}
