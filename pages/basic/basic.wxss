/* Habo 绿色主题 - 基本信息页 */

.basic-layout {
  min-height: 100vh;
  background: #F6F5FC;
}

.basic-main {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 城市显示 */
.city-display {
  padding: 12rpx 16rpx;
  background: #F6F5FC;
  border: 2rpx solid #EBE8F7;
  border-radius: 20rpx;
  color: #4C4A6E;
  font-size: 30rpx;
}

/* 搜索框 */
.search-card {
  padding: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #EBE8F7;
  border-radius: 28rpx;
  background: #F6F5FC;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
  min-height: 48rpx;
}

.search-box:active {
  border-color: #C1BAD9;
  box-shadow: 0 0 0 4rpx rgba(82, 70, 123, 0.1);
}

.search-icon {
  color: #9490B2;
  font-size: 24rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  border: 0;
  background: transparent;
  color: #2A2846;
  font-size: 28rpx;
  outline: none;
  line-height: 1.5;
}

.search-input::placeholder {
  color: #9490B2;
}

.search-status {
  color: #52467B;
  font-size: 24rpx;
  font-weight: 600;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 结果列表 */
.result-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.result-item {
  padding: 12rpx;
  background: #F6F5FC;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  cursor: pointer;
}

.result-item:active {
  border-color: #C1BAD9;
  background: #F1EFFA;
}

.result-name {
  color: #2A2846;
  font-size: 30rpx;
  font-weight: 600;
}

.result-desc {
  color: #4C4A6E;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 成功提示 */
.success-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx;
  background: #E7E3F6;
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.banner-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.banner-text {
  flex: 1;
}

.banner-title {
  color: #52467B;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.banner-desc {
  color: #52467B;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
}

/* ==================== 补全 ==================== */

.city-view {
  color: #5F5C82;
  font-weight: 400;
}

.search-tip {
  font-family: var(--font-serif);
  font-size: 23rpx;
  color: #6B6890;
  padding: 12rpx 0;
  letter-spacing: 0.3rpx;
}

.result-sub {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #6B6890;
  margin-top: 4rpx;
}
