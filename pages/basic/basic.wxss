.search-box {
  display: flex;
  align-items: center;
  background: rgba(10, 25, 50, 0.6);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #5b7aa8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #e8f0fe;
  background: transparent;
}

.search-tip {
  font-size: 24rpx;
  color: #7b8fb0;
  padding: 8rpx 0;
}

.result-item {
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(0, 180, 255, 0.08);
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.result-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7b8fb0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-banner {
  margin-top: 16rpx;
  background: rgba(35, 195, 67, 0.1);
  border: 1rpx solid rgba(35, 195, 67, 0.15);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
  color: #5ddb7a;
  line-height: 1.6;
}

.auto-note {
  font-size: 22rpx;
  color: #5ddb7a;
}

.city-view {
  display: flex;
  align-items: center;
  color: #7b8fb0;
}

textarea.form-input {
  width: 100%;
  min-height: 100rpx;
  box-sizing: border-box;
}
page { background:transparent !important; color:#f6f3ff !important; }
.card-title,.card-sub,.form-label,.result-label { color:#f7f4ff !important; }
.form-input,.form-input-wrap { background:rgba(9,7,33,.34) !important; border-color:rgba(178,151,255,.24) !important; color:#f6f3ff !important; }
.result { background:rgba(76,57,164,.16) !important; border-color:rgba(255,255,255,.14) !important; }
.result-num { color:#79ddff !important; }
