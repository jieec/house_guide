/* 基础页面 - 柔和紫色风格 + 超级惊艳动效 */

page {
  background: linear-gradient(180deg, #F5F3FF 0%, #F0EAFE 50%, #E8E3FD 100%);
  color: #2D2D3A;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

/* 背景装饰 - 渐变光晕 */
page::before {
  content: '';
  position: fixed;
  top: -200rpx;
  left: 50%;
  margin-left: -400rpx;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, rgba(124, 92, 252, 0.04) 30%, transparent 60%);
  border-radius: 50%;
  z-index: 0;
}

page::after {
  content: '';
  position: fixed;
  bottom: -100rpx;
  right: -100rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(109, 78, 237, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 确保内容在装饰层之上 */
.step-card, .card, .btn-primary, .btn-ghost {
  position: relative;
  z-index: 1;
}

/* 入场动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 卡片和表单行动画 */
.card,
.form-row {
  animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.card:nth-child(1),
.form-row:nth-child(1) { animation-delay: 0.1s; }
.card:nth-child(2),
.form-row:nth-child(2) { animation-delay: 0.2s; }
.card:nth-child(3),
.form-row:nth-child(3) { animation-delay: 0.3s; }
.card:nth-child(4),
.form-row:nth-child(4) { animation-delay: 0.4s; }
.card:nth-child(5),
.form-row:nth-child(5) { animation-delay: 0.5s; }
.card:nth-child(n+6),
.form-row:nth-child(n+6) { animation-delay: 0.6s; }

/* ==================== 点击效果 ==================== */

.result-item {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.result-item:active {
  background: #F5F3FF;
  transform: translateX(8rpx) scale(0.98);
  border-left: 4rpx solid #8B5CF6;
  padding-left: 28rpx;
  box-shadow: 0rpx 8rpx 20rpx rgba(124, 92, 252, 0.15);
}

.auto-banner {
  transition: all 0.3s ease;
}

.auto-banner:active {
  transform: scale(0.98);
  background: rgba(139, 92, 246, 0.08);
}

.city-view {
  transition: all 0.3s ease;
}

.city-view:active {
  background: #F5F3FF;
  transform: scale(0.99);
}
