<view class="home-layout">
  <view class="home-main">
    <view class="page-heading">
      <view>
        <view class="eyebrow">HOME / OVERVIEW</view>
        <view class="page-title">房产价值评估</view>
        <view class="page-subtitle">用数据，做出更安心的置业决策</view>
      </view>
      <view class="heading-badge"><text class="status-dot"></text> 房产助手在线</view>
    </view>

    <view class="welcome-panel">
      <view class="welcome-copy">
        <view class="welcome-kicker">PROPERTY INSIGHT</view>
        <view class="welcome-title">看清房产价值，<text>从这里开始</text></view>
        <view class="welcome-desc">整合市场行情、房屋信息与专业分析，帮助你全面了解房产。</view>
        <view class="primary-action" bindtap="goGuide"><text>查看评估报告</text><text class="action-arrow">›</text></view>
      </view>
      <view class="welcome-visual">
        <view class="visual-orbit orbit-back"></view>
        <view class="visual-orbit orbit-front"></view>
        <view class="visual-building building-one"></view>
        <view class="visual-building building-two"></view>
        <view class="visual-building building-three"></view>
        <image class="bear-mascot" src="../../images/bear.png" mode="aspectFit"></image>
        <view class="visual-ground"></view>
        <view class="visual-label">价值分析</view>
      </view>
    </view>

    <view class="location-row">
      <view class="location-symbol">⌖</view>
      <view class="location-copy" wx:if="{{location && location.city}}" bindtap="goLocation">
        <view class="location-title">{{location.province}} {{location.city}} {{location.district}}</view>
        <view class="location-detail">{{location.estate || '未填写楼盘'}}{{location.community ? ' · ' + location.community : ''}}</view>
      </view>
      <view class="location-copy" wx:else bindtap="goLocation">
        <view class="location-title">设置当前关注区域</view>
        <view class="location-detail">选择省份、城市、楼盘与小区</view>
      </view>
      <view class="location-edit" bindtap="goLocation">修改区域 <text>›</text></view>
    </view>

    <view class="section-heading">
      <view><view class="section-title">快捷工具</view><view class="section-caption">房产评估所需工具，一站完成</view></view>
      <view class="section-count">04 <text>TOOLS</text></view>
    </view>
    <view class="tool-grid">
      <view class="tool-item" wx:for="{{quickModules}}" wx:key="key" data-key="{{item.key}}" bindtap="goModule">
        <view class="tool-topline"><view class="tool-icon tool-icon-{{index}}">{{item.icon}}</view><view class="tool-arrow">↗</view></view>
        <view class="tool-name">{{item.name}}</view>
        <view class="tool-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="summary-strip">
      <view class="summary-copy"><view class="summary-title">从基础信息到专业结论</view><view class="summary-desc">让每一项房产数据，都成为决策依据。</view></view>
      <view class="summary-mark">01 <text>/ 04</text></view>
    </view>
  </view>
</view>
