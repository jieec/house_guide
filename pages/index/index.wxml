<view class="hero">
  <image class="hero-bg" src="/images/bg-city.png" mode="aspectFill"></image>
  <view class="hero-overlay"></view>
  <view class="hero-content">
    <view class="hero-title-row">
      <view class="hero-title">一秒搞定房产价值多维度评估</view>
      <view class="hero-sub">迅速测评 · 一秒搞定 · 有的放矢 · 轻松抉择</view>
    </view>
    <view class="hero-top">
      <view class="hero-text">
        <view class="hero-slogan">用数据<br/>看见更好的家</view>
      </view>
      <view class="hero-bear-wrap">
        <image class="hero-bear" src="/images/bear.png" mode="aspectFit"></image>
        <view class="bear-speech">
          <view class="bear-hi">Hi!</view>
          <view class="bear-desc"><text>我是Alpha熊\n你的智能房产助手</text></view>
        </view>
      </view>
    </view>
    
    <view class="hero-report">
    <view class="hero-card">
      <view class="hero-card-left">
        <image class="hero-house" src="/images/house.png" mode="aspectFit"></image>
      </view>
      <view class="hero-card-right">
        <view class="hero-card-title">房产诊断报告</view>
        <view class="hero-card-sub">多维一体，综合评估</view>
        <view class="hero-tags">
          <view class="hero-tag">✓ 权威数据</view>
          <view class="hero-tag">✓ 多维分析</view>
          <view class="hero-tag">✓ 专业评估</view>
          <view class="hero-tag">✓ 决策参考</view>
        </view>
      </view>
    </view>
    
    <view class="hero-btn" bindtap="goGuide">
      <text>立即查看评估报告</text>
      <view class="hero-btn-icon">›</view>
    </view>
    </view>
  </view>
</view>

<view class="loc-card">
  <view class="loc-head">
    <view class="loc-icon-wrap">
      <view class="loc-icon">📍</view>
    </view>
    <view class="loc-body" wx:if="{{location && location.city}}" bindtap="goLocation">
      <view class="loc-value">{{location.province}} {{location.city}} {{location.district}}</view>
      <view class="loc-sub">{{location.estate || '未填写楼盘'}}{{location.community ? ' · ' + location.community : ''}}</view>
    </view>
    <view class="loc-body" wx:else bindtap="goLocation">
      <view class="loc-empty">选择 省份 / 城市 / 区 / 楼盘 / 小区</view>
    </view>
    <view class="loc-edit" bindtap="goLocation">修改 ›</view>
  </view>
</view>

<view class="section-header">
  <view class="section-title">快捷工具</view>
  <view class="section-sub">专业工具 · 助您全面了解房产</view>
</view>
<view class="quick-grid">
  <view class="quick-item" wx:for="{{quickModules}}" wx:key="key" data-key="{{item.key}}" bindtap="goModule">
    <view class="quick-icon-wrap">
      <view class="quick-icon">{{item.icon}}</view>
    </view>
    <view class="quick-name">{{item.name}}</view>
    <view class="quick-desc">{{item.desc}}</view>
  </view>
</view>

<view class="ad-banner">
  <image class="ad-bg" src="/images/bg-city.png" mode="aspectFill"></image>
  <view class="ad-overlay"></view>
  <view class="ad-content">
    <view class="ad-left">
      <view class="ad-title">数据驱动决策</view>
      <view class="ad-sub">让房产价值更清晰</view>
      <view class="ad-desc">专业 · 准确 · 全面</view>
    </view>
    <view class="ad-right">
      <view class="ad-slogan"><text>好房子\n让生活更美好</text></view>
    </view>
  </view>
</view>
