/* ==================== 首页 · 雾紫主题 ==================== */

page {
  background: #F6F5FC;
  color: #2A2846;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.home-layout {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.home-main {
  padding: 24rpx 24rpx 0;
}

.heading-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #E7E3F6;
  border-radius: 999rpx;
  font-family: var(--font-serif);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  color: #372C57;
  white-space: nowrap;
  flex: 0 0 auto;
  margin-top: 6rpx;
  margin-left: 16rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8378AC;
  animation: pulse 2.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ==================== 当前关注对象 ==================== */

.ctx-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 30rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.ctx-card.is-empty {
  background: #F4F2FC;
  border-style: dashed;
  border-color: #D8D3EC;
}

.ctx-card.is-empty .ctx-icon {
  background: #EFECFA;
}

.ctx-card.is-empty .ctx-action {
  color: #695C93;
}

.ctx-card:active {
  transform: scale(0.985);
  box-shadow: 0 12rpx 34rpx rgba(55, 44, 87, 0.09);
}

.ctx-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background: #E7E3F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
}

.ctx-icon .css-icon {
  width: 34rpx;
  height: 34rpx;
}

.ctx-body {
  flex: 1;
  min-width: 0;
}

.ctx-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ctx-desc {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #5F5C82;
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ctx-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #52467B;
  white-space: nowrap;
  flex: 0 0 auto;
}

.ctx-arrow {
  width: 20rpx;
  height: 20rpx;
  flex: 0 0 20rpx;
  opacity: 0.75;
}

/* ==================== 主视觉 ==================== */

.hero-card {
  position: relative;
  border-radius: 40rpx;
  padding: 40rpx 36rpx 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #E7E3F6 0%, #EDEAF9 55%, #F5F4FC 100%);
  border: 1rpx solid #D8D3EC;
  box-shadow: 0 14rpx 40rpx rgba(55, 44, 87, 0.07);
}

.hero-ill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.18;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(231, 227, 246, 0.88) 0%, rgba(246, 245, 252, 0.35) 100%);
}

.hero-body {
  position: relative;
  z-index: 1;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: 2rpx;
  color: #2A2846;
}

.hero-title text {
  display: block;
  color: #52467B;
}

.hero-desc text {
  display: block;
}

.hero-desc {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: #4A4769;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  margin: 18rpx 0 30rpx;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 36rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #625A9A 0%, #52467B 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 30rpx rgba(82, 70, 123, 0.26);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.hero-cta:active {
  transform: scale(0.97);
  box-shadow: 0 16rpx 36rpx rgba(82, 70, 123, 0.32);
}

.cta-arrow {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
  opacity: 0.85;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(82, 70, 123, 0.13);
  font-family: var(--font-serif);
  font-size: 24rpx;
  color: #574F79;
  letter-spacing: 0.5rpx;
}

.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #C1BAD9;
}

/* ==================== 区块标题 ==================== */

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin: 52rpx 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #372C57;
  letter-spacing: 0.5rpx;
  margin-bottom: 6rpx;
}

.section-caption {
  font-family: var(--font-serif);
  font-size: 27rpx;
  color: #5F5C82;
  letter-spacing: 0.5rpx;
  line-height: 1.7;
}

.section-count {
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: #52467B;
  line-height: 1;
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.section-count text {
  font-family: var(--font-sans);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #9490B2;
  margin-left: 8rpx;
}

/* ==================== 工具网格 ==================== */

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.tool-item {
  background: #FFFFFF;
  border: 1rpx solid #EBE8F7;
  border-radius: 30rpx;
  padding: 26rpx;
  box-shadow: 0 6rpx 28rpx rgba(55, 44, 87, 0.05);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.tool-item:active {
  transform: scale(0.97);
  box-shadow: 0 12rpx 34rpx rgba(55, 44, 87, 0.09);
}

.tool-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.tool-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
}

.tool-icon .css-icon {
  width: 30rpx;
  height: 30rpx;
}

.tool-index {
  font-family: var(--font-serif);
  font-size: 26rpx;
  color: #6B6890;
  letter-spacing: 1rpx;
  line-height: 1;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2846;
  letter-spacing: 0.4rpx;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #5F5C82;
  line-height: 1.6;
  letter-spacing: 0.3rpx;
}

/* ==================== 收尾 ==================== */

.summary-strip {
  position: relative;
  margin-top: 32rpx;
  border-radius: 36rpx;
  padding: 32rpx 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #E7E3F6 0%, #F6F5FC 100%);
  border: 1rpx solid #D8D3EC;
}

.summary-ill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.14;
}

.summary-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.summary-title {
  font-family: var(--font-serif);
  font-size: 31rpx;
  color: #2A2846;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.summary-desc {
  font-family: var(--font-serif);
  font-size: 25rpx;
  color: #4A4769;
  margin-top: 8rpx;
  letter-spacing: 0.3rpx;
}

.summary-mark {
  position: relative;
  z-index: 1;
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: #52467B;
  text-align: right;
  line-height: 1.3;
  flex: 0 0 auto;
  margin-left: 24rpx;
}

.summary-mark text {
  display: block;
  font-family: var(--font-sans);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #9490B2;
  margin-top: 4rpx;
}
