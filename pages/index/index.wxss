.hero {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  color: #ffffff;
  overflow: hidden;
  min-height: 680rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(5, 15, 35, 0.5) 0%, rgba(8, 20, 45, 0.7) 50%, rgba(10, 22, 40, 0.95) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-text {
  flex: 1;
}

.hero-slogan {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #ffffff;
  text-shadow: 0 0 30rpx rgba(0, 200, 255, 0.8), 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

.hero-bear-wrap {
  position: absolute;
  right: -20rpx;
  top: 20rpx;
  width: 320rpx;
  height: 300rpx;
  z-index: 10;
}

.hero-bear {
  width: 100%;
  height: 100%;
}

.bear-speech {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  background: rgba(0, 200, 255, 0.25);
  border: 1rpx solid rgba(0, 220, 255, 0.5);
  border-radius: 20rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0 0 20rpx rgba(0, 180, 255, 0.3);
}

.bear-hi {
  font-size: 30rpx;
  font-weight: 700;
  color: #00e5ff;
  text-shadow: 0 0 10rpx rgba(0, 229, 255, 0.6);
}

.bear-desc {
  font-size: 18rpx;
  color: #b0d4e8;
  margin-top: 4rpx;
  line-height: 1.4;
}

.hero-title-row {
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  max-width: 60%;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.hero-sub {
  font-size: 24rpx;
  color: #a0c4e0;
  margin-top: 10rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.hero-card {
  display: flex;
  background: rgba(0, 80, 180, 0.25);
  border: 1rpx solid rgba(0, 180, 255, 0.35);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 0 40rpx rgba(0, 120, 255, 0.25), inset 0 0 20rpx rgba(0, 150, 255, 0.1);
}

.hero-card-left {
  width: 180rpx;
  height: 180rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.hero-house {
  width: 100%;
  height: 100%;
}

.hero-card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-card-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 15rpx rgba(0, 212, 255, 0.6);
}

.hero-card-sub {
  font-size: 26rpx;
  color: #8aa4cc;
  margin-top: 8rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-tag {
  font-size: 20rpx;
  color: #b0c4de;
  background: rgba(0, 180, 255, 0.1);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.hero-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #1a6bff 0%, #00c8ff 50%, #00e5ff 100%);
  border-radius: 48rpx;
  padding: 26rpx 32rpx;
  box-shadow: 0 0 30rpx rgba(0, 180, 255, 0.5), 0 8rpx 24rpx rgba(0, 120, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.hero-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  100% { left: 200%; }
}

.hero-btn text {
  font-size: 30rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.hero-btn-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  position: relative;
  z-index: 1;
}

.loc-card {
  background: rgba(12, 28, 56, 0.75);
  border: 1rpx solid rgba(0, 180, 255, 0.2);
  margin: -20rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 0 30rpx rgba(0, 100, 255, 0.2), 0 8rpx 32rpx rgba(0, 50, 120, 0.3);
  position: relative;
  z-index: 2;
}

.loc-head {
  display: flex;
  align-items: center;
}

.loc-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, rgba(0, 180, 255, 0.2), rgba(0, 212, 255, 0.1));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 0 15rpx rgba(0, 180, 255, 0.2);
}

.loc-icon {
  font-size: 36rpx;
}

.loc-body {
  flex: 1;
}

.loc-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.loc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b8fb0;
}

.loc-empty {
  font-size: 28rpx;
  color: #5b7aa8;
}

.loc-edit {
  font-size: 26rpx;
  color: #00d4ff;
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 8rpx;
}

.section-header .section-title {
  padding: 0;
  display: flex;
  align-items: center;
}

.section-header .section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #00d4ff, #1a5cff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #5b7aa8;
}

.quick-grid {
  display: flex;
  padding: 16rpx 12rpx;
  flex-wrap: wrap;
}

.quick-item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}

.quick-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 50, 120, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.quick-icon {
  font-size: 48rpx;
}

.quick-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.quick-desc {
  font-size: 20rpx;
  color: #5b7aa8;
  margin-top: 4rpx;
}

.ad-banner {
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  height: 160rpx;
}

.ad-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.ad-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(8, 20, 45, 0.9) 0%, rgba(8, 20, 45, 0.6) 100%);
}

.ad-content {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100%;
  padding: 24rpx 32rpx;
}

.ad-left {
  flex: 1;
}

.ad-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.ad-sub {
  font-size: 26rpx;
  color: #00d4ff;
  margin-top: 8rpx;
}

.ad-desc {
  font-size: 22rpx;
  color: #7b8fb0;
  margin-top: 8rpx;
}

.ad-right {
  margin-left: 20rpx;
}

.ad-slogan {
  font-size: 28rpx;
  color: #ffffff;
  text-align: center;
  line-height: 1.4;
  font-weight: 600;
  text-shadow: 0 0 10rpx rgba(0, 212, 255, 0.5);
}
