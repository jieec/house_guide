page { background:#171033; color:#f4f1ff; padding-bottom:calc(148rpx + env(safe-area-inset-bottom)); }
.home-layout { min-height:100vh; background:transparent; }.home-main { min-width:0; padding:42rpx 28rpx 190rpx; box-sizing:border-box; }.page-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; margin-bottom:38rpx; }.eyebrow,.welcome-kicker { color:#9d8be1; font-size:18rpx; font-weight:700; letter-spacing:3rpx; }.page-title { margin-top:10rpx; color:#fff; font-size:42rpx; font-weight:700; }.page-subtitle { margin-top:12rpx; color:#aaa8c7; font-size:23rpx; }.heading-badge { flex-shrink:0; padding:14rpx 20rpx; border:1rpx solid rgba(255,255,255,.16); border-radius:30rpx; color:#b8b2d6; font-size:20rpx; background:rgba(255,255,255,.08); backdrop-filter:blur(18rpx); }.status-dot { display:inline-block; width:12rpx; height:12rpx; margin-right:8rpx; border-radius:50%; background:#62e0b3; box-shadow:0 0 12rpx #62e0b3; }
.welcome-panel { position:relative; display:flex; min-height:350rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.22); border-radius:30rpx; background:linear-gradient(118deg,rgba(94,57,177,.68),rgba(37,95,178,.56)); box-shadow:0 20rpx 46rpx rgba(0,0,0,.25),inset 0 1rpx 0 rgba(255,255,255,.22),inset 0 -18rpx 30rpx rgba(20,12,72,.12); backdrop-filter:blur(16rpx); }
.welcome-panel::after { content:''; position:absolute; z-index:1; inset:0; background:linear-gradient(110deg,rgba(255,255,255,.10),transparent 42%,rgba(4,8,38,.16) 100%),linear-gradient(180deg,rgba(255,255,255,.12),transparent 35%,rgba(10,7,46,.18)); border:1rpx solid rgba(255,255,255,.08); border-radius:inherit; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.20),inset 0 -12rpx 24rpx rgba(10,8,42,.10); backdrop-filter:blur(8rpx); pointer-events:none; }
.welcome-city-art { position:absolute; z-index:0; right:-80rpx; bottom:-24rpx; width:680rpx; height:330rpx; opacity:.42; mix-blend-mode:normal; filter:saturate(.96) contrast(1.10) brightness(1); }.welcome-glow { position:absolute; z-index:0; border-radius:50%; filter:blur(3rpx); pointer-events:none; }.glow-purple { top:-150rpx; left:170rpx; width:360rpx; height:360rpx; background:rgba(185,95,255,.26); }.glow-cyan { right:-80rpx; bottom:-110rpx; width:330rpx; height:260rpx; background:rgba(48,222,246,.2); }.welcome-grid-lines { position:absolute; z-index:1; right:-30rpx; bottom:0; width:440rpx; height:210rpx; opacity:.2; background:linear-gradient(90deg,transparent 49%,rgba(158,224,255,.55) 50%,transparent 51%),linear-gradient(0deg,transparent 49%,rgba(158,224,255,.5) 50%,transparent 51%); background-size:52rpx 52rpx; transform:perspective(180rpx) rotateX(58deg); transform-origin:bottom; pointer-events:none; }.welcome-copy { position:relative; z-index:2; width:62%; padding:42rpx 0 38rpx 42rpx; box-sizing:border-box; }.welcome-title { margin-top:22rpx; color:#fff; font-size:38rpx; font-weight:700; line-height:1.45; }.welcome-title text { color:#7ee5ff; }.welcome-desc { max-width:390rpx; margin-top:14rpx; color:#d1d1ea; font-size:22rpx; line-height:1.65; }.primary-action { width:238rpx; height:70rpx; margin-top:28rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:18rpx; color:#fff; background:linear-gradient(110deg,#a452ff,#478fff); box-shadow:0 12rpx 24rpx rgba(34,31,111,.3); font-size:23rpx; font-weight:600; }.action-arrow { margin-left:22rpx; font-size:34rpx; }.welcome-visual { position:absolute; right:0; bottom:0; width:44%; height:100%; overflow:hidden; }.bear-mascot { position:absolute; z-index:4; right:22rpx; bottom:26rpx; width:190rpx; height:220rpx; object-fit:contain; filter:drop-shadow(0 14rpx 18rpx rgba(18,11,68,.34)); }.visual-orbit { position:absolute; border:2rpx solid rgba(150,225,255,.4); border-radius:50%; transform:rotate(-20deg); }.orbit-back { right:-65rpx; top:42rpx; width:350rpx; height:220rpx; }.orbit-front { right:-22rpx; top:90rpx; width:288rpx; height:178rpx; border-color:rgba(199,142,255,.5); }.visual-building { position:absolute; bottom:44rpx; border-radius:8rpx 8rpx 0 0; background:linear-gradient(180deg,rgba(255,255,255,.82),rgba(118,185,232,.42)); box-shadow:inset 8rpx 0 rgba(255,255,255,.2); }.building-one { right:168rpx; width:74rpx; height:150rpx; }.building-two { right:90rpx; width:100rpx; height:208rpx; }.building-three { right:12rpx; width:82rpx; height:126rpx; }.visual-building::after { content:''; position:absolute; top:22rpx; left:18rpx; width:12rpx; height:12rpx; border-radius:2rpx; background:#a6d9ee; box-shadow:24rpx 0 #a6d9ee,0 28rpx #a6d9ee,24rpx 28rpx #a6d9ee,0 56rpx #a6d9ee,24rpx 56rpx #a6d9ee; }.visual-ground { position:absolute; right:-30rpx; bottom:0; width:440rpx; height:48rpx; border-radius:50% 50% 0 0; background:rgba(34,216,225,.24); }.visual-label { position:absolute; right:36rpx; top:30rpx; color:rgba(205,232,255,.76); font-size:18rpx; letter-spacing:2rpx; }.visual-chip { position:absolute; z-index:6; padding:10rpx 14rpx; border:1rpx solid rgba(255,255,255,.2); border-radius:999rpx; color:#d8eaff; background:rgba(20,24,90,.42); box-shadow:0 8rpx 20rpx rgba(5,6,48,.2); backdrop-filter:blur(12rpx); font-size:16rpx; white-space:nowrap; }.chip-live { top:106rpx; left:12rpx; }.chip-live text { display:inline-block; width:9rpx; height:9rpx; margin-right:7rpx; border-radius:50%; background:#65e5b4; box-shadow:0 0 12rpx #65e5b4; }.chip-score { right:18rpx; top:42rpx; color:#bfc3e7; }.chip-score text { margin-left:5rpx; color:#7ee5ff; font-weight:700; }.visual-spark { position:absolute; z-index:5; width:8rpx; height:8rpx; border-radius:50%; background:#8cecff; box-shadow:0 0 16rpx 4rpx rgba(91,226,255,.75); }.spark-one { right:210rpx; top:62rpx; }.spark-two { right:44rpx; top:246rpx; width:6rpx; height:6rpx; background:#d9a4ff; box-shadow:0 0 15rpx 3rpx rgba(211,136,255,.75); }
.location-row { display:flex; align-items:center; min-height:98rpx; margin-top:26rpx; padding:0 26rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.14); border-radius:22rpx; background:rgba(255,255,255,.08); backdrop-filter:blur(20rpx); }.location-symbol { width:54rpx; height:54rpx; margin-right:18rpx; display:flex; align-items:center; justify-content:center; border-radius:17rpx; color:#8ddfff; font-size:34rpx; background:rgba(82,119,255,.25); }.location-copy { flex:1; min-width:0; }.location-title { overflow:hidden; color:#fff; font-size:25rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.location-detail { margin-top:6rpx; overflow:hidden; color:#aaa8c7; font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }.location-edit { flex-shrink:0; margin-left:12rpx; color:#bba5ff; font-size:21rpx; }.location-edit text { margin-left:8rpx; font-size:30rpx; }
.section-heading { display:flex; align-items:flex-end; justify-content:space-between; margin:42rpx 0 20rpx; }.section-title { color:#fff; font-size:30rpx; font-weight:700; }.section-caption { margin-top:8rpx; color:#aaa8c7; font-size:20rpx; }.section-count { color:#7ee5ff; font-size:28rpx; font-weight:700; }.section-count text { margin-left:8rpx; color:#8885ad; font-size:16rpx; }.tool-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }.tool-item { position:relative; overflow:hidden; min-height:180rpx; padding:24rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.15); border-radius:24rpx; background:rgba(255,255,255,.08); box-shadow:0 16rpx 32rpx rgba(0,0,0,.18); backdrop-filter:blur(18rpx); }.tool-item::before { content:'0' counter(tool-card); position:absolute; right:20rpx; bottom:12rpx; color:rgba(181,155,255,.18); font-size:44rpx; font-weight:700; line-height:1; }.tool-grid { counter-reset:tool-card; }.tool-item { counter-increment:tool-card; }.tool-item::after { content:''; position:absolute; top:0; left:24rpx; width:48rpx; height:2rpx; background:linear-gradient(90deg,#b66cff,transparent); opacity:.8; }.tool-icon { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; color:#fff; font-size:30rpx; background:linear-gradient(135deg,rgba(169,87,255,.7),rgba(61,155,255,.58)); }.tool-icon-1 { background:linear-gradient(135deg,rgba(57,210,214,.55),rgba(66,104,255,.65)); }.tool-icon-2 { background:linear-gradient(135deg,rgba(205,100,255,.62),rgba(95,96,255,.65)); }.tool-icon-3 { background:linear-gradient(135deg,rgba(255,153,89,.65),rgba(158,83,255,.65)); }.tool-arrow { color:#aaa8c7; font-size:28rpx; }.tool-name { margin-top:18rpx; color:#fff; font-size:26rpx; font-weight:600; }.tool-desc { margin-top:6rpx; color:#aaa8c7; font-size:20rpx; }.summary-strip { display:flex; align-items:center; justify-content:space-between; min-height:100rpx; margin-top:22rpx; padding:0 28rpx; border:1rpx solid rgba(255,255,255,.12); border-radius:22rpx; background:rgba(104,77,210,.18); }.summary-title { color:#e8ddff; font-size:23rpx; font-weight:600; }.summary-desc { margin-top:7rpx; color:#aaa8c7; font-size:19rpx; }.summary-mark { color:#7ee5ff; font-size:25rpx; font-weight:700; }.summary-mark text { color:#aaa8c7; font-size:18rpx; font-weight:400; }
@media (max-width:650px) { .home-main { padding-right:24rpx; padding-left:24rpx; }.page-heading { display:block; }.heading-badge { display:inline-block; margin-top:18rpx; }.welcome-copy { width:68%; padding-left:28rpx; }.welcome-title { font-size:32rpx; }.welcome-desc { font-size:20rpx; }.welcome-visual { width:46%; opacity:.82; }.welcome-city-art { right:-150rpx; width:610rpx; opacity:.15; }.welcome-grid-lines { right:-90rpx; opacity:.13; }.visual-chip { transform:scale(.9); transform-origin:right top; }.chip-live { left:-6rpx; transform-origin:left top; }.chip-score { top:42rpx; }.location-row { padding:0 18rpx; }.location-edit { font-size:19rpx; }.tool-item { padding:20rpx; } }
