.valuation-panel { background: #fff; border: 1rpx solid #d8d3ec; border-radius: 28rpx; padding: 30rpx; margin: 24rpx 0; color: #2a2846; font-size: 27rpx; line-height: 1.65; }
.valuation-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; justify-content: space-between; font-size: 32rpx; font-weight: 600; }
.valuation-status { font-size: 23rpx; color: #695c93; }
.valuation-demo { background: #f7edda; color: #755127; padding: 14rpx 18rpx; border-radius: 12rpx; font-size: 23rpx; margin-bottom: 24rpx; }
.valuation-primary { padding: 26rpx 0; }
.valuation-label { color: #6c6a8e; font-size: 23rpx; margin-top: 12rpx; }
.valuation-number { color: #372c57; font-size: 64rpx; line-height: 1.3; font-weight: 600; margin: 6rpx 0; }
.valuation-secondary { font-size: 34rpx; color: #52467b; }
.valuation-total { margin-top: 14rpx; font-size: 25rpx; }.valuation-total-number { font-size: 38rpx; color: #372c57; margin: 0 8rpx; }
.valuation-prices { display: flex; flex-wrap: wrap; gap: 30rpx; padding: 16rpx 0; border-top: 1rpx solid #efecfa; }
.valuation-copy { color: #5f5c82; font-size: 25rpx; white-space: pre-wrap; overflow-wrap: break-word; margin: 10rpx 0; }
.valuation-subheading { margin: 26rpx 0 12rpx; font-weight: 600; font-size: 28rpx; }
.valuation-review { color: #8a5a2b; font-size: 25rpx; margin: 14rpx 0; }
.valuation-evidence { padding: 16rpx 0; border-bottom: 1rpx solid #efecfa; font-size: 25rpx; }
.valuation-meta { color: #9490b2; font-size: 21rpx; word-break: break-all; margin-top: 18rpx; }
.valuation-state { padding: 16rpx 0; color: #6c6a8e; }.valuation-error { color: #925747; }
.valuation-retry { background: #efecfa; color: #52467b; margin-top: 20rpx; font-size: 26rpx; border-radius: 14rpx; }
