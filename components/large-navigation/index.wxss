:host { display: block; }
.nav-spacer { visibility: hidden; }
.nav-spacer > view:first-child { display: block; }
.nav-spacer .nav-title { display: none; }
.nav-shell { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: rgba(246,245,252),.96); border-bottom: 1rpx solid #ebe8f7; box-shadow: 0 5rpx 16rpx rgba(105,92,147),.08); }
.nav-title { position: absolute; right: 0; bottom: 7px; left: 0; box-sizing: border-box; width: 100%; height: 32px; padding: 0 18px; color: #52467b; font-size: 17px; font-weight: 600; line-height: 32px; text-align: center; white-space: normal; word-break: break-all; }
